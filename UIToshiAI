-- toshi.cc MENU UI LIBRARY
-- Edit this file on GitHub to change the theme and shared menu controls.
-- Feature logic, gameplay state, and callbacks remain in the executor file.

local Theme = {
    -- Keep the charcoal look, but separate surfaces and borders clearly.
    frame = Color3.fromRGB(17, 18, 20),
    bg = Color3.fromRGB(22, 23, 26),
    panel = Color3.fromRGB(29, 30, 34),
    surface = Color3.fromRGB(42, 44, 49),
    hover = Color3.fromRGB(58, 60, 67),
    line = Color3.fromRGB(72, 75, 83),
    line2 = Color3.fromRGB(105, 109, 120),
    muted = Color3.fromRGB(173, 179, 190),
    text = Color3.fromRGB(226, 229, 235),
    white = Color3.fromRGB(250, 251, 255),
    accent = Color3.fromRGB(215, 219, 228),
    signal = Color3.fromRGB(250, 251, 255),
    radius = 3,
    windowRadius = 5,
}

local function createWidgets(ctx)
    assert(type(ctx) == "table", "createWidgets expects a context table")
    local UI = ctx.UI or Theme
    local hud = assert(ctx.hud, "missing hud context")
    local esp = assert(ctx.esp, "missing esp context")
    local UIS = assert(ctx.UIS, "missing UserInputService context")
    local TweenService = assert(ctx.TweenService, "missing TweenService context")
    local connect = assert(ctx.connect, "missing connect helper")
    local speedFont = ctx.speedFont or Enum.Font.GothamBold
    local state = {activeSlider = nil}

local function corner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or UI.radius)
    c.Parent = object
    return c
end

local function stroke(object, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    -- Border mode: a real border, not an outline around the text.
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Color = color or UI.line
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = object
    return s
end

local function label(parent, text, pos, size, fontSize, color, bold)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position = pos
    l.Size = size
    l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    -- Respect the size assigned to each control. A hard 13 px minimum clipped
    -- compact labels and made fixed-height rows crowd adjacent controls.
    l.TextSize = math.max(fontSize or 12, 10)
    l.TextColor3 = color or UI.text
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Text = text
    l.Parent = parent
    return l
end

-- A gradient that fades the ends of a hairline.
local function fadeEnds(object, rotation)
    local g = Instance.new("UIGradient")
    g.Rotation = rotation
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.18, 0),
        NumberSequenceKeypoint.new(0.82, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    g.Parent = object
    return g
end


local function button(parent, text, pos, size, opts)
    opts = opts or {}

    local b = Instance.new("TextButton")
    b.Position = pos
    b.Size = size
    b.BackgroundColor3 = opts.background or UI.surface
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = opts.text or UI.text
    b.Font = opts.font or Enum.Font.GothamMedium
    b.TextSize = math.max(opts.textSize or 12, 11)
    -- Keep captions on one line and off the frame edge.
    b.TextWrapped = false
    b.TextTruncate = Enum.TextTruncate.AtEnd
    b.TextXAlignment = Enum.TextXAlignment.Center
    b.TextYAlignment = Enum.TextYAlignment.Center
    b.ClipsDescendants = true
    b.AutoButtonColor = false
    b.Parent = parent

    corner(b, opts.radius or UI.radius)
    stroke(b, UI.line2, 1, 0.4)

    b:SetAttribute("BaseColor", b.BackgroundColor3)

    b.MouseEnter:Connect(function()
        if b.Parent and not b:GetAttribute("Locked") then
            TweenService:Create(
                b, TweenInfo.new(esp.performance.tweenTime(0.1)), {BackgroundColor3 = UI.hover}
            ):Play()
        end
    end)

    b.MouseLeave:Connect(function()
        if b.Parent then
            local base = b:GetAttribute("BaseColor")
            if typeof(base) == "Color3" then
                TweenService:Create(
                    b, TweenInfo.new(esp.performance.tweenTime(0.1)), {BackgroundColor3 = base}
                ):Play()
            end
        end
    end)

    -- A short flash while the button is held down.
    b.MouseButton1Down:Connect(function()
        if b.Parent and not b:GetAttribute("Locked") then
            b.BackgroundColor3 = UI.line2
        end
    end)

    b.MouseButton1Up:Connect(function()
        if b.Parent and not b:GetAttribute("Locked") then
            b.BackgroundColor3 = UI.hover
        end
    end)

    return b
end

-- Checkbox rows redraw their box; plain buttons (touch controls) invert.
local function setButtonState(b, active)
    if not b or not b.Parent then return end

    local box = b:FindFirstChild("Check")

    if box then
        local fill = box:FindFirstChild("Fill")
        local caption = b:FindFirstChild("Caption")
        local outline = box:FindFirstChildOfClass("UIStroke")

        b:SetAttribute("On", active)

        if fill then
            TweenService:Create(
                fill, TweenInfo.new(esp.performance.tweenTime(0.12)),
                {BackgroundTransparency = active and 0 or 1}
            ):Play()
        end

        if outline then
            TweenService:Create(
                outline, TweenInfo.new(esp.performance.tweenTime(0.12)),
                {Color = active and UI.white or UI.line2}
            ):Play()
        end

        if caption then
            caption.TextColor3 = active and UI.white or UI.text
        end

        return
    end

    local color = active and UI.white or UI.surface
    b:SetAttribute("BaseColor", color)
    b:SetAttribute("Locked", active)
    b.BackgroundColor3 = color
    b.TextColor3 = active and UI.bg or UI.text
end

-- Layout order inside a list parent (column or group).
local orderOf = setmetatable({}, {__mode = "k"})

local function nextOrder(parent)
    local n = (orderOf[parent] or 0) + 1
    orderOf[parent] = n
    return n
end

-- Scrolling pages are locked while a slider is being dragged (touch).
local scrollPages = {}

local function lockScroll(locked)
    for _, page in ipairs(scrollPages) do
        page.ScrollingEnabled = not locked
    end
end

-- Pages are laid out in two columns. A new group goes into whichever column
-- is shorter so far; notes and buttons that follow stay in the same column.
hud.cols = setmetatable({}, {__mode = "k"})   -- page -> {left, right, last}
hud.weight = setmetatable({}, {__mode = "k"}) -- column -> rough height
hud.colOf = setmetatable({}, {__mode = "k"})  -- group -> column

function hud.columnFor(parent, forGroup)
    local set = hud.cols[parent]
    if not set then return parent end

    if forGroup then
        local lighter = (hud.weight[set.left] or 0) <= (hud.weight[set.right] or 0)
            and set.left or set.right
        set.last = lighter
        return lighter
    end

    return set.last or set.left
end

-- A framed block. Its title sits on the top border and cuts it. Rows are
-- added to the returned frame.
local function group(parent, titleText)
    local column = hud.columnFor(parent, true)

    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(1, 0, 0, 0)
    wrap.AutomaticSize = Enum.AutomaticSize.Y
    wrap.BackgroundTransparency = 1
    wrap.BorderSizePixel = 0
    wrap.LayoutOrder = nextOrder(column)
    wrap.Parent = column

    local g = Instance.new("Frame")
    g.Position = UDim2.fromOffset(0, 8)
    g.Size = UDim2.new(1, 0, 0, 0)
    g.AutomaticSize = Enum.AutomaticSize.Y
    g.BackgroundColor3 = UI.panel
    g.BorderSizePixel = 0
    g.Parent = wrap
    corner(g, 2)
    stroke(g, UI.line, 1, 0)

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 13)
    pad.PaddingBottom = UDim.new(0, 8)
    pad.PaddingLeft = UDim.new(0, 8)
    pad.PaddingRight = UDim.new(0, 8)
    pad.Parent = g

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 3)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = g

    if titleText then
        local t = label(
            wrap, titleText,
            UDim2.fromOffset(9, 0), UDim2.fromOffset(0, 16),
            12, UI.white, true
        )
        t.AutomaticSize = Enum.AutomaticSize.X
        t.BackgroundColor3 = UI.bg
        t.BackgroundTransparency = 0
        t.BorderSizePixel = 0
        t.ZIndex = 2

        local tp = Instance.new("UIPadding")
        tp.PaddingLeft = UDim.new(0, 4)
        tp.PaddingRight = UDim.new(0, 4)
        tp.Parent = t
    end

    hud.colOf[g] = column
    hud.weight[column] = (hud.weight[column] or 0) + 30

    return g
end

local ROW = UIS.TouchEnabled and 32 or 26

local function newRow(parent, height, asButton)
    local order = nextOrder(parent)
    local row

    if asButton then
        row = Instance.new("TextButton")
        row.Text = ""
        row.AutoButtonColor = false
    else
        row = Instance.new("Frame")
    end

    row.Size = UDim2.new(1, 0, 0, height)
    row.BackgroundColor3 = UI.white
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.LayoutOrder = order
    row.Parent = parent

    local column = hud.colOf[parent]

    if column then
        hud.weight[column] = (hud.weight[column] or 0) + height + 3
    end

    -- Clickable rows lighten very slightly under the pointer.
    if asButton then
        corner(row, 2)

        row.MouseEnter:Connect(function()
            if row.Parent then
                TweenService:Create(
                    row, TweenInfo.new(esp.performance.tweenTime(0.08)), {BackgroundTransparency = 0.95}
                ):Play()

                local caption = row:FindFirstChild("Caption")
                if caption and not row:GetAttribute("On") then
                    caption.TextColor3 = UI.white
                end
            end
        end)

        row.MouseLeave:Connect(function()
            if row.Parent then
                TweenService:Create(
                    row, TweenInfo.new(esp.performance.tweenTime(0.12)), {BackgroundTransparency = 1}
                ):Play()

                local caption = row:FindFirstChild("Caption")
                if caption and not row:GetAttribute("On") then
                    caption.TextColor3 = UI.text
                end
            end
        end)
    end

    return row
end

-- A checkbox row: a small square, the name, and an optional key tag on the
-- right. The description (if any) is a tooltip. Returns the row and its tag.
local function toggleRow(parent, name, description, withKey)
    local row = newRow(parent, ROW, true)

    local box = Instance.new("Frame")
    box.Name = "Check"
    box.AnchorPoint = Vector2.new(0, 0.5)
    box.Position = UDim2.new(0, 4, 0.5, 0)
    box.Size = UDim2.fromOffset(14, 14)
    box.BackgroundColor3 = UI.surface
    box.BorderSizePixel = 0
    box.Parent = row
    corner(box, 2)
    stroke(box, UI.line2, 1, 0)

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.AnchorPoint = Vector2.new(0.5, 0.5)
    fill.Position = UDim2.fromScale(0.5, 0.5)
    fill.Size = UDim2.fromOffset(8, 8)
    fill.BackgroundColor3 = UI.white
    fill.BackgroundTransparency = 1
    fill.BorderSizePixel = 0
    fill.Parent = box
    corner(fill, 1)

    local caption = label(
        row, name,
        UDim2.fromOffset(26, 0), UDim2.new(1, withKey and -110 or -30, 1, 0),
        12, UI.text, false
    )
    caption.Name = "Caption"
    caption.Font = Enum.Font.GothamMedium
    caption.TextTruncate = Enum.TextTruncate.AtEnd

    local chip

    if withKey then
        chip = Instance.new("TextLabel")
        chip.AnchorPoint = Vector2.new(1, 0.5)
        chip.Position = UDim2.new(1, -4, 0.5, 0)
        chip.Size = UDim2.fromOffset(0, 18)
        chip.AutomaticSize = Enum.AutomaticSize.X
        chip.BackgroundColor3 = UI.bg
        chip.BorderSizePixel = 0
        chip.Font = Enum.Font.GothamBold
        chip.TextSize = 10
        chip.TextColor3 = UI.muted
        chip.Text = ""
        chip.Parent = row
        corner(chip, 2)
        stroke(chip, UI.line, 1, 0)

        local chipPadding = Instance.new("UIPadding")
        chipPadding.PaddingLeft = UDim.new(0, 6)
        chipPadding.PaddingRight = UDim.new(0, 6)
        chipPadding.Parent = chip

        local chipMin = Instance.new("UISizeConstraint")
        chipMin.MinSize = Vector2.new(24, 18)
        chipMin.Parent = chip
    end

    hud.attachTip(row, description)

    return row, chip
end

-- A name on the left and a key button on the right.
local function bindRow(parent, name)
    local row = newRow(parent, ROW + 2, false)

    label(
        row, name,
        UDim2.fromOffset(26, 0), UDim2.new(0.5, 0, 1, 0),
        11, UI.text, false
    ).Font = Enum.Font.GothamMedium

    local b = button(
        row, "",
        UDim2.new(1, -4, 0.5, 0),
        UDim2.fromOffset(104, 18),
        {textSize = 10, background = UI.surface}
    )
    b.AnchorPoint = Vector2.new(1, 0.5)

    return b
end

-- A read-only line: name on the left, live value on the right.
local function statusRow(parent, name)
    local row = newRow(parent, 18, false)

    label(
        row, name,
        UDim2.fromOffset(26, 0), UDim2.new(0.3, 0, 1, 0),
        10, UI.muted, false
    )

    local value = label(
        row, "",
        UDim2.new(0.3, 0, 0, 0), UDim2.new(0.7, -4, 1, 0),
        10, UI.white, false
    )
    value.TextXAlignment = Enum.TextXAlignment.Right
    value.Font = Enum.Font.Code
    value.TextTruncate = Enum.TextTruncate.AtEnd

    return value
end

-- Plain explanatory text under a block.
local function noteRow(parent, text, height)
    local target = hud.cols[parent] and hud.columnFor(parent, false) or parent

    local l = label(
        target, text,
        UDim2.new(), UDim2.new(1, 0, 0, height or 28),
        11, UI.muted, false
    )
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.TextWrapped = true
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.LayoutOrder = nextOrder(target)

    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4)
    pad.Parent = l

    local column = hud.colOf[parent] or (hud.cols[parent] and target)

    if column then
        hud.weight[column] = (hud.weight[column] or 0) + (height or 28) + 6
    end

    return l
end

-- A full-width button under a block.
local function buttonRow(parent, text, opts)
    opts = opts or {}

    local target = hud.cols[parent] and hud.columnFor(parent, false) or parent

    local height = math.max(opts.height or 24, 30)

    local b = button(
        target, text,
        UDim2.new(), UDim2.new(1, 0, 0, height),
        opts
    )
    b.LayoutOrder = nextOrder(target)

    local column = hud.colOf[parent] or (hud.cols[parent] and target)

    if column then
        hud.weight[column] = (hud.weight[column] or 0) + height + 4
    end

    return b
end

-- Option lists: a segmented bar under the name. The chosen option is white.
local function segmented(parent, titleText, options, initial, onSelect)
    local row = newRow(parent, 48, false)

    label(
        row, titleText,
        UDim2.fromOffset(4, 1), UDim2.new(1, -8, 0, 17),
        11, UI.text, false
    ).Font = Enum.Font.GothamMedium

    local count = #options

    local holder = Instance.new("Frame")
    holder.Position = UDim2.fromOffset(4, 22)
    holder.Size = UDim2.new(1, -8, 0, 22)
    holder.BackgroundColor3 = UI.line2
    holder.BorderSizePixel = 0
    holder.Parent = row
    corner(holder, 2)

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 1)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = holder

    local current = initial
    local buttons = {}

    local function paint(b, selected)
        local color = selected and UI.white or UI.surface
        b:SetAttribute("BaseColor", color)
        b:SetAttribute("Locked", selected)
        b.BackgroundColor3 = color
        b.TextColor3 = selected and UI.bg or UI.muted
    end

    local function refresh()
        for name, b in pairs(buttons) do
            paint(b, name == current)
        end
    end

    for i, name in ipairs(options) do
        local b = Instance.new("TextButton")
        b.LayoutOrder = i
        b.Size = UDim2.new(1 / count, -(count - 1) / count, 1, 0)
        b.BackgroundColor3 = UI.surface
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        b.Font = Enum.Font.GothamMedium
        b.TextSize = 11
        b.Text = name
        b.Parent = holder
        buttons[name] = b

        b:SetAttribute("BaseColor", UI.surface)

        b.MouseEnter:Connect(function()
            if b.Parent and not b:GetAttribute("Locked") then
                b.BackgroundColor3 = UI.hover
            end
        end)

        b.MouseLeave:Connect(function()
            if b.Parent then
                local base = b:GetAttribute("BaseColor")
                if typeof(base) == "Color3" then b.BackgroundColor3 = base end
            end
        end)

        connect(b.Activated, function()
            current = name
            refresh()
            onSelect(name)
        end)
    end

    refresh()

    return {
        set = function(value)
            current = value
            refresh()
        end,
    }
end

-- Slider: name and value on one line, a thin bar with a handle under it.
local function createSlider(parent, titleText, subText, minV, maxV, startV, onChange)
    local obj = {}
    local value = math.clamp(startV, minV, maxV)

    local row = newRow(parent, 36, false)

    label(
        row, titleText,
        UDim2.fromOffset(4, 2), UDim2.new(1, -70, 0, 14),
        11, UI.text, false
    ).Font = Enum.Font.GothamMedium

    local valueLabel = label(
        row, tostring(value),
        UDim2.new(1, -4, 0, 2), UDim2.fromOffset(64, 14),
        11, UI.white, true
    )
    valueLabel.AnchorPoint = Vector2.new(1, 0)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Font = speedFont

    local track = Instance.new("TextButton")
    track.Name = (titleText:gsub("%s+", "")) .. "Slider"
    track.Position = UDim2.fromOffset(4, 20)
    track.Size = UDim2.new(1, -8, 0, 14)
    track.BackgroundTransparency = 1
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = row

    local bar = Instance.new("Frame")
    bar.AnchorPoint = Vector2.new(0, 0.5)
    bar.Position = UDim2.new(0, 0, 0.5, 0)
    bar.Size = UDim2.new(1, 0, 0, 4)
    bar.BackgroundColor3 = UI.surface
    bar.BorderSizePixel = 0
    bar.Parent = track
    corner(bar, 1)
    stroke(bar, UI.line, 1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = UI.signal
    fill.BorderSizePixel = 0
    fill.Parent = bar
    corner(fill, 1)

    local handle = Instance.new("Frame")
    handle.AnchorPoint = Vector2.new(0.5, 0.5)
    handle.Position = UDim2.new(0, 0, 0.5, 0)
    handle.Size = UDim2.fromOffset(5, 12)
    handle.BackgroundColor3 = UI.white
    handle.BorderSizePixel = 0
    handle.Parent = track
    corner(handle, 1)
    stroke(handle, UI.bg, 1, 0)

    local function render()
        local alpha = (value - minV) / (maxV - minV)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        handle.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
    end

    function obj.set(v)
        value = math.clamp(math.floor(v + 0.5), minV, maxV)
        render()
        if onChange then onChange(value) end
    end

    function obj.get()
        return value
    end

    function obj.setFromX(x)
        local width = math.max(track.AbsoluteSize.X, 1)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        obj.set(minV + alpha * (maxV - minV))
    end

    connect(track.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            state.activeSlider = obj
            lockScroll(true)
            obj.setFromX(input.Position.X)
        end
    end)

    hud.attachTip(row, subText)

    render()
    return obj
end


    return {
        state = state,
        corner = corner, stroke = stroke, label = label, fadeEnds = fadeEnds,
        button = button, setButtonState = setButtonState, nextOrder = nextOrder,
        lockScroll = lockScroll, group = group, newRow = newRow, toggleRow = toggleRow,
        bindRow = bindRow, statusRow = statusRow, noteRow = noteRow, buttonRow = buttonRow,
        segmented = segmented, createSlider = createSlider,
    }
end

return {Theme = Theme, createWidgets = createWidgets}
