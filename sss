hud.activeTab = "esp"

hud.selectTab = function(id)
    if not hud.pages[id] then return end

    local switched = id ~= hud.activeTab

    hud.activeTab = id
    hud.hideTip()

    -- Tabs with a side panel (ESP, Aimbot) give up some width for it.
    local hasDock = hud.docks[id] ~= nil

    for dockId, dock in pairs(hud.docks) do
        dock.Visible = dockId == id
    end

    -- The character preview only runs while its page is showing.
    for previewId, pv in pairs(hud.previews) do
        pv.active = previewId == id

        if pv.active then
            pv.refresh()
        end
    end

    for tabId, page in pairs(hud.pages) do
        page.Visible = tabId == id
        page.Position = UDim2.new()
        page.Size = (tabId == id and hasDock)
            and UDim2.new(1, -(hud.dockW + 12), 1, 0)
            or UDim2.new(1, 0, 1, 0)
    end

    -- The new page settles into place instead of just appearing.
    if switched then
        local page = hud.pages[id]
        page.Position = UDim2.fromOffset(0, 8)

        TweenService:Create(
            page,
            TweenInfo.new(esp.performance.tweenTime(0.2), Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {Position = UDim2.new()}
        ):Play()
    end

    for tabId, tab in pairs(tabButtons) do
        local on = tabId == id

        tab.caption.TextColor3 = on and UI.white or UI.muted
        tab.icon(on and UI.white or UI.muted)

        TweenService:Create(
            tab.button, TweenInfo.new(esp.performance.tweenTime(0.12)), {BackgroundTransparency = 1}
        ):Play()
    end

    -- The line under the chosen tab slides over to it.
    local lineTarget = UDim2.fromOffset(tabButtons[id].x, 25)

    if switched then
        TweenService:Create(
            hud.tabLine,
            TweenInfo.new(esp.performance.tweenTime(0.22), Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {Position = lineTarget}
        ):Play()
    else
        hud.tabLine.Position = lineTarget
    end

    hud.pageDesc.Text = PAGE_INFO[id] or ""

    if id == "players" then
        refreshPlayerList()
    end
end

for tabId, tab in pairs(tabButtons) do
