    if hud.drag.on and hud.drag.start and hud.drag.pos then
        local delta = input.Position - hud.drag.start
        local vp = hud.viewportSize()

        main.Position = UDim2.fromOffset(
            math.clamp(hud.drag.pos.X.Offset + delta.X, 0, math.max(vp.X - main.Size.X.Offset, 0)),
            math.clamp(hud.drag.pos.Y.Offset + delta.Y, 0, math.max(vp.Y - main.Size.Y.Offset, 0))
        )
    end

    if hud.drag.logoOn and hud.drag.logoStart and hud.drag.logoPos then
        local delta = input.Position - hud.drag.logoStart

        -- A tiny wobble still counts as a click, not a drag.
        if delta.Magnitude > 4 then
            hud.drag.logoMoved = true
        end

        if hud.drag.logoMoved then
            local vp = hud.viewportSize()

            hud.logo.Position = UDim2.fromOffset(
                math.clamp(hud.drag.logoPos.X.Offset + delta.X, 0, math.max(vp.X - hud.BADGE, 0)),
                math.clamp(hud.drag.logoPos.Y.Offset + delta.Y, 0, math.max(vp.Y - hud.BADGE, 0))
            )
        end
    end
end)

--==============================================================
-- PER-FRAME UPDATE (self overrides, ESP, badge, spectate, stats bar)
--==============================================================

do
-- ESP has its own loop    : an error anywhere else can never stall it, and it
    -- also refreshes right away when a new Humanoid model shows up.
    local espSeenVersion = -1

    connect(RunService.Heartbeat, function(dt)
        if destroyed then return end

        if not (esp.on or esp.npcs) then
            esp.timer = esp.interval
            return
        end

        esp.timer += dt

        if esp.timer >= esp.interval or espSeenVersion ~= Targets.version then
            esp.timer = 0
            espSeenVersion = Targets.version
            esp.safeUpdate()
        end
    end)

    -- Store heartbeat timers on the existing hud table to avoid allocating
    -- additional main-chunk local registers in this large standalone script.
    hud.frameRefreshTimer, hud.statsTimer = 0, 0

    connect(RunService.Heartbeat, function(dt)
        if destroyed or not gui.Parent then return end

        -- Safety net: the badge is always visible while minimized.
        if not hud.splash
            and (hud.logo.Visible ~= isMinimized or main.Visible == isMinimized) then
            hud.applyMenuVisibility()
        end

        hud.frameRefreshTimer += dt
        if hud.frameRefreshTimer >= 0.5 then
            hud.frameRefreshTimer = 0
            refreshRefs()
            -- Do not force the FOV during execution or respawn. Camera FOV is
            -- only changed by explicit user input in the Camera controls.
        end

        -- Keep walk speed / jump power overrides applied.
        applySelf()

        -- Badge dot shows whether anything is running.
        local active = flying or noClipEnabled or walkOn or jumpOn
            or infiniteJump or esp.on or esp.npcs or aim.on
        if activeDot.Visible ~= active then
            activeDot.Visible = active
        end

        -- Touch aim button only exists while aim lock is on.
        if hud.touchAim.Visible ~= aim.on then
            hud.touchAim.Visible = aim.on
        end

        -- Stop spectating if the target left or died.
        if spectating then
            local targetHumanoid = selectedPlayer
                and selectedPlayer.Character
                and selectedPlayer.Character:FindFirstChildOfClass("Humanoid")

            if not selectedPlayer or selectedPlayer.Parent ~= Players
                or not targetHumanoid or targetHumanoid.Health <= 0 then
                stopSpectating()
            end
        end

        fpsFrames += 1
        fpsElapsed += dt

        if fpsElapsed >= 0.5 then
            currentFPS = math.floor(
                fpsFrames / math.max(fpsElapsed, 0.001) + 0.5
            )
            fpsFrames, fpsElapsed = 0, 0
        end

        -- Text readouts only need a few updates per second.
        hud.statsTimer += dt
        if hud.statsTimer < esp.performance.statsInterval then return end
        hud.statsTimer = 0

        -- Note on the ESP page: only when the game streams the map and some
        -- players are out of range, so "missing" players are explained.
        if esp.infoRow then
            local count = esp.notLoaded
            local show = esp.on and workspace.StreamingEnabled and count > 0

            if esp.infoRow.Visible ~= show then
                esp.infoRow.Visible = show
            end

            if show then
                esp.infoLabel.Text = string.format(
                    "%d %s out of range. This game streams the map, so they appear as soon as it loads them in.",
                    count, count == 1 and "player is" or "players are"
                )
            end
        end

        -- ESP side panel: how many targets are drawn.
        -- Players the game has streamed out of range have no character on
        -- your client, so the aimbot cannot reach them.
        do
            local unloaded = 0

            if workspace.StreamingEnabled then
                for _, other in ipairs(Players:GetPlayers()) do
                    if other ~= player then
                        local model = other.Character

                        if not model or not model:IsDescendantOf(workspace) then
                            unloaded += 1
                        end
                    end
                end
            end

            local text = string.format(
                "%d %s not loaded on your client (the game streams the map), so they cannot be targeted until in range.",
                unloaded, unloaded == 1 and "player is" or "players are"
            )

            if aim.streamNote then
                local show = aim.on and unloaded > 0
                if aim.streamNote.Visible ~= show then aim.streamNote.Visible = show end
                if show then aim.streamNote.Text = text end
            end
        end

        if esp.statusText then
            local text

            if esp.on or esp.npcs then
                text = esp.shown == 1
                    and "Tracking 1 target"
                    or ("Tracking " .. esp.shown .. " targets")
            else
                text = "ESP is off"
            end

            if esp.statusText.Text ~= text then
                esp.statusText.Text = text
            end
        end

        -- Sidebar footer: how many features are on.
        if hud.activeLabel then
            local n = 0

            for _, on in ipairs({
                flying, noClipEnabled, walkOn, jumpOn, infiniteJump,
                esp.on, esp.npcs, aim.on,
            }) do
                if on then n += 1 end
            end

            hud.activeLabel.Text = n == 0 and "Nothing active" or (n .. " active")
            hud.activeLabel.TextColor3 = n == 0 and UI.muted or UI.white
            hud.activeDot.BackgroundColor3 = n == 0 and UI.line or UI.white
        end

        -- Team / friend-foe colours are on, but the game gives no team info.
        if esp.teamNote then
            local count = esp.noTeamData
            local show = esp.colorMode ~= "Single"
                and (esp.on or esp.npcs)
                and esp.shown > 0
                and count > 0

            if esp.teamNote.Visible ~= show then
                esp.teamNote.Visible = show
            end

            if show then
                esp.teamNote.Text = string.format(
                    "No team info found for %d of %d targets in this game, so they use the marker color.",
                    count, esp.shown
                )
            end
        end

        if not hud.telemetryVisible then return end

        local pingValue = "--"

        local okPing, pingItem = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]
        end)

        if okPing and pingItem then
            local okValue, value = pcall(function()
                return pingItem:GetValue()
            end)

            if okValue and typeof(value) == "number" then
                pingValue = string.format("%dms", math.floor(value + 0.5))
            end
        end

        hud.fpsText.Text = string.format(
            'FPS <font color="#F6F6F6">%d</font>', currentFPS
        )
        hud.pingText.Text = string.format(
            'PING <font color="#F6F6F6">%s</font>', pingValue
        )

        local activeCount = 0
        local showFullChips = hud.viewportSize().X >= 860

        for _, chip in ipairs(hud.chips) do
            local isOn = chip.test() == true
            if isOn then activeCount += 1 end

            local visible = isOn and showFullChips
            if chip.label.Visible ~= visible then
                chip.label.Visible = visible
            end
        end

        local showCompactCount = not showFullChips and activeCount > 0
        hud.compactActive.Text = tostring(activeCount) .. " active"
        if hud.compactActive.Visible ~= showCompactCount then
            hud.compactActive.Visible = showCompactCount
        end

        local anyChip = activeCount > 0
        if hud.statsDivider.Visible ~= anyChip then
            hud.statsDivider.Visible = anyChip
        end
    end)
end

