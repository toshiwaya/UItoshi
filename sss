-- MAIN WINDOW
--==============================================================
-- `main` is the outer frame (real pixels, draggable). `window` is the
-- WINDOW_W x WINDOW_H design surface inside it, scaled with UIScale so the
-- whole menu shrinks to fit phones and small windows.
--
-- Layout: a double border, a thin accent line, a title bar, a row of tabs
-- along the top, the pages, and a status strip at the bottom.

local main = Instance.new("Frame")
main.Name = "Main"
main.Size = UDim2.fromOffset(WINDOW_W, WINDOW_H)
main.Position = UDim2.fromOffset(40, 40)
main.BackgroundColor3 = UI.frame
main.BorderSizePixel = 0
main.Active = true
main.ZIndex = 2
main.Parent = gui

corner(main, UI.windowRadius)
stroke(main, UI.line2, 1, 0)

-- A soft shadow: two larger dark frames behind, kept in step with the window.
do
    local layers = {}

    for _, spec in ipairs({{26, 0.9, 9}, {12, 0.8, 7}}) do
        local f = Instance.new("Frame")
        f.BackgroundColor3 = Color3.new(0, 0, 0)
        f.BackgroundTransparency = spec[2]
        f.BorderSizePixel = 0
        f.ZIndex = 1
        f.Parent = gui
        corner(f, spec[3])
        layers[#layers + 1] = {frame = f, grow = spec[1]}
    end

    local function sync()
        local p, s = main.Position, main.Size

        for _, layer in ipairs(layers) do
            local grow = layer.grow

            layer.frame.Position = UDim2.fromOffset(
                p.X.Offset - grow, p.Y.Offset - grow + 6
            )
            layer.frame.Size = UDim2.fromOffset(
                s.X.Offset + grow * 2, s.Y.Offset + grow * 2
            )
            layer.frame.Visible = main.Visible
        end
    end

    connect(main:GetPropertyChangedSignal("Position"), sync)
    connect(main:GetPropertyChangedSignal("Size"), sync)
    connect(main:GetPropertyChangedSignal("Visible"), sync)
    sync()
end

local window = Instance.new("Frame")
window.Name = "Window"
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.Position = UDim2.fromScale(0.5, 0.5)
window.Size = UDim2.fromOffset(WINDOW_W, WINDOW_H)
window.BackgroundTransparency = 1
window.BorderSizePixel = 0
window.Parent = main

local windowScale = Instance.new("UIScale")
windowScale.Parent = window

hud.viewportSize = function()
    -- Use the same coordinate space as ScreenGui children (including the
    -- Roblox top-bar inset). Mixing Camera.ViewportSize with ScreenGui offsets
    -- can let the window and draggable stats bar slip beyond the visible edge.
    local ok, size = pcall(function()
        return gui.AbsoluteSize
    end)
    if ok and size and size.X >= 50 and size.Y >= 50 then
        return size
    end

    local camera = workspace.CurrentCamera
    if camera then
        size = camera.ViewportSize
        if size and size.X >= 50 and size.Y >= 50 then
            return size
        end
    end

    return Vector2.new(WINDOW_W, WINDOW_H)
end

local placed = false

hud.applyLayout = function()
    local vp = hud.viewportSize()
    if vp.X < 50 or vp.Y < 50 then return end

    -- Snap the effective UIScale to 0.05 increments. Fractional scales such as
    -- 1.034 rasterize small text at uneven pixel sizes and can make the menu look
    -- soft/blurry. Round DOWN so the menu still fits the available viewport.
    local rawScale = math.min(
        menuScale / 100, (vp.X - 16) / WINDOW_W, (vp.Y - 16) / WINDOW_H
    )
    local scale = math.clamp(math.floor(rawScale * 20) / 20, 0.05, 1.5)
    windowScale.Scale = scale

    local w = math.floor(WINDOW_W * scale)
    local h = math.floor(WINDOW_H * scale)
    main.Size = UDim2.fromOffset(w, h)

    local px, py

    if placed then
        px, py = main.Position.X.Offset, main.Position.Y.Offset
    else
        px, py = (vp.X - w) / 2, (vp.Y - h) / 2
        placed = true
    end

    main.Position = UDim2.fromOffset(
        math.clamp(px, 0, math.max(vp.X - w, 0)),
        math.clamp(py, 0, math.max(vp.Y - h, 0))
    )
end

hud.applyLayout()
connect(gui:GetPropertyChangedSignal("AbsoluteSize"), hud.applyLayout)

-- Recompute the fit whenever Roblox changes camera/viewport dimensions. This
-- also handles phone rotation and UI created before the camera has settled.
connect(workspace:GetPropertyChangedSignal("CurrentCamera"), function()
    hud.applyLayout()
    local camera = workspace.CurrentCamera
    if camera then
        connect(camera:GetPropertyChangedSignal("ViewportSize"), hud.applyLayout)
    end
end)
if workspace.CurrentCamera then
    connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), hud.applyLayout)
end
task.defer(hud.applyLayout)
task.delay(0.25, hud.applyLayout)

