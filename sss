--==============================================================
-- FLIGHT PHYSICS
--==============================================================

stopFly = function()
    flying = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if velocity then velocity:Destroy(); velocity = nil end
    if orientation then orientation:Destroy(); orientation = nil end
    if flyAttachment then flyAttachment:Destroy(); flyAttachment = nil end

    if humanoid and humanoid.Parent then
        if savedPlatformStand ~= nil then
            humanoid.PlatformStand = savedPlatformStand
        end

        savedPlatformStand = nil

        if humanoid.Health > 0 then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    else
        savedPlatformStand = nil
    end

    currentSpeed = 0

    if not destroyed then
        hud.updateBindLabels()
    end
end

hud.startFly = function()
    if flying then return end

    if not character or not character.Parent
        or not humanoid or humanoid.Health <= 0
        or not root or not root.Parent then
        notify("Cannot fly: character is not ready", false)
        return
    end

    savedPlatformStand = humanoid.PlatformStand

    flyAttachment = Instance.new("Attachment")
    flyAttachment.Name = "ToshiCC_FlyAttachment"
    flyAttachment.Parent = root

    velocity = Instance.new("LinearVelocity")
    velocity.Name = "ToshiCC_FlyVelocity"
    velocity.Attachment0 = flyAttachment
    velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    velocity.VectorVelocity = Vector3.zero
    velocity.MaxForce = 10000000
    velocity.Parent = root

    orientation = Instance.new("AlignOrientation")
    orientation.Name = "ToshiCC_FlyOrientation"
    orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    orientation.Attachment0 = flyAttachment
    orientation.Responsiveness = 18
    orientation.MaxTorque = 10000000
    orientation.RigidityEnabled = false
    orientation.CFrame = root.CFrame.Rotation
    orientation.Parent = root

    flying = true
    humanoid.PlatformStand = true
    hud.updateBindLabels()

    flyConnection = RunService.RenderStepped:Connect(function(dt)
        if not flying or not root or not root.Parent
            or not humanoid or humanoid.Health <= 0
            or not velocity or not velocity.Parent
            or not orientation or not orientation.Parent then
            stopFly()
            return
        end

        local camera = workspace.CurrentCamera

        if not camera then
            velocity.VectorVelocity = Vector3.zero
            return
        end

        local direction = Vector3.zero
        local forward = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector

        if UIS:IsKeyDown(Enum.KeyCode.W) then direction += forward end
        if UIS:IsKeyDown(Enum.KeyCode.S) then direction -= forward end
        if UIS:IsKeyDown(Enum.KeyCode.D) then direction += right end
        if UIS:IsKeyDown(Enum.KeyCode.A) then direction -= right end

        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end

        if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
            or UIS:IsKeyDown(Enum.KeyCode.RightControl) then
            direction -= Vector3.yAxis
        end

        if UIS.TouchEnabled and humanoid.MoveDirection.Magnitude > 0.05 then
            direction += humanoid.MoveDirection
        end

        local ok, states = pcall(function()
            return UIS:GetGamepadState(Enum.UserInputType.Gamepad1)
        end)

        if ok and states then
            for _, state in ipairs(states) do
                if state.KeyCode == Enum.KeyCode.Thumbstick1
                    and state.Position.Magnitude > 0.12 then
                    direction += camera.CFrame.RightVector * state.Position.X
                        + camera.CFrame.LookVector * state.Position.Y
                end
            end
        end

        if touchVertical ~= 0 then
            direction += Vector3.yAxis * touchVertical
        end

        if direction.Magnitude > 1 then
            direction = direction.Unit
        end

        local desired = direction * flySpeed
        local alpha = 1 - math.exp(-12 * math.clamp(dt, 0, 0.1))

        velocity.VectorVelocity =
            velocity.VectorVelocity:Lerp(desired, alpha)

        currentSpeed = root.AssemblyLinearVelocity.Magnitude

        orientation.CFrame =
            CFrame.lookAt(Vector3.zero, camera.CFrame.LookVector).Rotation
    end)
end

