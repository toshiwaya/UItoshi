            local function colorToHex(color)
                return string.format(
                    "%02X%02X%02X",
                    math.floor(color.R * 255 + 0.5),
                    math.floor(color.G * 255 + 0.5),
                    math.floor(color.B * 255 + 0.5)
                )
            end

            local function updatePickerVisuals()
                local picked = Color3.fromHSV(pickerState.h, pickerState.s, pickerState.v)
                esp.color = picked
                esp.colorName = pickerState.name or "Custom"
                svField.BackgroundColor3 = Color3.fromHSV(pickerState.h, 1, 1)
                svPointer.Position = UDim2.new(
                    math.clamp(pickerState.s, 0.025, 0.975), 0,
                    math.clamp(1 - pickerState.v, 0.045, 0.955), 0
                )
                huePointer.Position = UDim2.new(math.clamp(pickerState.h, 0.012, 0.988), 0, 0.5, 0)
                colorPreview.BackgroundColor3 = picked
                if not hexBox:IsFocused() then
                    hexBox.Text = "#" .. colorToHex(picked)
