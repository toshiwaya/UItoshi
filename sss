-- STATS BAR AND TOUCH CONTROLS
--==============================================================
-- FPS and ping, then one chip per feature that is switched on. With
-- everything off, only FPS and ping are shown.

hud.statsBar = Instance.new("Frame")
hud.statsBar.Name = "StatsBar"
hud.statsBar.AnchorPoint = Vector2.new(0.5, 0)
hud.statsBar.Position = UDim2.new(0.5, 0, 0, 10)
hud.statsBar.Size = UDim2.fromOffset(160, 30)
hud.statsBar.AutomaticSize = Enum.AutomaticSize.None
hud.statsBar.ClipsDescendants = true
hud.statsBar.BackgroundColor3 = UI.frame
hud.statsBar.BackgroundTransparency = 0.04
hud.statsBar.BorderSizePixel = 0
hud.statsBar.ZIndex = 10
hud.statsBar.Parent = gui

-- Drag the stats bar by holding the left mouse button or touch-dragging it.
-- Clamp its center to the visible viewport so it cannot be lost off-screen.
do
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPosition = nil

    local function clampStatsPosition(x, y)
        local viewport = hud.viewportSize()
        local halfWidth = math.max(hud.statsBar.AbsoluteSize.X / 2, 20)
        local height = math.max(hud.statsBar.AbsoluteSize.Y, 20)
        x = math.clamp(x, halfWidth, math.max(halfWidth, viewport.X - halfWidth))
        y = math.clamp(y, 0, math.max(0, viewport.Y - height))
        return x, y
    end

    local function beginDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging = true
        dragStart = input.Position
        local absPos = hud.statsBar.AbsolutePosition
        startPosition = Vector2.new(absPos.X + hud.statsBar.AbsoluteSize.X / 2, absPos.Y)
        dragInput = input
    end

    local function bindDragTarget(target)
        if not target:IsA("GuiObject") then return end
        target.InputBegan:Connect(beginDrag)
    end

    bindDragTarget(hud.statsBar)
    for _, descendant in ipairs(hud.statsBar:GetDescendants()) do
        bindDragTarget(descendant)
    end

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or (dragInput and input == dragInput) then
            local delta = input.Position - dragStart
            local x = startPosition.X + delta.X
            local y = startPosition.Y + delta.Y
            x, y = clampStatsPosition(x, y)
            hud.statsBar.Position = UDim2.new(0, x, 0, y)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
