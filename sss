    local function validSelected()
        if not selectedPlayer or selectedPlayer.Parent ~= Players then
            notify("Select a player first", false)
            return false
        end
        return true
    end

    -- Client-only adaptation of the user's example. It moves the LOCAL
    -- character around the selected target with strong local physics impulses.
    -- This does not call a RemoteEvent and cannot guarantee that another
    -- player's character will be affected; Roblox network ownership decides
    -- what physics the client is allowed to replicate.
    local clientFlingRunning = false

    local function runClientFling(targetPlayer)
        if clientFlingRunning then
            notify("A fling attempt is already running", false)
            return
        end

        if not targetPlayer or targetPlayer == player or targetPlayer.Parent ~= Players then
            notify("Select another player first", false)
            return
        end

        local myCharacter = player.Character
        local myHumanoid = myCharacter and myCharacter:FindFirstChildOfClass("Humanoid")
        local myRoot = myCharacter and Targets.rootOf(myCharacter, myHumanoid)
        local targetCharacter = targetPlayer.Character
        local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
        local targetRoot = targetCharacter and Targets.rootOf(targetCharacter, targetHumanoid)

        if not myCharacter or not myCharacter.Parent or not myHumanoid
            or myHumanoid.Health <= 0 or not myRoot then
            notify("Your character is not ready", false)
            return
        end
        if not targetCharacter or not targetCharacter.Parent or not targetHumanoid
            or targetHumanoid.Health <= 0 or not targetRoot then
            notify("That player's character is not ready", false)
            return
        end
        if targetHumanoid.Sit then
            notify(targetPlayer.Name .. " is sitting; fling attempt cancelled", false)
            return
        end

        clientFlingRunning = true
        flingButton.Text = "Flinging..."
        flingButton:SetAttribute("Locked", true)

        local originalCFrame = myRoot.CFrame
        local originalCameraSubject
        local camera = workspace.CurrentCamera
        if camera then originalCameraSubject = camera.CameraSubject end

        local seatedEnabled = true
        pcall(function()
            seatedEnabled = myHumanoid:GetStateEnabled(Enum.HumanoidStateType.Seated)
            myHumanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        end)

        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "ToshiClientFlingVelocity"
        bodyVelocity.P = 1e9
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bodyVelocity.Parent = myRoot

        task.spawn(function()
            local ok, err = xpcall(function()
                local startTime = os.clock()
                local angle = 0
                local duration = 2

                while os.clock() - startTime < duration
                    and not destroyed
                    and myCharacter.Parent
                    and myRoot.Parent
                    and targetPlayer.Parent == Players
                    and targetCharacter.Parent
                    and targetRoot.Parent do

                    angle += 100
                    local targetSpeed = math.min(targetRoot.AssemblyLinearVelocity.Magnitude, 80)
                    local direction = targetHumanoid.MoveDirection * (targetSpeed / 1.25)

                    for _, verticalOffset in ipairs({1.5, -1.5}) do
                        if destroyed or not myRoot.Parent or not targetRoot.Parent then
                            break
                        end

                        local destination = CFrame.new(targetRoot.Position)
                            * CFrame.new(0, verticalOffset, 0)
                            * CFrame.new(direction)
                            * CFrame.Angles(math.rad(angle), 0, 0)

                        myCharacter:PivotTo(destination)
                        -- Match the supplied sample's high-impulse local physics
                        -- pattern, but keep all changes confined to this client.
                        myRoot.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
                        myRoot.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
                        task.wait()
                    end
                end
            end, debug.traceback)

            if bodyVelocity and bodyVelocity.Parent then
                bodyVelocity:Destroy()
            end

            pcall(function()
                if myHumanoid and myHumanoid.Parent then
                    myHumanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, seatedEnabled)
                end
            end)

            -- Return the local character and camera safely after the attempt.
            pcall(function()
                if myCharacter and myCharacter.Parent and myRoot and myRoot.Parent
                    and myRoot:IsDescendantOf(myCharacter) then
                    myCharacter:PivotTo(originalCFrame)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                end
            end)
            pcall(function()
                local currentCamera = workspace.CurrentCamera
                if currentCamera and originalCameraSubject and originalCameraSubject.Parent then
                    currentCamera.CameraSubject = originalCameraSubject
                elseif currentCamera and myHumanoid and myHumanoid.Parent then
                    currentCamera.CameraSubject = myHumanoid
                end
            end)

            clientFlingRunning = false
            if flingButton and flingButton.Parent then
                flingButton.Text = "Fling selected"
                flingButton:SetAttribute("Locked", false)
            end

            if not ok then
                warnOnce("ClientFling", err)
                notify("Client fling attempt stopped due to an error", false)
            else
                notify(
                    "Client fling attempt finished; target launch is not guaranteed",
                    false
                )
            end
        end)
    end

