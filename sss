            local lastLiveRefresh = 0
            local function applyPickerColor(forceRefresh)
                pickerState.name = "Custom"
                updatePickerVisuals()
                -- Avoid forcing a full ESP redraw on every single pointer
                -- event; refresh at most 20 times/second while dragging.
                local now = os.clock()
                if forceRefresh or now - lastLiveRefresh >= 0.05 then
