-- Team detection that works across games.
--
-- Where team information is read from:
--   1) the Roblox Teams service (Player.Team)
--   2) Player.TeamColor, when the player is not neutral
--   3) attributes and Value objects with a team-like name (Team, TeamName,
--      TeamId, TeamColor, Side, Faction ...) on the player, the character,
--      its Humanoid, and one level of folders under the player (leaderstats,
--      Data, Stats ...)
-- NPC models are read the same way (model and Humanoid).
--
-- Two players count as teammates when nothing says "different" and at least
-- one source says "same". Free-for-all games therefore never hide anybody.
-- Targets with no team data at all are "unknown": not teammates, no team
-- colour.
do
    local Teams = game:GetService("Teams")

    local TEAM_KEYS = {
        team = true, teamname = true, teamid = true, teamcolor = true,
        teamnumber = true, teamnum = true, teamindex = true, teamside = true,
        currentteam = true, playerteam = true, myteam = true,
        side = true, faction = true, alliance = true,
    }

    -- Names that contain "team" but are numbers about the team, not the team.
    local TEAM_BAD = {
        "kill", "score", "damage", "point", "rank", "count", "chat", "death",
        "win", "level", "cash", "money", "time", "size", "limit", "total",
        "ratio", "assist", "capture",
    }

    local KEY_PRIORITY = {
        "__playerteamcolor", "teamcolor", "team", "teamname", "teamid",
        "teamnumber", "teamnum", "teamindex", "currentteam", "playerteam",
        "myteam", "teamside", "side", "faction", "alliance",
    }

    -- Used when a game stores a team as a plain word.
    local NAMED = {
        red = Color3.fromRGB(255, 80, 80),
        blue = Color3.fromRGB(80, 160, 255),
        green = Color3.fromRGB(90, 235, 120),
        yellow = Color3.fromRGB(255, 215, 70),
        orange = Color3.fromRGB(255, 150, 60),
        purple = Color3.fromRGB(190, 110, 255),
        pink = Color3.fromRGB(255, 110, 190),
        cyan = Color3.fromRGB(0, 225, 225),
        white = Color3.fromRGB(245, 245, 245),
        black = Color3.fromRGB(60, 60, 60),
        gray = Color3.fromRGB(160, 160, 160),
        grey = Color3.fromRGB(160, 160, 160),
        brown = Color3.fromRGB(160, 110, 70),
    }

    -- Teams the game gives no colour get a stable one from this list, so the
    -- same team is always the same colour.
    local PALETTE = {
        Color3.fromRGB(255, 80, 80),
        Color3.fromRGB(80, 160, 255),
        Color3.fromRGB(90, 235, 120),
        Color3.fromRGB(255, 205, 70),
        Color3.fromRGB(190, 110, 255),
        Color3.fromRGB(255, 150, 60),
        Color3.fromRGB(0, 225, 225),
        Color3.fromRGB(255, 110, 190),
    }

    local function isTeamKey(key)
        if TEAM_KEYS[key] then return true end
        if not string.find(key, "team", 1, true) then return false end

        for _, bad in ipairs(TEAM_BAD) do
            if string.find(key, bad, 1, true) then return false end
        end

        return true
    end

    local function readTeamKeys(inst, out, deep)
        if not inst then return end

        for name, value in pairs(inst:GetAttributes()) do
            local key = string.lower(name)

            if value ~= nil and type(value) ~= "boolean" and isTeamKey(key) then
                out[key] = value
            end
        end

        local folders = 0

        for _, child in ipairs(inst:GetChildren()) do
            if child:IsA("ValueBase") then
                local key = string.lower(child.Name)

                if isTeamKey(key) then
                    local ok, value = pcall(function()
                        return child.Value
                    end)

                    if ok and value ~= nil and type(value) ~= "boolean" then
                        out[key] = value
                    end
                end
            elseif deep and folders < 8
                and (child:IsA("Folder") or child:IsA("Configuration")) then
                folders += 1
                readTeamKeys(child, out, false)
            end
        end
    end

    local teamCache = setmetatable({}, {__mode = "k"})

    local function teamInfo(plr)
        local now = os.clock()
        local info = teamCache[plr]

        if info and now - info.at < 0.5 then
            return info
        end

        if not info then
            info = {keys = {}}
            teamCache[plr] = info
        end

        info.at = now
        info.team = plr.Team
        table.clear(info.keys)

        readTeamKeys(plr, info.keys, true)

        local char = plr.Character

        if char then
            readTeamKeys(char, info.keys, false)
            readTeamKeys(char:FindFirstChildOfClass("Humanoid"), info.keys, false)
        end

        -- Some games set Player.TeamColor without creating Team objects.
        if plr.Team == nil and plr.Neutral == false then
            info.keys.__playerteamcolor = plr.TeamColor
        end

        return info
    end

    -- true: same values on every key both sides have. false: a shared key
    -- differs. nil: no key in common.
    local function compareKeys(a, b)
        local compared = false

        for key, value in pairs(a) do
            local other = b[key]

            if other ~= nil then
                compared = true

                if other ~= value then
                    return false
                end
            end
        end

        if compared then return true end
        return nil
    end

    -- true = teammate, false = other team, nil = no team data to decide.
    function Targets.teamRelation(other)
        if not other or other == player then return nil end

        local mine, theirs = teamInfo(player), teamInfo(other)
        local serviceVerdict

        if mine.team ~= nil and theirs.team ~= nil then
            serviceVerdict = mine.team == theirs.team
        end

        local keyVerdict = compareKeys(mine.keys, theirs.keys)

        if serviceVerdict == false or keyVerdict == false then
            return false
        end

        if serviceVerdict == true or keyVerdict == true then
            return true
        end

        return nil
    end

    function Targets.sameTeam(other)
        return Targets.teamRelation(other) == true
    end

    -- NPC models have no Player object, so their team can only come from
    -- team-like values on the model, matched against your own values or your
    -- Team's name / colour.
    local npcCache = setmetatable({}, {__mode = "k"})

    local function npcKeys(model)
        local now = os.clock()
        local entry = npcCache[model]

        if entry and now - entry.at < 0.5 then
            return entry.keys
        end

        if not entry then
            entry = {keys = {}}
            npcCache[model] = entry
        end

        entry.at = now
        table.clear(entry.keys)

        readTeamKeys(model, entry.keys, false)
        readTeamKeys(model:FindFirstChildOfClass("Humanoid"), entry.keys, false)

        return entry.keys
    end

    function Targets.npcRelation(model)
        local keys = npcKeys(model)
        if next(keys) == nil then return nil end

        local mine = teamInfo(player)
        local team = mine.team
        local compared = false

        for key, value in pairs(keys) do
            local own = mine.keys[key]

            if own ~= nil then
                compared = true

                if own == value then return true end
            end

            if team ~= nil then
                compared = true

                if value == team or value == team.Name
                    or value == team.TeamColor or value == team.TeamColor.Color then
                    return true
                end
            end
        end

        if compared then return false end
        return nil
    end

    function Targets.sameTeamNpc(model)
        return Targets.npcRelation(model) == true
    end

    -- Colours ---------------------------------------------------

    local function hashPick(text)
        local h = 0

        for i = 1, #text do
            h = (h * 31 + string.byte(text, i)) % 1000003
        end

        return PALETTE[h % #PALETTE + 1]
    end

    local function colorFromValue(value)
        local kind = typeof(value)

        if kind == "Color3" then return value end
        if kind == "BrickColor" then return value.Color end

        if kind == "Instance" then
            if value:IsA("Team") then return value.TeamColor.Color end
            return hashPick(value.Name)
        end

        if kind == "string" then
            local lower = string.lower((string.gsub(value, "^%s*(.-)%s*$", "%1")))
            if lower == "" then return nil end

            -- A team the game really has, by name.
            for _, team in ipairs(Teams:GetTeams()) do
                if string.lower(team.Name) == lower then
                    return team.TeamColor.Color
                end
            end

            if NAMED[lower] then return NAMED[lower] end

            local hex = string.match(lower, "^#?(%x%x%x%x%x%x)$")

            if hex then
                local ok, color = pcall(Color3.fromHex, hex)
                if ok then return color end
            end

            return hashPick(lower)
        end

        if kind == "number" then
            return PALETTE[math.floor(value) % #PALETTE + 1]
        end

        return nil
    end

    local function colorFromKeys(keys)
        for _, key in ipairs(KEY_PRIORITY) do
            local value = keys[key]

            if value ~= nil then
                local color = colorFromValue(value)
                if color then return color end
            end
        end

        local rest = {}

        for key in pairs(keys) do
            rest[#rest + 1] = key
        end

        table.sort(rest)

        for _, key in ipairs(rest) do
            local color = colorFromValue(keys[key])
            if color then return color end
        end

        return nil
    end

    -- The colour is worked out once per refresh of the cached team data,
    -- not on every ESP pass.
    function Targets.teamColorOf(plr)
        local info = teamInfo(plr)

        if info.colorStamp ~= info.at then
            info.colorStamp = info.at

            if info.team then
                info.color = info.team.TeamColor.Color
            else
                info.color = colorFromKeys(info.keys)
            end
        end

        return info.color
    end

    function Targets.npcTeamColor(model)
        local keys = npcKeys(model)
        local entry = npcCache[model]

        if entry.colorStamp ~= entry.at then
            entry.colorStamp = entry.at
            entry.color = colorFromKeys(keys)
        end

        return entry.color
    end
end

local function isLocalCharacter(model)
    return character ~= nil
        and (model == character or model:IsDescendantOf(character))
end

-- Players: a rig without a Humanoid, or with MaxHealth 0 (custom health
-- systems), counts as alive because there is nothing reliable to check.
-- NPCs with a Humanoid need MaxHealth above 0 and Health above 0. Models
-- may also carry Dead / Health attributes, which are honoured.
function Targets.isAlive(hum, isPlayer, model)
    if model then
        if model:GetAttribute("Dead") == true then return false end

        local hp = model:GetAttribute("Health")
        if type(hp) == "number" and hp <= 0 then return false end
    end

    if not hum then return true end
    if hum.MaxHealth <= 0 then return isPlayer == true end
    return hum.Health > 0
end

-- Return only parts matching the selected target option. Do not silently
-- fall back from Head to torso/root (or from Chest to Head) when a selected
-- part is missing or temporarily unusable. This prevents visible head/chest
-- target switching while aim is active.
function Targets.candidateParts(model, hum, choice, out)
    table.clear(out)

    local names = PART_ORDER[choice] or PART_ORDER.Head

    for _, name in ipairs(names) do
        local part = model:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            out[#out + 1] = part
            break -- exactly one semantic target part per rig
        end
    end

    -- Root-only compatibility for rigs whose Humanoid supplies a root part
    -- but doesn't name it HumanoidRootPart. Never use this for Head or Chest.
    if #out == 0 and choice == "Root" then
        local fallback = (hum and hum.RootPart) or model.PrimaryPart
        if fallback and fallback:IsA("BasePart") then
            out[1] = fallback
        end
    end

    return out
end

-- Props (fans, doors, lamps) are sometimes built on a HumanoidRootPart too.
-- A real character always has at least one of these body parts.
local RIG_PARTS = {"Head", "UpperTorso", "Torso", "LowerTorso"}

function Targets.looksLikeRig(model)
    for _, name in ipairs(RIG_PARTS) do
        local part = model:FindFirstChild(name)

        if part and part:IsA("BasePart") then
            return true
        end
    end

    return false
end

-- Strict full-rig test for Humanoid-less bots: root + head + torso. Props
-- (fans, doors, lamps) never have all three.
function Targets.isStrictRig(model)
    local hrp = model:FindFirstChild("HumanoidRootPart")
    local head = model:FindFirstChild("Head")

    if not (hrp and hrp:IsA("BasePart") and head and head:IsA("BasePart")) then
        return false
    end

    local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")

    return torso ~= nil and torso:IsA("BasePart")
end

local collectSeen = {}

-- The character the camera is attached to: your own, or the player you are
-- spectating. Looking out of it, so it is never a target.
function Targets.subjectModel(camera)
    local subject = camera and camera.CameraSubject
    if not subject then return nil end

    if subject:IsA("Humanoid") then
        return subject.Parent
    end

    return subject:FindFirstAncestorOfClass("Model")
end

-- Fills `out` with {model, hum, plr} entries. `plr` is nil for NPCs and
-- `hum` can be nil for player rigs that have no Humanoid. Each model is
-- listed once, and only models that are really inside Workspace.
function Targets.collect(out, wantPlayers, wantNpcs, camera)
    table.clear(out)
    table.clear(collectSeen)

    local subject = Targets.subjectModel(camera)
    if subject then collectSeen[subject] = true end

    -- 1) Players through Player.Character.
    if wantPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local model = plr.Character

                if model and model.Parent and not collectSeen[model]
                    and model:IsDescendantOf(workspace) then
                    collectSeen[model] = true
                    out[#out + 1] = {
                        model = model,
                        hum = model:FindFirstChildOfClass("Humanoid"),
                        plr = plr,
                    }
                end
            end
        end
    end

    -- 2) Registry models: anything with a Humanoid, a HumanoidRootPart, or a
    --    name that belongs to a player. This still finds a player whose
    --    Player.Character is nil or late, custom player bodies, and NPCs.
    if wantPlayers or wantNpcs then
        Targets.start()

        for model in pairs(Targets.models) do
            if not model.Parent or not model:IsDescendantOf(workspace) then
                Targets.models[model] = nil
            else
                local hum = model:FindFirstChildOfClass("Humanoid")
                local hrp = model:FindFirstChild("HumanoidRootPart")
                local owner = Players:GetPlayerFromCharacter(model)

                if not owner then
                    local named = Players:FindFirstChild(model.Name)

                    if named and named:IsA("Player") then
                        owner = named
                    end
                end

                if not hum and not hrp and not owner then
                    Targets.models[model] = nil
                elseif not collectSeen[model]
                    and not isLocalCharacter(model)
                    and not (camera and model:IsDescendantOf(camera)) then
                    if owner then
                        if owner ~= player and wantPlayers
                            and (hum or hrp or Targets.looksLikeRig(model)) then
                            collectSeen[model] = true
                            out[#out + 1] = {model = model, hum = hum, plr = owner}
                        end
                    elseif wantNpcs then
                        local rig

                        if hum then
                            rig = hum.MaxHealth > 0
                                and (Targets.looksLikeRig(model) or hrp ~= nil or model.PrimaryPart ~= nil)
                        else
                            rig = Targets.isStrictRig(model)
                        end

                        if rig then
                            collectSeen[model] = true
                            out[#out + 1] = {model = model, hum = hum, plr = nil}
                        end
                    end
                end
            end
        end
    end

    return out
end

--==============================================================
-- UI HELPERS
--==============================================================
-- The look: flat and hard-edged, in black, white and greys. Settings sit in
-- framed group boxes whose title cuts through the border, toggles are small
-- squares, sliders are thin bars with a handle, option lists are segmented
-- bars, and descriptions show up as tooltips. The helper names below are all
-- the feature code calls, so the look can change without touching features.

local gui = Instance.new("ScreenGui")
gui.Name = "ToshiCCMenu"
gui.ResetOnSpawn = false
gui.DisplayOrder = 50
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local function corner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or UI.radius)
    c.Parent = object
    return c
end

local function stroke(object, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    -- Border mode: a real border, not an outline around the text.
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Color = color or UI.line
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = object
    return s
end

local function label(parent, text, pos, size, fontSize, color, bold)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position = pos
    l.Size = size
    l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    -- Respect the size assigned to each control. A hard 13 px minimum clipped
    -- compact labels and made fixed-height rows crowd adjacent controls.
    l.TextSize = math.max(fontSize or 12, 11)
    l.TextColor3 = color or UI.text
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Text = text
    l.Parent = parent
    return l
end

-- A gradient that fades the ends of a hairline.
local function fadeEnds(object, rotation)
    local g = Instance.new("UIGradient")
    g.Rotation = rotation
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.18, 0),
        NumberSequenceKeypoint.new(0.82, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    g.Parent = object
    return g
end

-- Tooltips ---------------------------------------------------------
-- A small box that follows the pointer after a short hover. Rows with a
-- description register it here instead of printing it under their name.

do
    local tipGui = Instance.new("ScreenGui")
    tipGui.Name = "ToshiCCTip"
    tipGui.ResetOnSpawn = false
    tipGui.IgnoreGuiInset = true
    tipGui.DisplayOrder = 90
    tipGui.Parent = playerGui
    hud.tipGui = tipGui

    local frame = Instance.new("Frame")
    frame.AutomaticSize = Enum.AutomaticSize.XY
    frame.Size = UDim2.fromOffset(0, 0)
    frame.BackgroundColor3 = Color3.fromRGB(6, 6, 6)
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.ZIndex = 5
    frame.Parent = tipGui
    corner(frame, 2)
    stroke(frame, UI.line2, 1, 0)

    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 8)
    pad.PaddingRight = UDim.new(0, 8)
    pad.PaddingTop = UDim.new(0, 5)
    pad.PaddingBottom = UDim.new(0, 5)
    pad.Parent = frame

    local text = Instance.new("TextLabel")
    text.AutomaticSize = Enum.AutomaticSize.XY
    text.Size = UDim2.fromOffset(0, 0)
    text.BackgroundTransparency = 1
    text.Font = Enum.Font.Gotham
    text.TextSize = 12
    text.TextColor3 = UI.text
    text.TextWrapped = true
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Text = ""
    text.ZIndex = 6
    text.Parent = frame

    local limit = Instance.new("UISizeConstraint")
    limit.MaxSize = Vector2.new(230, 400)
    limit.Parent = text

    local hovering = 0

    function hud.attachTip(object, message)
        if not message or message == "" then return end

        object.MouseEnter:Connect(function()
            hovering += 1
            local id = hovering

            task.delay(0.4, function()
                if id == hovering and object.Parent then
                    text.Text = message
                    frame.Visible = true
                end
            end)
        end)

        object.MouseLeave:Connect(function()
            hovering += 1
            frame.Visible = false
        end)
    end

    function hud.hideTip()
        hovering += 1
        frame.Visible = false
    end

    connect(RunService.RenderStepped, function()
        if not frame.Visible then return end

        local m = UIS:GetMouseLocation()
        local screen = tipGui.AbsoluteSize
        local size = frame.AbsoluteSize

        frame.Position = UDim2.fromOffset(
            math.min(m.X + 16, math.max(screen.X - size.X - 4, 0)),
            math.min(m.Y + 20, math.max(screen.Y - size.Y - 4, 0))
        )
    end)
end

-- Buttons ----------------------------------------------------------

local function button(parent, text, pos, size, opts)
    opts = opts or {}

    local b = Instance.new("TextButton")
    b.Position = pos
    b.Size = size
    b.BackgroundColor3 = opts.background or UI.surface
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = opts.text or UI.text
    b.Font = opts.font or Enum.Font.GothamMedium
    b.TextSize = math.max(opts.textSize or 13, 12)
    -- Keep captions on one line and off the frame edge.
    b.TextWrapped = false
    b.TextTruncate = Enum.TextTruncate.AtEnd
    b.TextXAlignment = Enum.TextXAlignment.Center
    b.TextYAlignment = Enum.TextYAlignment.Center
    b.ClipsDescendants = true
    b.AutoButtonColor = false
    b.Parent = parent

    corner(b, opts.radius or UI.radius)
    stroke(b, UI.line2, 1, 0.4)

    b:SetAttribute("BaseColor", b.BackgroundColor3)

    b.MouseEnter:Connect(function()
        if b.Parent and not b:GetAttribute("Locked") then
            TweenService:Create(
                b, TweenInfo.new(esp.performance.tweenTime(0.1)), {BackgroundColor3 = UI.hover}
            ):Play()
        end
    end)

    b.MouseLeave:Connect(function()
        if b.Parent then
            local base = b:GetAttribute("BaseColor")
            if typeof(base) == "Color3" then
                TweenService:Create(
                    b, TweenInfo.new(esp.performance.tweenTime(0.1)), {BackgroundColor3 = base}
                ):Play()
            end
        end
    end)

    -- A short flash while the button is held down.
    b.MouseButton1Down:Connect(function()
        if b.Parent and not b:GetAttribute("Locked") then
            b.BackgroundColor3 = UI.line2
        end
    end)

    b.MouseButton1Up:Connect(function()
        if b.Parent and not b:GetAttribute("Locked") then
            b.BackgroundColor3 = UI.hover
        end
    end)

    return b
end

-- Checkbox rows redraw their box; plain buttons (touch controls) invert.
local function setButtonState(b, active)
    if not b or not b.Parent then return end

    local box = b:FindFirstChild("Check")

    if box then
        local fill = box:FindFirstChild("Fill")
        local caption = b:FindFirstChild("Caption")
        local outline = box:FindFirstChildOfClass("UIStroke")

        b:SetAttribute("On", active)

        if fill then
            TweenService:Create(
                fill, TweenInfo.new(esp.performance.tweenTime(0.12)),
                {BackgroundTransparency = active and 0 or 1}
            ):Play()
        end

        if outline then
            TweenService:Create(
                outline, TweenInfo.new(esp.performance.tweenTime(0.12)),
                {Color = active and UI.white or UI.line2}
            ):Play()
        end

        if caption then
            caption.TextColor3 = active and UI.white or UI.text
        end

        return
    end

    local color = active and UI.white or UI.surface
    b:SetAttribute("BaseColor", color)
    b:SetAttribute("Locked", active)
    b.BackgroundColor3 = color
    b.TextColor3 = active and UI.bg or UI.text
end

-- Layout order inside a list parent (column or group).
local orderOf = setmetatable({}, {__mode = "k"})

local function nextOrder(parent)
    local n = (orderOf[parent] or 0) + 1
    orderOf[parent] = n
    return n
end

-- Scrolling pages are locked while a slider is being dragged (touch).
local scrollPages = {}

local function lockScroll(locked)
    for _, page in ipairs(scrollPages) do
        page.ScrollingEnabled = not locked
    end
end

-- Pages are laid out in two columns. A new group goes into whichever column
-- is shorter so far; notes and buttons that follow stay in the same column.
hud.cols = setmetatable({}, {__mode = "k"})   -- page -> {left, right, last}
hud.weight = setmetatable({}, {__mode = "k"}) -- column -> rough height
hud.colOf = setmetatable({}, {__mode = "k"})  -- group -> column

function hud.columnFor(parent, forGroup)
    local set = hud.cols[parent]
    if not set then return parent end

    if forGroup then
        local lighter = (hud.weight[set.left] or 0) <= (hud.weight[set.right] or 0)
            and set.left or set.right
        set.last = lighter
        return lighter
    end

    return set.last or set.left
end

-- A framed block. Its title sits on the top border and cuts it. Rows are
-- added to the returned frame.
local function group(parent, titleText)
    local column = hud.columnFor(parent, true)

    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(1, 0, 0, 0)
    wrap.AutomaticSize = Enum.AutomaticSize.Y
    wrap.BackgroundTransparency = 1
    wrap.BorderSizePixel = 0
    wrap.LayoutOrder = nextOrder(column)
    wrap.Parent = column

    local g = Instance.new("Frame")
    g.Position = UDim2.fromOffset(0, 8)
    g.Size = UDim2.new(1, 0, 0, 0)
    g.AutomaticSize = Enum.AutomaticSize.Y
    g.BackgroundColor3 = UI.panel
    g.BorderSizePixel = 0
    g.Parent = wrap
    corner(g, 2)
    stroke(g, UI.line, 1, 0)

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 13)
    pad.PaddingBottom = UDim.new(0, 8)
    pad.PaddingLeft = UDim.new(0, 8)
    pad.PaddingRight = UDim.new(0, 8)
    pad.Parent = g

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 3)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = g

    if titleText then
        local t = label(
            wrap, titleText,
            UDim2.fromOffset(9, 0), UDim2.fromOffset(0, 16),
            12, UI.white, true
        )
        t.AutomaticSize = Enum.AutomaticSize.X
        t.BackgroundColor3 = UI.bg
        t.BackgroundTransparency = 0
        t.BorderSizePixel = 0
        t.ZIndex = 2

        local tp = Instance.new("UIPadding")
        tp.PaddingLeft = UDim.new(0, 4)
        tp.PaddingRight = UDim.new(0, 4)
        tp.Parent = t
    end

    hud.colOf[g] = column
    hud.weight[column] = (hud.weight[column] or 0) + 30

    return g
end

local ROW = UIS.TouchEnabled and 32 or 26

local function newRow(parent, height, asButton)
    local order = nextOrder(parent)
    local row

    if asButton then
        row = Instance.new("TextButton")
        row.Text = ""
        row.AutoButtonColor = false
    else
        row = Instance.new("Frame")
    end

    row.Size = UDim2.new(1, 0, 0, height)
    row.BackgroundColor3 = UI.white
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.LayoutOrder = order
    row.Parent = parent

    local column = hud.colOf[parent]

    if column then
        hud.weight[column] = (hud.weight[column] or 0) + height + 3
    end

    -- Clickable rows lighten very slightly under the pointer.
    if asButton then
        corner(row, 2)

        row.MouseEnter:Connect(function()
            if row.Parent then
                TweenService:Create(
                    row, TweenInfo.new(esp.performance.tweenTime(0.08)), {BackgroundTransparency = 0.95}
                ):Play()

                local caption = row:FindFirstChild("Caption")
                if caption and not row:GetAttribute("On") then
                    caption.TextColor3 = UI.white
                end
            end
        end)

        row.MouseLeave:Connect(function()
            if row.Parent then
                TweenService:Create(
                    row, TweenInfo.new(esp.performance.tweenTime(0.12)), {BackgroundTransparency = 1}
                ):Play()

                local caption = row:FindFirstChild("Caption")
                if caption and not row:GetAttribute("On") then
                    caption.TextColor3 = UI.text
                end
            end
        end)
    end

    return row
end

-- A checkbox row: a small square, the name, and an optional key tag on the
-- right. The description (if any) is a tooltip. Returns the row and its tag.
local function toggleRow(parent, name, description, withKey)
    local row = newRow(parent, ROW, true)

    local box = Instance.new("Frame")
    box.Name = "Check"
    box.AnchorPoint = Vector2.new(0, 0.5)
    box.Position = UDim2.new(0, 4, 0.5, 0)
    box.Size = UDim2.fromOffset(14, 14)
    box.BackgroundColor3 = UI.surface
    box.BorderSizePixel = 0
    box.Parent = row
    corner(box, 2)
    stroke(box, UI.line2, 1, 0)

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.AnchorPoint = Vector2.new(0.5, 0.5)
    fill.Position = UDim2.fromScale(0.5, 0.5)
    fill.Size = UDim2.fromOffset(8, 8)
    fill.BackgroundColor3 = UI.white
    fill.BackgroundTransparency = 1
    fill.BorderSizePixel = 0
    fill.Parent = box
    corner(fill, 1)

    local caption = label(
        row, name,
        UDim2.fromOffset(26, 0), UDim2.new(1, withKey and -110 or -30, 1, 0),
        12, UI.text, false
    )
    caption.Name = "Caption"
    caption.Font = Enum.Font.GothamMedium
    caption.TextTruncate = Enum.TextTruncate.AtEnd

    local chip

    if withKey then
        chip = Instance.new("TextLabel")
        chip.AnchorPoint = Vector2.new(1, 0.5)
        chip.Position = UDim2.new(1, -4, 0.5, 0)
        chip.Size = UDim2.fromOffset(0, 18)
        chip.AutomaticSize = Enum.AutomaticSize.X
        chip.BackgroundColor3 = UI.bg
        chip.BorderSizePixel = 0
        chip.Font = Enum.Font.GothamBold
        chip.TextSize = 11
        chip.TextColor3 = UI.muted
        chip.Text = ""
        chip.Parent = row
        corner(chip, 2)
        stroke(chip, UI.line, 1, 0)

        local chipPadding = Instance.new("UIPadding")
        chipPadding.PaddingLeft = UDim.new(0, 6)
        chipPadding.PaddingRight = UDim.new(0, 6)
        chipPadding.Parent = chip

        local chipMin = Instance.new("UISizeConstraint")
        chipMin.MinSize = Vector2.new(24, 18)
        chipMin.Parent = chip
    end

    hud.attachTip(row, description)

    return row, chip
end

-- A name on the left and a key button on the right.
local function bindRow(parent, name)
    local row = newRow(parent, ROW + 2, false)

    label(
        row, name,
        UDim2.fromOffset(26, 0), UDim2.new(0.5, 0, 1, 0),
        11, UI.text, false
    ).Font = Enum.Font.GothamMedium

    local b = button(
        row, "",
        UDim2.new(1, -4, 0.5, 0),
        UDim2.fromOffset(104, 18),
        {textSize = 10, background = UI.surface}
    )
    b.AnchorPoint = Vector2.new(1, 0.5)

    return b
end

-- A read-only line: name on the left, live value on the right.
local function statusRow(parent, name)
    local row = newRow(parent, 18, false)

    label(
        row, name,
        UDim2.fromOffset(26, 0), UDim2.new(0.3, 0, 1, 0),
        10, UI.muted, false
    )

    local value = label(
        row, "",
        UDim2.new(0.3, 0, 0, 0), UDim2.new(0.7, -4, 1, 0),
        10, UI.white, false
    )
    value.TextXAlignment = Enum.TextXAlignment.Right
    value.Font = Enum.Font.GothamMedium
    value.TextTruncate = Enum.TextTruncate.AtEnd

    return value
end

-- Plain explanatory text under a block.
local function noteRow(parent, text, height)
    local target = hud.cols[parent] and hud.columnFor(parent, false) or parent

    local l = label(
        target, text,
        UDim2.new(), UDim2.new(1, 0, 0, height or 28),
        11, UI.muted, false
    )
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.TextWrapped = true
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.LayoutOrder = nextOrder(target)

    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4)
    pad.Parent = l

    local column = hud.colOf[parent] or (hud.cols[parent] and target)

    if column then
        hud.weight[column] = (hud.weight[column] or 0) + (height or 28) + 6
    end

    return l
end

-- A full-width button under a block.
local function buttonRow(parent, text, opts)
    opts = opts or {}

    local target = hud.cols[parent] and hud.columnFor(parent, false) or parent

    local height = math.max(opts.height or 24, 30)

    local b = button(
        target, text,
        UDim2.new(), UDim2.new(1, 0, 0, height),
        opts
    )
    b.LayoutOrder = nextOrder(target)

    local column = hud.colOf[parent] or (hud.cols[parent] and target)

    if column then
        hud.weight[column] = (hud.weight[column] or 0) + height + 4
    end

    return b
end

-- Option lists: a segmented bar under the name. The chosen option is white.
local function segmented(parent, titleText, options, initial, onSelect)
    local row = newRow(parent, 48, false)

    label(
        row, titleText,
        UDim2.fromOffset(4, 1), UDim2.new(1, -8, 0, 17),
        11, UI.text, false
    ).Font = Enum.Font.GothamMedium

    local count = #options

    local holder = Instance.new("Frame")
    holder.Position = UDim2.fromOffset(4, 22)
    holder.Size = UDim2.new(1, -8, 0, 22)
    holder.BackgroundColor3 = UI.line2
    holder.BorderSizePixel = 0
    holder.Parent = row
    corner(holder, 2)

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 1)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = holder

    local current = initial
    local buttons = {}

    local function paint(b, selected)
        local color = selected and UI.white or UI.surface
        b:SetAttribute("BaseColor", color)
        b:SetAttribute("Locked", selected)
        b.BackgroundColor3 = color
        b.TextColor3 = selected and UI.bg or UI.muted
    end

    local function refresh()
        for name, b in pairs(buttons) do
            paint(b, name == current)
        end
    end

    for i, name in ipairs(options) do
        local b = Instance.new("TextButton")
        b.LayoutOrder = i
        b.Size = UDim2.new(1 / count, -(count - 1) / count, 1, 0)
        b.BackgroundColor3 = UI.surface
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        b.Font = Enum.Font.GothamMedium
        b.TextSize = 12
        b.Text = name
        b.Parent = holder
        buttons[name] = b

        b:SetAttribute("BaseColor", UI.surface)

        b.MouseEnter:Connect(function()
            if b.Parent and not b:GetAttribute("Locked") then
                b.BackgroundColor3 = UI.hover
            end
        end)

        b.MouseLeave:Connect(function()
            if b.Parent then
                local base = b:GetAttribute("BaseColor")
                if typeof(base) == "Color3" then b.BackgroundColor3 = base end
            end
        end)

        connect(b.Activated, function()
            current = name
            refresh()
            onSelect(name)
        end)
    end

    refresh()

    return {
        set = function(value)
            current = value
            refresh()
        end,
    }
end

-- Slider: name and value on one line, a thin bar with a handle under it.
local activeSlider
-- Forward-declared so the menu-scale slider can defer resizing until release.
local menuScaleSlider

local function createSlider(parent, titleText, subText, minV, maxV, startV, onChange)
    local obj = {}
    local value = math.clamp(startV, minV, maxV)

    local row = newRow(parent, 36, false)

    label(
        row, titleText,
        UDim2.fromOffset(4, 2), UDim2.new(1, -70, 0, 14),
        11, UI.text, false
    ).Font = Enum.Font.GothamMedium

    local valueLabel = label(
        row, tostring(value),
        UDim2.new(1, -4, 0, 2), UDim2.fromOffset(64, 14),
        11, UI.white, true
    )
    valueLabel.AnchorPoint = Vector2.new(1, 0)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Font = speedFont

    local track = Instance.new("TextButton")
    track.Name = (titleText:gsub("%s+", "")) .. "Slider"
    track.Position = UDim2.fromOffset(4, 20)
    track.Size = UDim2.new(1, -8, 0, 14)
    track.BackgroundTransparency = 1
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = row

    local bar = Instance.new("Frame")
    bar.AnchorPoint = Vector2.new(0, 0.5)
    bar.Position = UDim2.new(0, 0, 0.5, 0)
    bar.Size = UDim2.new(1, 0, 0, 4)
    bar.BackgroundColor3 = UI.surface
    bar.BorderSizePixel = 0
    bar.Parent = track
    corner(bar, 1)
    stroke(bar, UI.line, 1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = UI.signal
    fill.BorderSizePixel = 0
    fill.Parent = bar
    corner(fill, 1)

    local handle = Instance.new("Frame")
    handle.AnchorPoint = Vector2.new(0.5, 0.5)
    handle.Position = UDim2.new(0, 0, 0.5, 0)
    handle.Size = UDim2.fromOffset(5, 12)
    handle.BackgroundColor3 = UI.white
    handle.BorderSizePixel = 0
    handle.Parent = track
    corner(handle, 1)
    stroke(handle, UI.bg, 1, 0)

    local function render()
        local alpha = (value - minV) / (maxV - minV)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        handle.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
    end

    function obj.set(v)
        value = math.clamp(math.floor(v + 0.5), minV, maxV)
        render()
        if onChange then onChange(value) end
    end

    function obj.get()
        return value
    end

    function obj.setFromX(x)
        local width = math.max(track.AbsoluteSize.X, 1)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        obj.set(minV + alpha * (maxV - minV))
    end

    connect(track.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = obj
            lockScroll(true)
            obj.setFromX(input.Position.X)
        end
    end)

    hud.attachTip(row, subText)

    render()
    return obj
end

--==============================================================
-- NOTIFICATIONS
--==============================================================
-- Stacked bottom right. Each one slides in with a small overshoot, types its
-- message out, and has a line along the bottom that runs down with its
-- timer. Green-ish states do not exist here: "on" is white, "off" is grey.

local notify
local notificationsEnabled = true

do
    local notifications = {}
    local TOAST_W, TOAST_H, TOAST_GAP = 272, 46, 6
    local DURATION = 3

    -- Toasts sit above the touch controls on touch devices.
    local function toastOffset(index)
        local base = UIS.TouchEnabled and 150 or 18
        return -base - ((index - 1) * (TOAST_H + TOAST_GAP))
    end

    local function slideInfo()
        return TweenInfo.new(esp.performance.tweenTime(0.34), Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end
    local function shiftInfo()
        return TweenInfo.new(esp.performance.tweenTime(0.22), Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    end
    local function leaveInfo()
        return TweenInfo.new(esp.performance.tweenTime(0.22), Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    end

    notify = function(message, good)
        if not notificationsEnabled then return end
        if destroyed or not gui.Parent then return end

        -- The same message twice within a moment is shown once.
        for _, item in ipairs(notifications) do
            if item.Parent and item:GetAttribute("msg") == message
                and os.clock() - (item:GetAttribute("at") or 0) < 1 then
                return
            end
        end

        -- At most four at a time: the oldest makes room.
        if #notifications >= 4 then
            local oldest = table.remove(notifications, 1)
            if oldest and oldest.Parent then oldest:Destroy() end

            for i, item in ipairs(notifications) do
                if item.Parent then
                    item.Position = UDim2.new(1, -18, 1, toastOffset(i))
                end
            end
        end

        local index = #notifications + 1
        local tone = good and UI.white or UI.muted

        local toast = Instance.new("Frame")
        toast.AnchorPoint = Vector2.new(1, 1)
        toast.Position = UDim2.new(1, TOAST_W + 40, 1, toastOffset(index))
        toast.Size = UDim2.fromOffset(TOAST_W, TOAST_H)
        toast.BackgroundColor3 = Color3.fromRGB(7, 7, 7)
        toast.BorderSizePixel = 0
        toast.ZIndex = 30
        toast:SetAttribute("msg", message)
        toast:SetAttribute("at", os.clock())
        toast.Parent = gui

        corner(toast, 2)
        stroke(toast, UI.line2, 1, 0)

        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(0, 2, 1, 0)
        bar.BackgroundColor3 = tone
        bar.BorderSizePixel = 0
        bar.ZIndex = 31
        bar.Parent = toast

        -- A filled square for "on", a hollow one for "off".
        local mark = Instance.new("Frame")
        mark.AnchorPoint = Vector2.new(0, 0.5)
        mark.Position = UDim2.new(0, 14, 0.5, -1)
        mark.Size = UDim2.fromOffset(10, 10)
        mark.BackgroundColor3 = tone
        mark.BackgroundTransparency = good and 0 or 1
        mark.BorderSizePixel = 0
        mark.ZIndex = 31
        mark.Parent = toast
        corner(mark, 1)

        if not good then
            stroke(mark, tone, 1.5, 0)
        end

        local header = label(
            toast, "toshi.cc",
            UDim2.fromOffset(36, 6), UDim2.new(1, -90, 0, 10),
            8, UI.muted, true
        )
        header.ZIndex = 31

        local stamp = label(
            toast, os.date("%H:%M:%S"),
            UDim2.new(1, -10, 0, 6), UDim2.fromOffset(60, 10),
            8, UI.muted, false
        )
        stamp.AnchorPoint = Vector2.new(1, 0)
        stamp.TextXAlignment = Enum.TextXAlignment.Right
        stamp.Font = Enum.Font.GothamMedium
        stamp.ZIndex = 31

        local text = label(
            toast, message,
            UDim2.fromOffset(36, 19), UDim2.new(1, -46, 0, 18),
            12, tone, good == true
        )
        text.TextTruncate = Enum.TextTruncate.AtEnd
        text.ZIndex = 31
        text.MaxVisibleGraphemes = 0

        local timer = Instance.new("Frame")
        timer.Position = UDim2.new(0, 2, 1, -2)
        timer.Size = UDim2.new(1, -2, 0, 2)
        timer.BackgroundColor3 = tone
        timer.BackgroundTransparency = 0.35
        timer.BorderSizePixel = 0
        timer.ZIndex = 31
        timer.Parent = toast

        table.insert(notifications, toast)

        TweenService:Create(
            toast, slideInfo(),
            {Position = UDim2.new(1, -18, 1, toastOffset(index))}
        ):Play()

        -- Types the message out.
        local length = utf8.len(message) or #message

        TweenService:Create(
            text,
            TweenInfo.new(esp.performance.tweenTime(math.clamp(length * 0.018, 0.12, 0.5)), Enum.EasingStyle.Linear),
            {MaxVisibleGraphemes = length}
        ):Play()

        TweenService:Create(
            timer,
            TweenInfo.new(DURATION, Enum.EasingStyle.Linear),
            {Size = UDim2.new(0, 0, 0, 2)}
        ):Play()

        task.delay(DURATION, function()
            for i, item in ipairs(notifications) do
                if item == toast then
                    table.remove(notifications, i)
                    break
                end
            end

            if toast.Parent then
                local leave = TweenService:Create(
                    toast, leaveInfo(),
                    {Position = UDim2.new(1, TOAST_W + 40, 1, toast.Position.Y.Offset)}
                )
                leave.Completed:Connect(function()
                    if toast.Parent then toast:Destroy() end
                end)
                leave:Play()
            end

            for i, item in ipairs(notifications) do
                if item.Parent then
                    TweenService:Create(
                        item, shiftInfo(),
                        {Position = UDim2.new(1, -18, 1, toastOffset(i))}
                    ):Play()
                end
            end
        end)
    end
end

