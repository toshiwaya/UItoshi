local tabButtons = {}
local TAB_W, TAB_X0 = 98, 10

do
    local TAB_DEFS = {
        {id = "esp", caption = "ESP"},
        {id = "aim", caption = "Aimbot"},
        {id = "self", caption = "Self"},
        {id = "move", caption = "Movement"},
        {id = "players", caption = "Spectate"},
        {id = "settings", caption = "Settings"},
    }

    local tabBar = Instance.new("Frame")
    tabBar.Name = "Tabs"
    tabBar.Position = UDim2.fromOffset(0, 28)
    tabBar.Size = UDim2.new(1, 0, 0, 28)
    tabBar.BackgroundColor3 = UI.frame
    tabBar.BorderSizePixel = 0
