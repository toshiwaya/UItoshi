--==============================================================
-- ESP
--==============================================================
-- (Each large section below runs inside its own function: a function has its
-- own budget of 200 local variables and the main chunk is close to its limit.)
-- Players and NPCs go through the same pipeline:
--   collect -> filter (alive / distance / team) -> sort by distance ->
--   update cached drawing objects.
--
-- Boxes, labels, tracers, and skeleton segments are drawn in screen space.
-- Skeletons support common R6 and R15 body-part names and use the selected ESP
-- colour. Targets outside the local client's streamed world cannot be drawn.
--
-- A player the game has streamed out of your client has no model here at
-- all. Nothing can be drawn for them until the game loads them in.

do
    local function setupEsp()
        local function makeBoxGui()
            local g = Instance.new("ScreenGui")
            g.Name = "ToshiCCEspBoxes"
            g.ResetOnSpawn = false
            g.IgnoreGuiInset = true
            g.DisplayOrder = 48
            g.Parent = playerGui
            return g
        end

        esp.boxGui = makeBoxGui()

        local MAX_BOXES = 80
        local NEAR = 0.3
        local SKELETON_EDGES = {
            -- R15 spine and arms
            {"Head", "UpperTorso"},
            {"UpperTorso", "LowerTorso"},
            {"UpperTorso", "LeftUpperArm"},
            {"LeftUpperArm", "LeftLowerArm"},
            {"LeftLowerArm", "LeftHand"},
            {"UpperTorso", "RightUpperArm"},
            {"RightUpperArm", "RightLowerArm"},
            {"RightLowerArm", "RightHand"},
            -- R15 legs
            {"LowerTorso", "LeftUpperLeg"},
            {"LeftUpperLeg", "LeftLowerLeg"},
            {"LeftLowerLeg", "LeftFoot"},
            {"LowerTorso", "RightUpperLeg"},
            {"RightUpperLeg", "RightLowerLeg"},
            {"RightLowerLeg", "RightFoot"},
            {"LowerTorso", "HumanoidRootPart"},
            -- R6 alternatives (only drawn when those parts exist)
            {"Head", "Torso"},
            {"Torso", "HumanoidRootPart"},
            {"Torso", "Left Arm"},
            {"Torso", "Right Arm"},
            {"Torso", "Left Leg"},
            {"Torso", "Right Leg"},
        }

        local function makeSkeletonLine(parent, index)
            local shadow = Instance.new("Frame")
            shadow.Name = "SkeletonOutline_" .. index
            shadow.AnchorPoint = Vector2.new(0.5, 0.5)
            shadow.Size = UDim2.fromOffset(0, 2)
            shadow.BackgroundColor3 = Color3.new(0, 0, 0)
            shadow.BackgroundTransparency = 0.42
            shadow.BorderSizePixel = 0
            shadow.Visible = false
            shadow.ZIndex = 4
            shadow.Parent = parent

            local line = Instance.new("Frame")
            line.Name = "SkeletonLine_" .. index
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.Size = UDim2.fromOffset(0, 1)
            line.BackgroundColor3 = esp.color
            line.BorderSizePixel = 0
            line.Visible = false
            line.ZIndex = 5
            line.Parent = parent

            return {outline = shadow, line = line}
        end

        local function hideSkeletonLines(obj)
            for _, segment in ipairs(obj.skeletonLines or {}) do
                segment.outline.Visible = false
                segment.line.Visible = false
            end
        end

        local function positionSkeletonLine(segment, a, b, color, enabled)
            local dx, dy = b.X - a.X, b.Y - a.Y
            local length = math.sqrt(dx * dx + dy * dy)
            if not enabled or length < 1 or length > 4000 then
                segment.outline.Visible = false
                segment.line.Visible = false
                return
            end

            local position = UDim2.fromOffset((a.X + b.X) * 0.5, (a.Y + b.Y) * 0.5)
            local outlineSize = UDim2.fromOffset(length, 2)
            local lineSize = UDim2.fromOffset(length, 1)
            local rotation = math.deg(math.atan2(dy, dx))

            segment.outline.Position = position
            segment.outline.Size = outlineSize
            segment.outline.Rotation = rotation
            segment.outline.Visible = true

            segment.line.Position = position
            segment.line.Size = lineSize
            segment.line.Rotation = rotation
            if segment.line.BackgroundColor3 ~= color then
                segment.line.BackgroundColor3 = color
            end
            segment.line.Visible = true
        end

        local function drawSkeleton(obj, model, camera, viewport)
            local shouldDraw = esp.skeleton and model.Parent ~= nil and camera ~= nil
            local color = obj.skeletonColor or esp.color

            for i, edge in ipairs(SKELETON_EDGES) do
                local segment = obj.skeletonLines[i]

                if shouldDraw then
                    if not segment then
                        segment = makeSkeletonLine(esp.boxGui, i)
                        obj.skeletonLines[i] = segment
                    end

                    local a = model:FindFirstChild(edge[1], true)
                    local b = model:FindFirstChild(edge[2], true)

                    if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
                        local pa = camera:WorldToViewportPoint(a.Position)
                        local pb = camera:WorldToViewportPoint(b.Position)
                        local inReasonableRange =
                            pa.X >= -viewport.X and pa.X <= viewport.X * 2
                            and pa.Y >= -viewport.Y and pa.Y <= viewport.Y * 2
                            and pb.X >= -viewport.X and pb.X <= viewport.X * 2
                            and pb.Y >= -viewport.Y and pb.Y <= viewport.Y * 2
                        local inFront = pa.Z > NEAR and pb.Z > NEAR

                        positionSkeletonLine(
                            segment,
                            Vector2.new(pa.X, pa.Y), Vector2.new(pb.X, pb.Y),
                            color,
                            inFront and inReasonableRange
                        )
                    else
                        segment.outline.Visible = false
                        segment.line.Visible = false
                    end
                elseif segment then
                    segment.outline.Visible = false
                    segment.line.Visible = false
                end
            end
        end
        local scratch = {}
        local visible = {}
        local seen = {}
        local HEALTH_LOW = Color3.fromRGB(255, 70, 70)
        local HEALTH_HIGH = Color3.fromRGB(90, 255, 130)
        local FRIEND_COLOR = Color3.fromRGB(90, 235, 130)
        local FOE_COLOR = Color3.fromRGB(255, 80, 80)

        local function destroyObject(obj)
            if obj.holder then obj.holder:Destroy() end
            if obj.tracer then obj.tracer:Destroy() end
            for _, segment in ipairs(obj.skeletonLines or {}) do
                segment.outline:Destroy()
                segment.line:Destroy()
            end
        end

        local function hideObject(obj)
            obj.holder.Visible = false
            obj.tracer.Visible = false
            hideSkeletonLines(obj)
        end

        function esp.clear()
            for _, obj in pairs(esp.objects) do
                destroyObject(obj)
            end

            table.clear(esp.objects)
        end

        -- Some games wipe unknown folders; rebuild ours if that happens.
        local function ensureFolders()
            local boxOk = esp.boxGui and esp.boxGui.Parent == playerGui
            if boxOk then return end

            esp.clear()
            if esp.boxGui then esp.boxGui:Destroy() end
            esp.boxGui = makeBoxGui()
        end

        local function makeText(parent, size, bold)
            local t = Instance.new("TextLabel")
            t.BackgroundTransparency = 1
            t.Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium
            t.TextSize = size
            t.TextColor3 = UI.white
            t.TextStrokeTransparency = 0.35
            t.TextStrokeColor3 = Color3.new(0, 0, 0)
            t.Text = ""
            t.Visible = false
            t.Parent = parent
            return t
        end

        -- The drawn parts of one marker: box outline, corner bars, health bar,
        -- name and info line. `parent` is a frame the size of the box. The same
        -- builder feeds the live preview in the menu, so what you see there is
        -- exactly what is drawn in the game.
        local function buildPieces(parent)
            local p = {}

            local outline = Instance.new("Frame")
            outline.Name = "Outline"
            outline.Size = UDim2.fromScale(1, 1)
            outline.BackgroundColor3 = esp.color
            outline.BackgroundTransparency = 1
            outline.BorderSizePixel = 0
            outline.Parent = parent

            local outlineStroke = Instance.new("UIStroke")
            outlineStroke.Thickness = 1.5
            outlineStroke.Color = esp.color
            outlineStroke.Parent = outline

            -- Corner style: eight short bars, sized in scale so they follow the
            -- box without any per-frame work.
            local corners = {}

            for _, ax in ipairs({0, 1}) do
                for _, ay in ipairs({0, 1}) do
                    for _, horizontal in ipairs({true, false}) do
                        local bar = Instance.new("Frame")
                        bar.AnchorPoint = Vector2.new(ax, ay)
                        bar.Position = UDim2.fromScale(ax, ay)
                        bar.Size = horizontal
                            and UDim2.new(0.3, 0, 0, 2)
                            or UDim2.new(0, 2, 0.22, 0)
                        bar.BackgroundColor3 = esp.color
                        bar.BorderSizePixel = 0
                        bar.Visible = false
                        bar.Parent = parent
                        corners[#corners + 1] = bar
                    end
                end
            end

            local barBack = Instance.new("Frame")
            barBack.Name = "HealthBack"
            barBack.AnchorPoint = Vector2.new(1, 0)
            barBack.Position = UDim2.new(0, -4, 0, 0)
            barBack.Size = UDim2.new(0, 3, 1, 0)
            barBack.BackgroundColor3 = Color3.new(0, 0, 0)
            barBack.BackgroundTransparency = 0.35
            barBack.BorderSizePixel = 0
            barBack.Visible = false
            barBack.Parent = parent

            local barFill = Instance.new("Frame")
            barFill.Name = "HealthFill"
            barFill.AnchorPoint = Vector2.new(0, 1)
            barFill.Position = UDim2.fromScale(0, 1)
            barFill.Size = UDim2.fromScale(1, 1)
            barFill.BackgroundColor3 = HEALTH_HIGH
            barFill.BorderSizePixel = 0
            barFill.Parent = barBack

            local nameLabel = makeText(parent, 12, true)
            nameLabel.AnchorPoint = Vector2.new(0.5, 1)
            nameLabel.Position = UDim2.new(0.5, 0, 0, -3)
            nameLabel.Size = UDim2.fromOffset(220, 14)
            nameLabel.TextYAlignment = Enum.TextYAlignment.Bottom

            local infoLabel = makeText(parent, 11, false)
            infoLabel.AnchorPoint = Vector2.new(0.5, 0)
            infoLabel.Position = UDim2.new(0.5, 0, 1, 3)
            infoLabel.Size = UDim2.fromOffset(220, 12)
            infoLabel.TextYAlignment = Enum.TextYAlignment.Top

            p.outline = outline
            p.outlineStroke = outlineStroke
            p.corners = corners
            p.barBack = barBack
            p.barFill = barFill
            p.nameLabel = nameLabel
            p.infoLabel = infoLabel

            return p
        end

        local function infoString(dist, hp)
            local info = {}

            if esp.distance then
                info[#info + 1] = string.format("%d studs", math.floor(dist + 0.5))
            end

            if esp.health and hp then
                info[#info + 1] = string.format("%d HP", math.floor(hp + 0.5))
            end

            return table.concat(info, "  |  ")
        end

        -- Applies the current ESP settings to one marker.
        local function stylePieces(p, color, fraction, hasHealth, nameText, infoText)
            local fullBox = esp.boxes and esp.boxStyle ~= "Corner"
            local cornerBox = esp.boxes and esp.boxStyle == "Corner"

            p.outlineStroke.Enabled = fullBox
            if p.outlineStroke.Color ~= color then p.outlineStroke.Color = color end
            if p.outline.BackgroundColor3 ~= color then p.outline.BackgroundColor3 = color end
            p.outline.BackgroundTransparency = (esp.boxes and esp.boxFill) and 0.86 or 1

            for _, bar in ipairs(p.corners) do
                bar.Visible = cornerBox
                if bar.BackgroundColor3 ~= color then bar.BackgroundColor3 = color end
            end

            p.barBack.Visible = esp.healthBar and hasHealth
            p.barFill.Size = UDim2.fromScale(1, fraction)
            p.barFill.BackgroundColor3 = HEALTH_LOW:Lerp(HEALTH_HIGH, fraction)

            p.nameLabel.Visible = esp.names
            if p.nameLabel.Text ~= nameText then p.nameLabel.Text = nameText end
            if p.nameLabel.TextColor3 ~= color then p.nameLabel.TextColor3 = color end

            p.infoLabel.Visible = infoText ~= ""
            if p.infoLabel.Text ~= infoText then p.infoLabel.Text = infoText end
        end

        -- The colour a target is drawn in, and whether it came from real team
        -- data. When the game exposes no team information for a target, the
        -- marker colour is used instead.
        local function targetColor(t)
            if esp.rainbow then
                return esp.rainbowColor, true
            end

            local mode = esp.colorMode

            if mode == "Single" then
                return esp.color, true
            end

            local plr, model = t.plr, t.model

            if mode == "Team" then
                local c

                if plr then
                    c = Targets.teamColorOf(plr)
                else
                    c = Targets.npcTeamColor(model)
                end

                if c then return c, true end
                return esp.color, false
            end

            -- Friend / foe
            local relation

            if plr then
                relation = Targets.teamRelation(plr)
            else
                relation = Targets.npcRelation(model)
            end

            if relation == true then return FRIEND_COLOR, true end
            if relation == false then return FOE_COLOR, true end
            return esp.color, false
        end

        local function getObject(model, isPlayer)
            local obj = esp.objects[model]

            if obj and obj.holder.Parent and obj.tracer.Parent then
                return obj
            end

            if obj then
                destroyObject(obj)
                esp.objects[model] = nil
            end

            -- Everything for one target lives in `holder`, which is moved and
            -- sized to the target's on-screen box every frame.
            local holder = Instance.new("Frame")
            holder.Name = "ToshiCC_Target"
            holder.BackgroundTransparency = 1
            holder.BorderSizePixel = 0
            holder.Visible = false
            holder.Parent = esp.boxGui

            local tracer = Instance.new("Frame")
            tracer.Name = "ToshiCC_Tracer"
            tracer.AnchorPoint = Vector2.new(0.5, 0.5)
            tracer.BackgroundColor3 = esp.color
            tracer.BorderSizePixel = 0
            tracer.Visible = false
            tracer.Parent = esp.boxGui

            local skeletonLines = {}

            obj = buildPieces(holder)
            obj.holder = holder
            obj.tracer = tracer
            obj.skeletonLines = skeletonLines
            obj.skeletonColor = esp.color
            obj.wantTracer = false
            obj.isPlayer = isPlayer

            esp.objects[model] = obj
            return obj
        end

        -- Decides whether a target is shown and caches what render needs.
        local function measure(t, origin)
            local model, hum = t.model, t.hum

            if not model.Parent or not Targets.isAlive(hum, t.plr ~= nil, model) then
                return false
            end

            local head = model:FindFirstChild("Head")
            if head and not head:IsA("BasePart") then head = nil end

            local rootPart = Targets.rootOf(model, hum)
            local anchor = head or rootPart
            if not anchor then return false end

            local dist = (anchor.Position - origin).Magnitude
            t.dist = dist

            if dist ~= dist or dist > esp.maxDist then return false end

            if not esp.showTeam then
                if t.plr then
                    if Targets.sameTeam(t.plr) then return false end
                elseif Targets.sameTeamNpc(model) then
                    return false
                end
            end

            -- Distance from the root part's centre down to the feet.
            local drop = 3

            if rootPart then
                if hum and hum.RigType == Enum.HumanoidRigType.R15 then
                    drop = hum.HipHeight + rootPart.Size.Y * 0.5
                else
                    drop = rootPart.Size.Y * 1.5
                end
            end

            t.head = head
            t.root = rootPart
            t.drop = math.clamp(drop, 1.5, 14)
            return true
        end

        -- Everything that does not have to move every frame (colours, text,
        -- health, which pieces are on). Runs at the ESP refresh rate.
        local function renderTarget(t, rank)
            local model, hum, plr = t.model, t.hum, t.plr
            local obj = getObject(model, plr ~= nil)

            local color, known = targetColor(t)
            if not known then esp.noTeamData += 1 end

            -- Skeletons use the same resolved colour as the other ESP markers.
            obj.skeletonColor = color

            local hasHealth = hum ~= nil and hum.MaxHealth > 0
            local fraction = 1

            if hasHealth then
                fraction = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            end

            stylePieces(
                obj, color, fraction, hasHealth,
                plr and plr.DisplayName or model.Name,
                infoString(t.dist, hasHealth and hum.Health or nil)
            )

            obj.wantTracer = esp.tracers
            if obj.tracer.BackgroundColor3 ~= color then obj.tracer.BackgroundColor3 = color end
        end

        function esp.update()
            if destroyed then return end

            local wantPlayers, wantNpcs = esp.on, esp.npcs

            if not wantPlayers and not wantNpcs then
                table.clear(visible)

                if next(esp.objects) ~= nil then
                    esp.clear()
                end

                esp.found, esp.shown, esp.notLoaded, esp.noTeamData = 0, 0, 0, 0
                return
            end

            ensureFolders()

            -- Some games switch every ScreenGui off in certain phases.
            if not esp.boxGui.Enabled then esp.boxGui.Enabled = true end

            local camera = workspace.CurrentCamera
            local origin = localOrigin(camera)
            local list = Targets.collect(scratch, wantPlayers, wantNpcs, camera)

            -- Players with no model on this client at all (streamed out, or the
            -- game never sent them). Nothing a script can draw.
            if wantPlayers then
                local loaded = 0

                for _, t in ipairs(list) do
                    if t.plr then loaded += 1 end
                end

                esp.notLoaded = math.max(#Players:GetPlayers() - 1 - loaded, 0)
            else
                esp.notLoaded = 0
            end

            -- Every target is measured on its own, so one broken model can
            -- never stop the rest from getting ESP.
            table.clear(visible)

            for _, t in ipairs(list) do
                local ok, keep = pcall(measure, t, origin)

                if ok and keep then
                    visible[#visible + 1] = t
                end
            end

            table.sort(visible, function(a, b)
                return a.dist < b.dist
            end)

            table.clear(seen)
            esp.noTeamData = 0

            for i, t in ipairs(visible) do
                seen[t.model] = true

                local ok, err = pcall(renderTarget, t, i)
                if not ok then warnOnce("ESP target", err) end
            end

            -- Hide anything not shown this pass; destroy records for models that
            -- left the game or whose category (players / NPCs) was switched off.
            for model, obj in pairs(esp.objects) do
                if not seen[model] then
                    hideObject(obj)

                    if not model:IsDescendantOf(workspace)
                        or (obj.isPlayer and not wantPlayers)
                        or (not obj.isPlayer and not wantNpcs) then
                        destroyObject(obj)
                        esp.objects[model] = nil
                    end
                end
            end

            esp.found, esp.shown = #list, #visible
        end

        -- Screen boxes -----------------------------------------------
        -- Positioned every frame (after the aim lock moved the camera) from the
        -- list of the last ESP pass.
        local UNIT_CORNERS = {}

        for _, sx in ipairs({-1, 1}) do
            for _, sy in ipairs({-1, 1}) do
                for _, sz in ipairs({-1, 1}) do
                    UNIT_CORNERS[#UNIT_CORNERS + 1] = Vector3.new(sx, sy, sz)
                end
            end
        end

        -- Bounds are cached per target and refreshed about once a second.
        local function refreshBounds(obj, model)
            local now = os.clock()
            if obj.size and now - obj.sizeAt < 1 then return true end

            local ok, cf, size = pcall(model.GetBoundingBox, model)
            if not ok or not size then return obj.size ~= nil end

            obj.size = Vector3.new(
                math.min(size.X, 16),
                math.min(size.Y, 16),
                math.min(size.Z, 16)
            ) * 0.5
            obj.offset = model:GetPivot():PointToObjectSpace(cf.Position)
            obj.sizeAt = now
            return true
        end

        -- Moves `point` along the segment toward `other` until it is in front of
        -- the camera. Returns nil when both ends are behind it.
        local function clipNear(point, other, camPos, look)
            local d = (point - camPos):Dot(look)
            if d >= NEAR then return point end

            local dOther = (other - camPos):Dot(look)
            if dOther <= NEAR then return nil end

            return point:Lerp(other, (NEAR - d) / (dOther - d))
        end

        -- Character box from head and feet. Returns minX, minY, maxX, maxY.
        local function characterRect(camera, camPos, look, t)
            local head, rootPart = t.head, t.root

            if not head or not rootPart or not head.Parent or not rootPart.Parent then
                return nil
            end

            local topWorld = head.Position + Vector3.new(0, head.Size.Y * 0.5 + 0.15, 0)
            local bottomWorld = rootPart.Position - Vector3.new(0, t.drop, 0)

            local top = clipNear(topWorld, bottomWorld, camPos, look)
            if not top then return nil end

            local bottom = clipNear(bottomWorld, topWorld, camPos, look)
            if not bottom then return nil end

            local a = camera:WorldToViewportPoint(top)
            local b = camera:WorldToViewportPoint(bottom)

            local h = math.max(math.abs(b.Y - a.Y), 6)
            local w = h * 0.55
            local cx = (a.X + b.X) / 2
            local cy = (a.Y + b.Y) / 2

            return cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2
        end

        -- Fallback for models without head + root: the model's bounding box.
        local function boundsRect(camera, camPos, look, obj, model)
            if not refreshBounds(obj, model) then return nil end

            local center = model:GetPivot():PointToWorldSpace(obj.offset)
            local centerDepth = (center - camPos):Dot(look)
            if centerDepth <= NEAR then return nil end

            local minX, minY = math.huge, math.huge
            local maxX, maxY = -math.huge, -math.huge

            for _, unit in ipairs(UNIT_CORNERS) do
                local point = clipNear(center + obj.size * unit, center, camPos, look)

                if point then
                    local p = camera:WorldToViewportPoint(point)

                    if p.X < minX then minX = p.X end
                    if p.X > maxX then maxX = p.X end
                    if p.Y < minY then minY = p.Y end
                    if p.Y > maxY then maxY = p.Y end
                end
            end

            if minX == math.huge then return nil end

            return minX, minY, maxX, maxY
        end

        local function drawBoxes()
            if destroyed then return end
            if #visible == 0 then return end

            -- Potato Mode must not hide targets or reduce skeleton coverage.
            local drawLimit = MAX_BOXES
            local camera = workspace.CurrentCamera
            local enabled = camera ~= nil
            local camPos, look, vp

            if enabled then
                camPos = camera.CFrame.Position
                look = camera.CFrame.LookVector
                vp = camera.ViewportSize
            end

            for i = 1, #visible do
                local t = visible[i]
                local obj = esp.objects[t.model]

                if obj and obj.holder.Parent then
                    local drawn = false
                    local tracerOn = false

                    if enabled and i <= drawLimit and t.model.Parent then
                        drawSkeleton(obj, t.model, camera, vp)
                    else
                        hideSkeletonLines(obj)
                    end

                    if enabled and i <= drawLimit and t.model.Parent then
                        local minX, minY, maxX, maxY =
                            characterRect(camera, camPos, look, t)

                        if not minX then
                            minX, minY, maxX, maxY =
                                boundsRect(camera, camPos, look, obj, t.model)
                        end

                        if minX then
                            minX = math.clamp(minX, -4000, 8000)
                            maxX = math.clamp(maxX, -4000, 8000)
                            minY = math.clamp(minY, -4000, 8000)
                            maxY = math.clamp(maxY, -4000, 8000)

                            if maxX >= 0 and minX <= vp.X
                                and maxY >= 0 and minY <= vp.Y then
                                local w = math.max(maxX - minX, 4)
                                local h = math.max(maxY - minY, 4)

                                obj.holder.Position = UDim2.fromOffset(
                                    math.floor(minX + 0.5), math.floor(minY + 0.5)
                                )
                                obj.holder.Size = UDim2.fromOffset(
                                    math.floor(w + 0.5), math.floor(h + 0.5)
                                )
                                drawn = true

                                if obj.wantTracer then
                                    local fromX, fromY = vp.X * 0.5, vp.Y
                                    local toX, toY = (minX + maxX) * 0.5, maxY
                                    local dx, dy = toX - fromX, toY - fromY

                                    obj.tracer.Position = UDim2.fromOffset(
                                        (fromX + toX) * 0.5, (fromY + toY) * 0.5
                                    )
                                    obj.tracer.Size = UDim2.fromOffset(
                                        math.sqrt(dx * dx + dy * dy), 1.5
                                    )
                                    obj.tracer.Rotation = math.deg(math.atan2(dy, dx))
                                    tracerOn = true
                                end
                            end
                        end
                    end

                    if obj.holder.Visible ~= drawn then obj.holder.Visible = drawn end
                    if obj.tracer.Visible ~= tracerOn then obj.tracer.Visible = tracerOn end
                end
            end
        end

        RunService:BindToRenderStep(
            BOX_BIND_NAME,
            Enum.RenderPriority.Last.Value + 1,
            function()
                -- Render markers/skeletons every frame in both modes so Potato
                -- Mode never introduces visible stutter in the ESP overlay.
                local ok, err = pcall(drawBoxes)
                if not ok then warnOnce("ESP boxes", err) end
            end
        )

        local function safeUpdate()
            local ok, err = pcall(esp.update)
            if not ok then warnOnce("ESP", err) end
        end

        esp.safeUpdate = safeUpdate

        -- UI ------------------------------------------------------

        local rows = {}
        local preview = {}
        local boxStyleControl, colorModeControl, distSlider, colorPickerControl
        local refreshColors

        -- Called by every control: refreshes the game overlay and the preview.
        local function changed()
            safeUpdate()

            local ok, err = pcall(esp.refreshPreview)
            if not ok then warnOnce("ESP preview", err) end
        end

        -- Side panel ------------------------------------------------
        -- Stays in view while the settings scroll. It shows YOUR character
        -- (a grey copy, seen from the front) with the real ESP marker drawn
        -- on it by the same code as the game overlay, plus status notes: how
        -- many targets are tracked, players the game has streamed out of
        -- range, and missing team information.
        do
            local body = hud.newDock("esp", "Preview")
            local W, H = hud.dockW - 20, 270

            local pv = hud.makePreview(body, W, H, 0)
            hud.previews.esp = pv
            preview.pv = pv

            local holder = Instance.new("Frame")
            holder.Name = "Marker"
            holder.BackgroundTransparency = 1
            holder.BorderSizePixel = 0
            holder.Parent = pv.overlay

            preview.pieces = buildPieces(holder)

            local tracer = Instance.new("Frame")
            tracer.AnchorPoint = Vector2.new(0.5, 0.5)
            tracer.BorderSizePixel = 0
            tracer.Visible = false
            tracer.Parent = pv.overlay
            preview.tracer = tracer
            preview.skeletonLines = {}
            for i = 1, #SKELETON_EDGES do
                preview.skeletonLines[i] = makeSkeletonLine(pv.overlay, i)
            end
            preview.skeletonColor = esp.color

            -- Fits the marker around the character after every rebuild.
            function pv.onBuilt()
                local top = pv.project(pv.points.top)
                local bottom = pv.project(pv.points.bottom)
                local height = math.max(bottom.Y - top.Y, 20)
                local width = height * 0.55

                holder.Position = UDim2.fromOffset(
                    math.floor(top.X - width / 2 + 0.5), math.floor(top.Y + 0.5)
                )
                holder.Size = UDim2.fromOffset(
                    math.floor(width + 0.5), math.floor(height + 0.5)
                )

                local fromX, fromY = W / 2, H
                local dx, dy = top.X - fromX, bottom.Y - fromY

                tracer.Position = UDim2.fromOffset((fromX + top.X) / 2, (fromY + bottom.Y) / 2)
                tracer.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1.5)
                tracer.Rotation = math.deg(math.atan2(dy, dx))

                -- A rebuilt figure is grey again: restyle it.
                if esp.refreshPreview then esp.refreshPreview() end
            end

            -- Notes under the preview.
            local notes = Instance.new("Frame")
            notes.Position = UDim2.fromOffset(0, H + 8)
            notes.Size = UDim2.new(1, 0, 1, -(H + 8))
            notes.BackgroundTransparency = 1
            notes.BorderSizePixel = 0
            notes.Parent = body

            local notesLayout = Instance.new("UIListLayout")
            notesLayout.Padding = UDim.new(0, 5)
            notesLayout.SortOrder = Enum.SortOrder.LayoutOrder
            notesLayout.Parent = notes

            local function note(order, height, color, bold)
                local l = label(
                    notes, "",
                    UDim2.new(), UDim2.new(1, 0, 0, height),
                    10, color, bold
                )
                l.TextWrapped = true
                l.TextYAlignment = Enum.TextYAlignment.Top
                l.LayoutOrder = order
                return l
            end

            esp.statusText = note(1, 14, UI.white, true)
            esp.statusText.Text = "ESP is off"

            -- Shown only when the game streams the map and some players are
            -- out of range. Filled in by the stats loop.
            esp.infoLabel = note(2, 40, UI.accent, false)
            esp.infoLabel.Visible = false
            esp.infoRow = esp.infoLabel

            -- Appears only when Team / Friend-foe colours are selected but
            -- the game exposes no team information for some targets.
            esp.teamNote = note(3, 40, UI.accent, false)
            esp.teamNote.Visible = false
        end

        function esp.refreshPreview()
            if not preview.pieces then return end

            local color

            if esp.rainbow then
                color = esp.rainbowColor
            elseif esp.colorMode == "Team" then
                color = Color3.fromRGB(80, 160, 255)
            elseif esp.colorMode == "Friend/foe" then
                color = FOE_COLOR
            else
                color = esp.color
            end

            stylePieces(
                preview.pieces, color, 0.72, true,
