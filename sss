-- Settings > Performance. Potato Mode is session-only and ALWAYS starts OFF.
-- When enabled, it simplifies local scene visuals but intentionally leaves ESP
-- scan frequency, target limits, and per-frame drawing at their normal cadence.
-- Every changed property is saved once and restored to its original value on OFF.
local potatoLighting = game:GetService("Lighting")
local potatoOriginals = setmetatable({}, {__mode = "k"})
local potatoWorldConnections = {}
local potatoGeneration = 0

esp.performance = {
    potatoMode = false,
    statsInterval = 0.35,
    activeDotPulse = nil,
}

local function potatoRememberAndSet(inst, property, value)
    local ok, current = pcall(function()
        return inst[property]
    end)
    if not ok then return end

    local saved = potatoOriginals[inst]
    if not saved then
        saved = {}
        potatoOriginals[inst] = saved
    end

    -- Do not overwrite the true original when the object is encountered again.
    if saved[property] == nil then
        saved[property] = current
    end

    pcall(function()
        inst[property] = value
    end)
end

local function potatoSimplifyInstance(inst)
    if not esp.performance.potatoMode then return end

    if inst:IsA("BasePart") then
        potatoRememberAndSet(inst, "CastShadow", false)
        potatoRememberAndSet(inst, "Reflectance", 0)
        potatoRememberAndSet(inst, "Material", Enum.Material.Plastic)
        if inst:IsA("MeshPart") then
            potatoRememberAndSet(inst, "RenderFidelity", Enum.RenderFidelity.Performance)
            potatoRememberAndSet(inst, "TextureID", "")
        end
    elseif inst:IsA("SpecialMesh") then
        potatoRememberAndSet(inst, "TextureId", "")
    elseif inst:IsA("Decal") or inst:IsA("Texture") then
        potatoRememberAndSet(inst, "Transparency", 1)
    elseif inst:IsA("SurfaceAppearance") then
        potatoRememberAndSet(inst, "ColorMap", "")
        potatoRememberAndSet(inst, "MetalnessMap", "")
        potatoRememberAndSet(inst, "NormalMap", "")
        potatoRememberAndSet(inst, "RoughnessMap", "")
    elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
        or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles")
        or inst:IsA("Light") or inst:IsA("PostEffect") then
        potatoRememberAndSet(inst, "Enabled", false)
    elseif inst:IsA("Lighting") then
        potatoRememberAndSet(inst, "GlobalShadows", false)
        potatoRememberAndSet(inst, "EnvironmentDiffuseScale", 0)
        potatoRememberAndSet(inst, "EnvironmentSpecularScale", 0)
    elseif inst:IsA("Atmosphere") then
        potatoRememberAndSet(inst, "Density", 0)
        potatoRememberAndSet(inst, "Haze", 0)
        potatoRememberAndSet(inst, "Glare", 0)
    elseif inst:IsA("Clouds") then
        potatoRememberAndSet(inst, "Cover", 0)
        potatoRememberAndSet(inst, "Density", 0)
    elseif inst:IsA("Terrain") then
        potatoRememberAndSet(inst, "Decoration", false)
    elseif inst:IsA("Sky") then
        potatoRememberAndSet(inst, "CelestialBodiesShown", false)
        potatoRememberAndSet(inst, "StarCount", 0)
    end
end

local function potatoRestoreVisuals()
    for inst, properties in pairs(potatoOriginals) do
        -- Restore even if the instance is temporarily unparented; destroyed
        -- instances simply reject the write inside pcall and can be ignored.
        for property, value in pairs(properties) do
            pcall(function()
                inst[property] = value
            end)
        end
        potatoOriginals[inst] = nil
    end
end

local function potatoDisconnectWorldWatchers()
    for _, connection in ipairs(potatoWorldConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(potatoWorldConnections)
end

local function potatoEnableWorldWatchers(generation)
    local function onAdded(inst)
        if not esp.performance.potatoMode or generation ~= potatoGeneration then return end
        task.defer(function()
            if esp.performance.potatoMode and generation == potatoGeneration then
                potatoSimplifyInstance(inst)
            end
        end)
    end

    potatoWorldConnections[#potatoWorldConnections + 1] = workspace.DescendantAdded:Connect(onAdded)
    potatoWorldConnections[#potatoWorldConnections + 1] = potatoLighting.DescendantAdded:Connect(onAdded)
end

local function potatoApplyWorldVisuals()
    potatoGeneration += 1
    local generation = potatoGeneration

    potatoDisconnectWorldWatchers()

    if not esp.performance.potatoMode then
        potatoRestoreVisuals()
        return
    end

    potatoEnableWorldWatchers(generation)
    potatoSimplifyInstance(potatoLighting)

    -- Spread large worlds into smaller batches to avoid a toggle-time hitch.
    task.spawn(function()
        local instances = workspace:GetDescendants()
        for _, inst in ipairs(potatoLighting:GetDescendants()) do
            instances[#instances + 1] = inst
        end

        for index, inst in ipairs(instances) do
            if not esp.performance.potatoMode or generation ~= potatoGeneration then
                return
            end
            potatoSimplifyInstance(inst)
            if index % 80 == 0 then task.wait() end
        end
    end)
end

function esp.performance.applyPotatoMode(enabled)
    esp.performance.potatoMode = enabled == true

    -- Keep ESP scan/draw cadence unchanged in both modes. Potato Mode reduces
    -- scene rendering cost instead of making overlays update less frequently.
    esp.interval = 0.05
    esp.performance.statsInterval = esp.performance.potatoMode and 1.2 or 0.35

    potatoApplyWorldVisuals()

    if esp.performance.updatePulse then
        esp.performance.updatePulse()
    end
end

function esp.performance.tweenTime(seconds)
    if esp.performance.potatoMode then
        return math.min(seconds, 0.05)
    end
    return seconds
end

