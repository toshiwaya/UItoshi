    local rule = Instance.new("Frame")
    rule.Position = UDim2.new(0, 0, 1, -1)
    rule.Size = UDim2.new(1, 0, 0, 1)
    rule.BackgroundColor3 = UI.line
    rule.BorderSizePixel = 0
    rule.Parent = tabBar

    -- Small icons built from frames: no image assets, and they take the
    -- tab's colour. Returns a function that recolours the icon.
    local function makeIcon(parent, id)
        local holder = Instance.new("Frame")
        holder.Position = UDim2.fromOffset(12, 8)
        holder.Size = UDim2.fromOffset(12, 12)
        holder.BackgroundTransparency = 1
        holder.BorderSizePixel = 0
        holder.Parent = parent

        local outlines, fills = {}, {}

        local function ring(x, y, w, h, radius)
            local f = Instance.new("Frame")
            f.Position = UDim2.fromOffset(x, y)
            f.Size = UDim2.fromOffset(w, h)
            f.BackgroundTransparency = 1
            f.BorderSizePixel = 0
            f.Parent = holder
            corner(f, radius)
            outlines[#outlines + 1] = stroke(f, UI.muted, 1.5, 0)
        end

        local function block(x, y, w, h, radius)
            local f = Instance.new("Frame")
            f.Position = UDim2.fromOffset(x, y)
            f.Size = UDim2.fromOffset(w, h)
            f.BackgroundColor3 = UI.muted
            f.BorderSizePixel = 0
            f.Parent = holder
            corner(f, radius)
            fills[#fills + 1] = f
        end

        if id == "esp" then
            ring(0, 0, 12, 12, 1)
            block(4, 4, 4, 4, 1)
        elseif id == "aim" then
            ring(1, 1, 10, 10, 5)
            block(5, 5, 2, 2, 1)
            block(5, 0, 2, 3, 0)
            block(5, 9, 2, 3, 0)
            block(0, 5, 3, 2, 0)
            block(9, 5, 3, 2, 0)
        elseif id == "self" then
            block(3, 0, 6, 5, 2)
            block(1, 7, 10, 5, 2)
        elseif id == "move" then
            block(0, 1, 10, 2, 0)
            block(2, 5, 10, 2, 0)
            block(0, 9, 8, 2, 0)
        elseif id == "players" then
            ring(0, 2, 12, 8, 3)
            block(4, 4, 4, 4, 2)
        else
            block(0, 2, 12, 2, 0)
            block(0, 8, 12, 2, 0)
            block(7, 0, 3, 6, 0)
            block(2, 6, 3, 6, 0)
        end

        return function(color)
            for _, s in ipairs(outlines) do s.Color = color end
            for _, f in ipairs(fills) do f.BackgroundColor3 = color end
        end
    end

    -- The line under the chosen tab; selectTab slides it.
    hud.tabLine = Instance.new("Frame")
    hud.tabLine.Name = "TabLine"
    hud.tabLine.Position = UDim2.fromOffset(TAB_X0, 25)
    hud.tabLine.Size = UDim2.fromOffset(TAB_W - 4, 2)
    hud.tabLine.BackgroundColor3 = UI.white
    hud.tabLine.BorderSizePixel = 0
    hud.tabLine.ZIndex = 3
