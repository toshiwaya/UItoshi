local applySelf, restoreSelf

do
    --==============================================================
    -- SELF: WALK SPEED / JUMP POWER / INFINITE JUMP
    --==============================================================
    -- Original values are remembered per-humanoid, so respawning or
    -- turning an override off always puts things back as the game had
    -- them. While an override is on it is re-applied every frame, so
    -- games that reset WalkSpeed or JumpPower cannot undo it.

    local base = {
        walkHum = nil, walk = DEFAULT_WALK,
        jumpHum = nil, jump = DEFAULT_JUMP, useJump = true,
    }

    local function restoreWalk()
        if base.walkHum and base.walkHum.Parent then
            base.walkHum.WalkSpeed = base.walk
        end
        base.walkHum = nil
    end

    local function restoreJump()
        if base.jumpHum and base.jumpHum.Parent then
            pcall(function()
                base.jumpHum.UseJumpPower = base.useJump
                base.jumpHum.JumpPower = base.jump
            end)
        end
        base.jumpHum = nil
    end

    applySelf = function()
        if not humanoid or not humanoid.Parent then return end

        if walkOn then
            if base.walkHum ~= humanoid then
                base.walkHum = humanoid
                base.walk = humanoid.WalkSpeed
            end

            if humanoid.WalkSpeed ~= selfWalk then
                humanoid.WalkSpeed = selfWalk
            end
        end

        if jumpOn then
            if base.jumpHum ~= humanoid then
                base.jumpHum = humanoid
                base.jump = humanoid.JumpPower
                base.useJump = humanoid.UseJumpPower
            end

            pcall(function()
                if not humanoid.UseJumpPower then
                    humanoid.UseJumpPower = true
                end
                if humanoid.JumpPower ~= selfJump then
                    humanoid.JumpPower = selfJump
                end
            end)
        end
    end

    restoreSelf = function()
        restoreWalk()
        restoreJump()
    end

    connect(walkRow.Activated, function()
        walkOn = not walkOn
        setButtonState(walkRow, walkOn)

        if walkOn then
            applySelf()
            notify("Walk speed set to " .. selfWalk, true)
        else
            restoreWalk()
            notify("Walk speed restored", false)
        end
    end)

    connect(jumpRow.Activated, function()
        jumpOn = not jumpOn
        setButtonState(jumpRow, jumpOn)

        if jumpOn then
            applySelf()
            notify("Jump power set to " .. selfJump, true)
        else
            restoreJump()
            notify("Jump power restored", false)
        end
    end)

    connect(infJumpRow.Activated, function()
        infiniteJump = not infiniteJump
        setButtonState(infJumpRow, infiniteJump)
        notify(infiniteJump and "Infinite jump enabled" or "Infinite jump disabled", infiniteJump)
    end)

    connect(UIS.JumpRequest, function()
        if destroyed or not infiniteJump or flying then return end

        if humanoid and humanoid.Parent and humanoid.Health > 0 then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)

    connect(resetSelfButton.Activated, function()
        walkOn, jumpOn, infiniteJump = false, false, false
        restoreSelf()

        walkSlider.set(DEFAULT_WALK)
        jumpSlider.set(DEFAULT_JUMP)

        setButtonState(walkRow, false)
        setButtonState(jumpRow, false)
        setButtonState(infJumpRow, false)

        notify("Self settings reset", true)
    end)
end

