    local function cyclePlayer(step)
        local candidates = {}

        for _, target in ipairs(Players:GetPlayers()) do
            if target ~= player then
                table.insert(candidates, target)
            end
        end

        table.sort(candidates, function(a, b)
            return a.Name:lower() < b.Name:lower()
        end)

        if #candidates == 0 then
            notify("No other players in this server", false)
            return
        end

        local index = 0

        for i, target in ipairs(candidates) do
            if target == selectedPlayer then
                index = i
                break
            end
        end

        index = ((index - 1 + step) % #candidates) + 1
        selectedPlayer = candidates[index]

        selectedLabel.Text = "Selected: "
            .. selectedPlayer.DisplayName
            .. " (@" .. selectedPlayer.Name .. ")"

        refreshPlayerList()
    end

