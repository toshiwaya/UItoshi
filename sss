-- Camera FOV controls. Start from the game's current FOV and do not alter it
-- automatically. The camera only changes after the user moves the FOV slider
-- or explicitly selects a preset.
local function readCurrentCameraFov()
    local value = 70
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then value = cam.FieldOfView end
    end)
    return math.clamp(tonumber(value) or 70, 70, 120)
end

local cameraFov = readCurrentCameraFov()
local cameraPreset = (cameraFov == 70) and "70 (Default)"
    or ((cameraFov == 90) and "90")
    or ((cameraFov == 120) and "120" or "Custom")
local savedCameraSettings = setmetatable({}, {__mode = "k"})

local function applyCameraFov()
    local cam = workspace.CurrentCamera
    if not cam then return end
    if not savedCameraSettings[cam] then
        savedCameraSettings[cam] = {
            FieldOfView = cam.FieldOfView,
            FieldOfViewMode = cam.FieldOfViewMode,
        }
    end
    pcall(function() cam.FieldOfView = math.clamp(cameraFov, 70, 120) end)
end

local function restoreCameraFov()
    for cam, original in pairs(savedCameraSettings) do
        if cam then
            pcall(function()
                cam.FieldOfView = original.FieldOfView
                cam.FieldOfViewMode = original.FieldOfViewMode
            end)
        end
    end
    table.clear(savedCameraSettings)
end

