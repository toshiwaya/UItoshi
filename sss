--==============================================================
-- NO-CLIP AND COLLISION RESTORATION
--==============================================================
-- Every part we touch remembers its ORIGINAL CanCollide value and gets
-- exactly that value back. (R15 limbs are non-collidable by default, so
-- forcing everything to true would be wrong.) The part list is cached and
-- kept up to date by events instead of walking the character every frame.

hud.noClipParts = {}

hud.trackPart = function(part)
    if not part:IsA("BasePart") then return end

    if savedCollisions[part] == nil then
        savedCollisions[part] = part.CanCollide
    end

    hud.noClipParts[part] = true
    part.CanCollide = false
end

hud.restoreCollisions = function()
    for part, oldValue in pairs(savedCollisions) do
        if part.Parent then
            pcall(function()
                part.CanCollide = oldValue
            end)
        end
    end

    table.clear(savedCollisions)
    table.clear(hud.noClipParts)
end

setNoClip = function(enabled, announce)
    noClipEnabled = enabled

    if noClipConnection then
        noClipConnection:Disconnect()
        noClipConnection = nil
    end

    if noClipPartConnection then
        noClipPartConnection:Disconnect()
        noClipPartConnection = nil
    end

    if not enabled then
        hud.restoreCollisions()
        hud.updateBindLabels()

        if statusLabel and statusLabel.Parent then
            statusLabel.Text = "Collision restored"
        end

        if announce then
            notify("No-clip disabled", false)
        end

        return
    end

    hud.updateBindLabels()

    if character and character.Parent then
        noClipPartConnection = character.DescendantAdded:Connect(function(item)
            if noClipEnabled then
                hud.trackPart(item)
            end
        end)

        for _, item in ipairs(character:GetDescendants()) do
            hud.trackPart(item)
        end
    end

    local lastSeat

    noClipConnection = RunService.Stepped:Connect(function()
        if destroyed or not noClipEnabled or not gui.Parent then
            if noClipConnection then
                noClipConnection:Disconnect()
                noClipConnection = nil
            end
            return
        end

        -- Vehicles: when you sit in a VehicleSeat its whole model goes
        -- non-collidable too (looked up once per seat, not every frame).
        local seat = humanoid and humanoid.SeatPart

        if seat ~= lastSeat then
            lastSeat = seat

            if seat and seat:IsA("VehicleSeat") then
                local vehicle = seat:FindFirstAncestorOfClass("Model")

                if vehicle then
                    for _, item in ipairs(vehicle:GetDescendants()) do
                        hud.trackPart(item)
                    end
                end
            end
        end

        for part in pairs(hud.noClipParts) do
            if part.Parent then
                if part.CanCollide then
                    part.CanCollide = false
                end
            else
                hud.noClipParts[part] = nil
            end
        end
    end)

    if announce then
        notify("No-clip enabled", true)
    end
end

