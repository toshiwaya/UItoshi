-- Fit the strip to its contents, but never wider than the visible Roblox UI area.
-- If many feature chips are active on a small screen, the extra chips are clipped
-- rather than making the bar extend beyond the screen.
hud.fitStatsBar = function()
    local vp = hud.viewportSize()
    local contentWidth = hud.statsLayout and hud.statsLayout.AbsoluteContentSize.X or 136
    local desiredWidth = math.ceil(contentWidth + 24)
    local maxWidth = math.max(80, vp.X - 16)
    hud.statsBar.Size = UDim2.fromOffset(math.min(desiredWidth, maxWidth), 30)

    local absolute = hud.statsBar.AbsolutePosition
    local x = absolute.X + hud.statsBar.AbsoluteSize.X / 2
    local y = absolute.Y
    local halfWidth = hud.statsBar.AbsoluteSize.X / 2
    local height = hud.statsBar.AbsoluteSize.Y
    x = math.clamp(x, halfWidth, math.max(halfWidth, vp.X - halfWidth))
    y = math.clamp(y, 0, math.max(0, vp.Y - height))
    hud.statsBar.Position = UDim2.fromOffset(x, y)
end

