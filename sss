        tab.BackgroundTransparency = 1
        tab.BorderSizePixel = 0
        tab.AutoButtonColor = false
        tab.Text = ""
        tab.Parent = tabBar

        local caption = label(
            tab, def.caption,
            UDim2.fromOffset(30, 0), UDim2.new(1, -30, 1, 0),
            11, UI.muted, false
        )
        caption.Font = Enum.Font.GothamMedium

        local setIcon = makeIcon(tab, def.id)

        tabButtons[def.id] = {
            button = tab, caption = caption, icon = setIcon, x = x,
        }
    end

    -- The chosen page's description, on the right of the tab bar.
    -- Reserve a dedicated region to the right of all six tabs. The old 240 px
