--==============================================================
-- AIM LOCK (hold / toggle / always; living players and NPCs)
--==============================================================
-- Rotates the camera so the target lands exactly under the aim point
-- (screen centre or mouse cursor). It runs at the LAST render priority,
-- so custom game cameras cannot overwrite it.
--
-- Targets are skipped when they are dead, invisible, the local character,
-- a camera view-model, or (optionally) a teammate.
--
-- Two kinds of game camera exist:
--   * Roblox default: reads camera.CFrame back every frame, so smooth
--     aiming simply accumulates.
--   * Custom (most shooters): rebuilds camera.CFrame from its own yaw/pitch
--     every frame and ignores what we wrote. We detect this and carry our
--     correction forward ourselves, so smoothing still converges. The
--     detector needs several clear frames of evidence before it switches, so
--     mouse movement can no longer fool it into the wrong mode.
--
-- Target handling:
--   * Sticky target: once locked, it stays locked until it is really lost
--     (dead, hidden, far outside the FOV), instead of hopping to whoever is
--     closest to the crosshair that frame.
--   * A short grace period absorbs one-frame wall-check misses.
--   * Head / torso do not flip-flop when the head is only partly visible.
--   * Hold mode double-checks that the key is really down, so a missed
--     "released" event can never leave the lock stuck on.

do
    local function setupAim()
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.IgnoreWater = true
        rayParams.RespectCanCollide = true

        -- The FOV circle lives in its own ScreenGui that ignores the topbar
        -- inset, so it matches viewport coordinates exactly.
        aim.fovGui = Instance.new("ScreenGui")
        aim.fovGui.Name = "ToshiCCAimFov"
        aim.fovGui.ResetOnSpawn = false
        aim.fovGui.IgnoreGuiInset = true
        aim.fovGui.DisplayOrder = 49
        aim.fovGui.Parent = playerGui

        local circle = Instance.new("Frame")
        circle.AnchorPoint = Vector2.new(0.5, 0.5)
        circle.BackgroundTransparency = 1
        circle.BorderSizePixel = 0
        circle.Visible = false
        circle.Size = UDim2.fromOffset(aim.fov * 2, aim.fov * 2)
        circle.Parent = aim.fovGui
        corner(circle, 9999)
        local circleStroke = stroke(circle, UI.muted, 1.5, 0.2)

        local lastText = ""

        local function setText(text)
            if text ~= lastText then
                lastText = text

                if aim.statusText then aim.statusText.Text = text end
                if aim.dockStatus then aim.dockStatus.Text = text end
            end
        end

        -- `name` is the locked target (or nil). `detail` is the status line
        -- shown when there is no target.
        local function setStatus(name, detail)
            aim.target = name

            local want = name and UI.signal or UI.muted
            if circleStroke.Color ~= want then
                circleStroke.Color = want
            end

            if name then
                setText("Locked on " .. name)
            else
                setText(detail or "Idle")
            end
        end

        local function aimActive()
            if not aim.on then return false end
            if aim.mode == "Always" then return true end
            if aim.mode == "Toggle" then return aim.toggled end
            return aim.holding
        end

        local function aimOrigin(camera)
            local useCursor

            if aim.origin == "Cursor" then
                useCursor = UIS.MouseEnabled
            elseif aim.origin == "Center" then
                useCursor = false
            else
                -- Auto: the cursor counts only while it is really free. Holding
                -- right-click, shift-lock and first person all lock it, and then
                -- the middle of the screen is the crosshair.
                useCursor = UIS.MouseEnabled
                    and UIS.MouseBehavior == Enum.MouseBehavior.Default
            end

            if useCursor then
                return UIS:GetMouseLocation()
            end

            return camera.ViewportSize / 2
        end

        -- Owner character (Humanoid or HumanoidRootPart rig) of a hit part.
        local function characterOf(inst)
            local node = inst.Parent

            for _ = 1, 6 do
                if not node or node == workspace then return nil end

                if node:IsA("Model")
                    and (node:FindFirstChildOfClass("Humanoid")
                        or node:FindFirstChild("HumanoidRootPart")) then
                    return node
                end

                node = node.Parent
            end

            return nil
        end

        -- Line of sight from the camera to the target part. Only map geometry
        -- counts as a wall. Ignored on the way: your own character, the camera
        -- (first-person viewmodel), other characters, almost invisible parts,
        -- and anything within a few studs of the camera itself (a viewmodel that
        -- lives in Workspace would otherwise block every shot).
        local function isVisible(camera, part, model, hum)
            local origin = camera.CFrame.Position
            local offset = part.Position - origin
            local ignore = {model, camera}

            if character and character.Parent then
                ignore[#ignore + 1] = character
            end

            -- A player sitting in a vehicle: the vehicle counts as part of
            -- the target, otherwise every driver would look "behind a wall".
            -- (A model with very many children is the map, not a vehicle.)
            local seat = hum and hum.SeatPart

            if seat then
                local vehicle = seat:FindFirstAncestorOfClass("Model")

                if vehicle and vehicle ~= model and #vehicle:GetChildren() < 80 then
                    ignore[#ignore + 1] = vehicle
                else
                    ignore[#ignore + 1] = seat
                end
            end

            for _ = 1, 24 do
                rayParams.FilterDescendantsInstances = ignore

                local hit = workspace:Raycast(origin, offset, rayParams)
                if not hit then return true end

                local inst = hit.Instance
                if inst:IsDescendantOf(model) then return true end

                local owner = characterOf(inst)

                if owner then
                    ignore[#ignore + 1] = owner
                elseif hit.Distance < 2.5 or inst.Transparency >= 0.9 then
                    ignore[#ignore + 1] = inst
                else
                    return false
                end
            end

            return false
        end

        -- Camera handling -------------------------------------------

        local camState = {camera = nil, lastIn = nil, lastOut = nil, score = 0, overwrite = false}

        local function lookAngle(a, b)
            return math.acos(math.clamp(a.LookVector:Dot(b.LookVector), -1, 1))
        end

        local function resetCamState()
            camState.lastIn, camState.lastOut = nil, nil
        end

        -- The CFrame the aim starts from this frame. On a normal camera that is
        -- simply the current CFrame. On a camera that ignores what we write, it is
        -- our previous output plus whatever the player turned since.
        local function aimBase(camera)
            local cf = camera.CFrame

            if camState.camera ~= camera then
                camState.camera = camera
                camState.score = 0
                camState.overwrite = false
                resetCamState()
            end

            local lastIn, lastOut = camState.lastIn, camState.lastOut
            if not lastIn or not lastOut then return cf end

            -- Learn which kind of camera this is. After our write, a camera that
            -- reads back starts the next frame near our output; one that
            -- overwrites starts near its own previous value. Only frames where
            -- the answer is clear count (the camera landed within a quarter of
            -- our correction of one and more than three quarters from the
            -- other), so ordinary mouse movement does not move the score.
            local correction = lookAngle(lastIn, lastOut)

            if correction > 0.003 then
                local dIn = lookAngle(cf, lastIn)
                local dOut = lookAngle(cf, lastOut)

                if dIn < correction * 0.25 and dOut > correction * 0.75 then
                    camState.score = math.min(camState.score + 1, 10)
                elseif dOut < correction * 0.25 and dIn > correction * 0.75 then
                    camState.score = math.max(camState.score - 2, 0)
                end
            end

            -- Hysteresis: it takes real evidence to switch in either direction.
            if camState.overwrite then
                if camState.score <= 1 then camState.overwrite = false end
            elseif camState.score >= 5 then
                camState.overwrite = true
            end

            if camState.overwrite then
                local turned = cf.Rotation * lastIn.Rotation:Inverse()
                return CFrame.new(cf.Position) * (turned * lastOut.Rotation)
            end

            return cf
        end

        -- Camera rotation (starting from `base`) that puts `targetPos` under
        -- pixel `originPx`. When the aim point is the screen centre the result
        -- is levelled (no roll), so the horizon never tilts.
        local function computeGoal(camera, base, originPx, targetPos, centered)
            local pos = base.Position
            local toTarget = targetPos - pos

            if toTarget.Magnitude < 0.001 then return nil end
            toTarget = toTarget.Unit

            local worldDir = camera:ViewportPointToRay(originPx.X, originPx.Y).Direction.Unit
            local current = base:VectorToWorldSpace(
                camera.CFrame:VectorToObjectSpace(worldDir)
            )
            local axis = current:Cross(toTarget)

            if axis.Magnitude < 0.00001 then return nil end

            local angle = math.acos(math.clamp(current:Dot(toTarget), -1, 1))
            local rotation = CFrame.fromAxisAngle(axis.Unit, angle) * base.Rotation

            if centered then
                local look = rotation.LookVector

                if math.abs(look.Y) < 0.995 then
                    rotation = CFrame.lookAt(Vector3.zero, look)
                end
            end

            return CFrame.new(pos) * rotation
        end

        -- Target search ----------------------------------------------

        -- The candidate list is rebuilt a few times a second; positions and
        -- health are read fresh every frame.
        local cache = {
            list = {}, age = math.huge, version = -1, lastModel = nil,
            lock = nil, lostAt = nil, lockPart = nil, lockPartAt = 0,
        }
        local partBuf = {}
        local BODY_NAMES = {"Head", "UpperTorso", "Torso", "LowerTorso"}

        local function dropLock()
            cache.age = math.huge
            cache.lastModel = nil
            cache.lock = nil
            cache.lostAt = nil
            cache.lockPart = nil
        end

        -- Players that the game hides (spectating, ghost / phase states) keep
        -- their character in Workspace with every body part transparent.
        local function bodyVisible(model)
            local found = false

            for _, name in ipairs(BODY_NAMES) do
                local p = model:FindFirstChild(name)

                if p and p:IsA("BasePart") then
                    found = true
                    if p.Transparency < 0.95 then return true end
                end
            end

            return not found -- custom rig: nothing to judge by
        end

        -- Distance from the aim point when `part` is on screen, inside the FOV
        -- and (if wall check is on) in line of sight. Otherwise nil.
        local function partUsable(camera, part, model, originPx, fovLimit, hum)
            local screen, onScreen = camera:WorldToViewportPoint(part.Position)
            if not onScreen then return nil end

            local d = (Vector2.new(screen.X, screen.Y) - originPx).Magnitude
            if d ~= d or d > fovLimit then return nil end

            if aim.wallCheck and not isVisible(camera, part, model, hum) then
                return nil
            end

            return d
        end

        -- Best usable part of one target, or nil when it is not a valid target.
        local function evaluate(t, camera, originPx, myPos, fovLimit)
            local model, hum = t.model, t.hum

            if not model.Parent or not Targets.isAlive(hum, t.plr ~= nil, model) then
                return nil
            end

            if aim.teamCheck then
                if t.plr then
                    if Targets.sameTeam(t.plr) then return nil end
                elseif Targets.sameTeamNpc(model) then
                    return nil
                end
            end

            if aim.skipInvisible and not bodyVisible(model) then
                return nil
            end

            local parts = Targets.candidateParts(model, hum, aim.part, partBuf)
            local first = parts[1]

            if not first or (first.Position - myPos).Magnitude > aim.maxDist then
                return nil
            end

            for _, part in ipairs(parts) do
                local d = partUsable(camera, part, model, originPx, fovLimit, hum)
                if d then return part, d end
            end

            return nil
        end

        local function findTarget(camera, dt, originPx)
            cache.age += dt

            if cache.age >= 0.15 or cache.version ~= Targets.version then
                cache.age = 0
                cache.version = Targets.version
                Targets.collect(cache.list, aim.players, aim.npcs, camera)
            end

            local now = os.clock()
            local myPos = (root and root.Parent) and root.Position
                or camera.CFrame.Position

            -- Sticky: stay on the current target while it is still usable.
            local lock = cache.lock

            if aim.sticky and lock then
                local limit = aim.fov * 1.2
                local part = evaluate(lock, camera, originPx, myPos, limit)

                if part then
                    cache.lostAt = nil

                    -- Do not hop between head and torso every frame when the
                    -- head is only partly visible.
                    local previous = cache.lockPart

                    if previous and previous ~= part and previous.Parent
                        and now - cache.lockPartAt < 0.35
                        and partUsable(camera, previous, lock.model, originPx, limit, lock.hum) then
                        part = previous
                    end

                    if part ~= cache.lockPart then
                        cache.lockPart = part
                        cache.lockPartAt = now
                    end

                    return lock, part
                end

                -- Lost for a moment (wall edge, respawn): wait briefly, then
                -- let go and look for someone else.
                cache.lostAt = cache.lostAt or now

                if now - cache.lostAt < 0.2 then
                    return nil, nil
                end

                cache.lock, cache.lostAt, cache.lockPart = nil, nil, nil
            end

            local bestEntry, bestPart
            local bestScore = math.huge

            for _, t in ipairs(cache.list) do
                local part, d = evaluate(t, camera, originPx, myPos, aim.fov)

                if part then
                    local score = d

                    -- Without sticky mode, still prefer last frame's target
                    -- over one that is almost as close.
                    if t.model == cache.lastModel then
                        score *= 0.6
                    end

                    if score < bestScore then
                        bestEntry, bestPart, bestScore = t, part, score
                    end
                end
            end

            cache.lastModel = bestEntry and bestEntry.model or nil
            cache.lock = bestEntry

            if bestEntry then
                cache.lockPart = bestPart
                cache.lockPartAt = now
            end

            return bestEntry, bestPart
        end

        local function aimStep(dt)
            if destroyed then return end

            local camera = workspace.CurrentCamera
            if not camera then return end

            local originPx = aimOrigin(camera)

            circle.Visible = aim.on and aim.showFov

            if circle.Visible then
                circle.Position = UDim2.fromOffset(originPx.X, originPx.Y)
                circle.Size = UDim2.fromOffset(aim.fov * 2, aim.fov * 2)
            end

            if not aim.on then
                dropLock()
                resetCamState()
                return
            end

            -- A "released" event that never arrived must not keep the lock on.
            if aim.holding and not aim.holdTouch then
                local down

                if aim.bind.kind == "mouse" then
                    down = UIS:IsMouseButtonPressed(aim.bind.value)
                else
                    down = UIS:IsKeyDown(aim.bind.value)
                end

                if not down then
                    aim.holding = false
                end
            end

            if not aimActive() then
                dropLock()
                resetCamState()
                setStatus(
                    nil,
                    "Armed, "
                        .. (aim.mode == "Toggle" and "press " or "hold ")
                        .. aim.bindName()
                )
                return
            end

            local entry, part = findTarget(camera, dt, originPx)

            if not entry or not part then
                resetCamState()
                setStatus(nil, "No target")
                return
            end

            setStatus(entry.plr and entry.plr.Name or entry.model.Name)

            local base = aimBase(camera)
            local centered = (originPx - camera.ViewportSize / 2).Magnitude < 3
            local goal = computeGoal(camera, base, originPx, part.Position, centered)
            local out = base

            if goal then
                if aim.smooth >= 100 then
                    out = goal
                else
                    local alpha = 1 - math.exp(-aim.smooth * 0.3 * math.clamp(dt, 0, 0.1))
                    out = base:Lerp(goal, alpha)
                end
            end

            camState.lastIn = camera.CFrame
            camState.lastOut = out
            camera.CFrame = out
        end

        RunService:BindToRenderStep(
            AIM_BIND_NAME,
            Enum.RenderPriority.Last.Value,
            function(dt)
                local ok, err = pcall(aimStep, dt)
                if not ok then warnOnce("Aim", err) end
            end
        )

        -- Input helpers used by the central input handler ----------------

        function aim.bindName()
            if aim.bind.kind == "mouse" then
                return "Mouse " .. string.sub(aim.bind.value.Name, -1)
            end

            return aim.bind.value.Name
        end

        function aim.matches(input)
            if aim.bind.kind == "mouse" then
                return input.UserInputType == aim.bind.value
            end

            return input.UserInputType == Enum.UserInputType.Keyboard
                and input.KeyCode == aim.bind.value
        end

        function aim.press(fromTouch)
            if aim.mode == "Toggle" then
                aim.toggled = not aim.toggled
            else
                aim.holding = true
                aim.holdTouch = fromTouch == true
            end
        end

        function aim.release()
            aim.holding = false
            aim.holdTouch = false
        end

        -- Returns true when the input was consumed by key rebinding.
        function aim.captureBind(input)
            if not aim.binding then return false end

            local kind = input.UserInputType

            if kind == Enum.UserInputType.Keyboard then
                local code = input.KeyCode

                if code == Enum.KeyCode.Escape then
                    aim.binding = false
                elseif code == Enum.KeyCode.Unknown then
                    return true
                elseif code == flyKey or code == noClipKey or code == menuKey then
                    aim.binding = false
                    notify("That key is already assigned", false)
                else
                    aim.bind = {kind = "key", value = code}
                    aim.binding = false
                    notify("Aim key set to " .. aim.bindName(), true)
                end
            elseif kind == Enum.UserInputType.MouseButton1
                or kind == Enum.UserInputType.MouseButton2
                or kind == Enum.UserInputType.MouseButton3 then
                aim.bind = {kind = "mouse", value = kind}
                aim.binding = false
                notify("Aim key set to " .. aim.bindName(), true)
            else
                return true -- keep waiting; ignore touch / gamepad noise
            end

            aim.holding = false
            aim.refreshBindButton()
            return true
        end

        -- Side panel ------------------------------------------------
        -- YOUR character with the FOV ring to scale and the aim point for
        -- the chosen target part.

        local dock = {}

        do
            local body = hud.newDock("aim", "Preview")
            local W, H = hud.dockW - 20, 270

            -- The figure sits right of centre; the crosshair is on the left.
            local pv = hud.makePreview(body, W, H, 34)
            hud.previews.aim = pv
            dock.pv = pv

            local CX, CY = W / 2 - 52, H / 2
            dock.cx, dock.cy = CX, CY

            dock.ring = Instance.new("Frame")
            dock.ring.AnchorPoint = Vector2.new(0.5, 0.5)
            dock.ring.Position = UDim2.fromOffset(CX, CY)
            dock.ring.BackgroundTransparency = 1
            dock.ring.BorderSizePixel = 0
            dock.ring.Parent = pv.overlay
            corner(dock.ring, 9999)
            stroke(dock.ring, UI.white, 1.5, 0.25)

            local function cross(w, h)
                local f = Instance.new("Frame")
                f.AnchorPoint = Vector2.new(0.5, 0.5)
                f.Position = UDim2.fromOffset(CX, CY)
                f.Size = UDim2.fromOffset(w, h)
                f.BackgroundColor3 = UI.white
                f.BorderSizePixel = 0
                f.Parent = pv.overlay
            end

            cross(12, 1)
            cross(1, 12)

            dock.line = Instance.new("Frame")
            dock.line.AnchorPoint = Vector2.new(0.5, 0.5)
            dock.line.BackgroundColor3 = UI.muted
            dock.line.BorderSizePixel = 0
            dock.line.Parent = pv.overlay

            dock.marker = Instance.new("Frame")
            dock.marker.AnchorPoint = Vector2.new(0.5, 0.5)
            dock.marker.Size = UDim2.fromOffset(9, 9)
            dock.marker.BackgroundTransparency = 1
            dock.marker.BorderSizePixel = 0
            dock.marker.Parent = pv.overlay
            corner(dock.marker, 5)
            stroke(dock.marker, UI.white, 1.5, 0)

            pv.onBuilt = function()
                aim.refreshDock()
            end

            local notes = Instance.new("Frame")
            notes.Position = UDim2.fromOffset(0, H + 8)
            notes.Size = UDim2.new(1, 0, 1, -(H + 8))
            notes.BackgroundTransparency = 1
            notes.BorderSizePixel = 0
            notes.Parent = body

            local notesLayout = Instance.new("UIListLayout")
            notesLayout.Padding = UDim.new(0, 5)
            notesLayout.SortOrder = Enum.SortOrder.LayoutOrder
            notesLayout.Parent = notes

            aim.dockStatus = label(
                notes, "Idle",
                UDim2.new(), UDim2.new(1, 0, 0, 14),
                10, UI.white, true
            )
            aim.dockStatus.LayoutOrder = 1

            dock.info = label(
                notes, "",
                UDim2.new(), UDim2.new(1, 0, 0, 40),
                10, UI.muted, false
            )
            dock.info.TextWrapped = true
            dock.info.TextYAlignment = Enum.TextYAlignment.Top
            dock.info.LayoutOrder = 2

            -- Filled in by the stats loop when the game streams the map.
            aim.streamNote = label(
                notes, "",
                UDim2.new(), UDim2.new(1, 0, 0, 52),
                9, UI.accent, false
            )
            aim.streamNote.TextWrapped = true
            aim.streamNote.TextYAlignment = Enum.TextYAlignment.Top
            aim.streamNote.LayoutOrder = 3
            aim.streamNote.Visible = false
        end

        function aim.refreshDock()
            if not dock.ring then return end

            -- FOV radius 50..600 px maps to 12..70 px in the preview.
            local radius = 12 + (aim.fov - 50) / 550 * 58
            dock.ring.Size = UDim2.fromOffset(radius * 2, radius * 2)

            local points = dock.pv.points

            if points then
                local point = aim.part == "Head" and points.head
                    or (aim.part == "Chest" and points.chest or points.root)
                local p = dock.pv.project(point)
                local dx, dy = p.X - dock.cx, p.Y - dock.cy
                local length = math.sqrt(dx * dx + dy * dy)

                dock.marker.Position = UDim2.fromOffset(p.X, p.Y)
                dock.line.Position = UDim2.fromOffset((p.X + dock.cx) / 2, (p.Y + dock.cy) / 2)
                dock.line.Size = UDim2.fromOffset(math.max(length - 6, 0), 1)
                dock.line.Rotation = math.deg(math.atan2(dy, dx))
            end

            dock.info.Text = string.format(
                "Aims at the %s. FOV radius %d px, smoothing %d. %s mode on %s.",
                string.lower(aim.part), aim.fov, aim.smooth, aim.mode, aim.bindName()
            )
        end

        -- UI ------------------------------------------------------

        local rows = {}

        local function addToggle(block, name, key, onChange, description, withKey)
            local row, chip = toggleRow(block, name, description, withKey)

            rows[key] = row
            setButtonState(row, aim[key])

            connect(row.Activated, function()
                aim[key] = not aim[key]
                setButtonState(row, aim[key])
                cache.age = math.huge

                if onChange then onChange(aim[key]) end

                aim.refreshDock()
            end)

            return row, chip
        end

        local mainBlock = group(aimPage, "Aim lock")

        local _, keyChip = addToggle(mainBlock, "Enable aim lock", "on", function(v)
            aim.holding = false
            aim.toggled = false
            dropLock()
            setStatus(nil)

            if v then
                notify("Aim lock enabled", true)
            else
                notify("Aim lock disabled", false)
            end
        end, nil, true)

        aim.keyChip = keyChip

        aim.statusText = statusRow(mainBlock, "Status")
        aim.statusText.Text = "Idle"

        local targetBlock = group(aimPage, "Targets")

        addToggle(targetBlock, "Ignore teammates", "teamCheck")
        addToggle(targetBlock, "Target players", "players")
        addToggle(
            targetBlock, "Target NPCs", "npcs", nil,
            "Dummies and bots. Off is safest"
        )
        addToggle(
            targetBlock, "Wall check", "wallCheck", nil,
            "Skip targets behind map geometry"
        )
        addToggle(
            targetBlock, "Sticky target", "sticky", function()
                dropLock()
            end,
            "Stay on one player until you lose them"
        )
        addToggle(
            targetBlock, "Skip invisible players", "skipInvisible", nil,
            "Ignore players you cannot see"
        )

        local behaviorBlock = group(aimPage, "Behavior")

        local modeControl = segmented(
            behaviorBlock, "Aim mode", {"Hold", "Toggle", "Always"}, aim.mode,
            function(v)
                aim.mode = v
                aim.holding = false
                aim.toggled = false
                dropLock()
                aim.refreshDock()
                notify("Aim mode: " .. v, true)
            end
        )

        local aimBindButton = bindRow(behaviorBlock, "Aim key")

        function aim.refreshBindButton()
            aimBindButton.Text = aim.binding and "Press a key" or aim.bindName()

            if aim.keyChip then
                aim.keyChip.Text = aim.bindName()
            end

            aim.refreshDock()
        end

        aim.refreshBindButton()

        connect(aimBindButton.Activated, function()
            aim.binding = true
            aim.holding = false
            aim.refreshBindButton()
        end)

        local partControl = segmented(
            behaviorBlock, "Target part", {"Head", "Chest", "Root"}, aim.part,
            function(v)
                aim.part = v
                dropLock()
                aim.refreshDock()
                notify("Aiming at " .. string.lower(v), true)
            end
        )

        local originControl = segmented(
            behaviorBlock, "Aim point", {"Auto", "Cursor", "Center"}, aim.origin,
            function(v)
                aim.origin = v
                notify("Aim point: " .. string.lower(v), true)
            end
        )

        local fieldBlock = group(aimPage, "Field and feel")

        addToggle(fieldBlock, "Show FOV circle", "showFov")

        local fovSlider = createSlider(
            fieldBlock, "FOV radius", "pixels from the aim point",
            50, 600, aim.fov,
            function(v)
                aim.fov = v
                aim.refreshDock()
            end
        )

        local smoothSlider = createSlider(
            fieldBlock, "Smoothness", "higher is faster, 100 locks on",
            1, 100, aim.smooth,
            function(v)
                aim.smooth = v
                aim.refreshDock()
            end
        )

        local distSlider = createSlider(
            fieldBlock, "Max distance", "studs",
            50, 5000, aim.maxDist,
            function(v) aim.maxDist = v end
        )


        local resetAimButton = buttonRow(
            aimPage, "Reset to defaults",
            {background = UI.bg, text = UI.muted, textSize = 12, height = 34}
        )

        connect(resetAimButton.Activated, function()
            aim.on = false
            aim.mode = "Hold"
            aim.part = "Head"
            aim.origin = "Auto"
            aim.bind = {kind = "mouse", value = Enum.UserInputType.MouseButton2}
            aim.binding = false
            aim.holding = false
            aim.holdTouch = false
            aim.toggled = false
            aim.teamCheck = false
            aim.players = true
            aim.npcs = false
            aim.wallCheck = true
            aim.sticky = true
            aim.skipInvisible = true
            aim.showFov = true
            aim.fov = 200
            aim.smooth = 30
            aim.maxDist = 1500
            dropLock()

            -- Redraws every control from the values above.
            for key, row in pairs(rows) do
                setButtonState(row, aim[key])
            end

            modeControl.set("Hold")
            partControl.set("Head")
            originControl.set("Auto")
            fovSlider.set(200)
            smoothSlider.set(30)
            distSlider.set(1500)
            aim.refreshBindButton()
            setStatus(nil)

            notify("Aimbot settings reset", true)
        end)

        -- Re-reads every aim control from the state table (config load).
        refreshers[#refreshers + 1] = function()
            for key, row in pairs(rows) do
                setButtonState(row, aim[key])
            end

            modeControl.set(aim.mode)
            partControl.set(aim.part)
            originControl.set(aim.origin)
            fovSlider.set(aim.fov)
            smoothSlider.set(aim.smooth)
            distSlider.set(aim.maxDist)
            aim.refreshBindButton()
            dropLock()
        end

        aim.refreshDock()
    end

    setupAim()
end

