-- Character preview ---------------------------------------------------------
-- A ViewportFrame showing a clay-grey copy of YOUR character, seen from the
-- front. Overlays (the ESP marker, the aim ring) are drawn over it with
-- project(), which maps a point of the preview world onto the frame without
-- touching the engine's camera maths.

hud.previews = {}

hud.grayOf = function(color)
    local lum = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
    local v = 0.2 + lum * 0.55
    return Color3.new(v, v, v)
end

function hud.makePreview(parent, width, height, offsetX)
    local pv = {w = width, h = height, dirty = true, active = false, parts = {}}
    offsetX = offsetX or 0

    local root = Instance.new("Frame")
    root.Name = "Preview"
    root.Size = UDim2.fromOffset(width, height)
    root.BackgroundColor3 = Color3.fromRGB(6, 6, 6)
    root.BorderSizePixel = 0
    root.ClipsDescendants = true
    root.Parent = parent
    corner(root, 2)
    stroke(root, UI.line, 1, 0)
    pv.root = root

    -- A faint grid.
    for x = 24, width - 1, 24 do
        local f = Instance.new("Frame")
        f.Position = UDim2.fromOffset(x, 0)
        f.Size = UDim2.new(0, 1, 1, 0)
        f.BackgroundColor3 = UI.line
        f.BackgroundTransparency = 0.82
        f.BorderSizePixel = 0
        f.Parent = root
    end

    for y = 24, height - 1, 24 do
        local f = Instance.new("Frame")
        f.Position = UDim2.fromOffset(0, y)
        f.Size = UDim2.new(1, 0, 0, 1)
        f.BackgroundColor3 = UI.line
        f.BackgroundTransparency = 0.82
        f.BorderSizePixel = 0
        f.Parent = root
    end

    -- The ground the figure stands on.
    pv.floor = Instance.new("Frame")
    pv.floor.AnchorPoint = Vector2.new(0.5, 0.5)
    pv.floor.Size = UDim2.fromOffset(120, 16)
    pv.floor.BackgroundTransparency = 1
    pv.floor.BorderSizePixel = 0
    pv.floor.Visible = false
    pv.floor.Parent = root
    corner(pv.floor, 8)
    stroke(pv.floor, UI.line2, 1, 0.3)

    local vp = Instance.new("ViewportFrame")
    vp.Position = UDim2.fromOffset(offsetX, 0)
    vp.Size = UDim2.fromScale(1, 1)
    vp.BackgroundTransparency = 1
    vp.BorderSizePixel = 0
    vp.Ambient = Color3.fromRGB(135, 135, 135)
    vp.LightColor = Color3.fromRGB(255, 255, 255)
    vp.LightDirection = Vector3.new(-0.35, -0.5, 1)
    vp.Parent = root

    local cam = Instance.new("Camera")
    cam.FieldOfView = 26
    cam.Parent = vp
    vp.CurrentCamera = cam
    pv.camera = cam

    pv.overlay = Instance.new("Frame")
    pv.overlay.Name = "Overlay"
    pv.overlay.Size = UDim2.fromScale(1, 1)
    pv.overlay.BackgroundTransparency = 1
    pv.overlay.BorderSizePixel = 0
    pv.overlay.Parent = root

    -- A copy of the real character, cleaned up for display.
    local function sourceClone()
        local char = player.Character
        if not char then return nil end

        local previous = char.Archivable
        char.Archivable = true

        local ok, clone = pcall(function()
            return char:Clone()
        end)

        char.Archivable = previous

        if ok then return clone end
        return nil
    end

    local function clean(model)
        local drop = {}

        for _, inst in ipairs(model:GetDescendants()) do
            if inst:IsA("LuaSourceContainer") or inst:IsA("Tool") or inst:IsA("Sound")
                or inst:IsA("ForceField") or inst:IsA("Highlight")
                or inst:IsA("BillboardGui") or inst:IsA("SurfaceGui")
                or inst:IsA("Decal") or inst:IsA("Texture")
                or inst:IsA("Shirt") or inst:IsA("Pants") or inst:IsA("ShirtGraphic")
                or inst:IsA("ParticleEmitter") or inst:IsA("Trail")
                or inst:IsA("Beam") or inst:IsA("Light") then
                drop[#drop + 1] = inst
            end
        end

        for _, inst in ipairs(drop) do
            inst:Destroy()
        end

        pv.parts = {}

        for _, inst in ipairs(model:GetDescendants()) do
            if inst:IsA("BasePart") then
                inst.Anchored = true
                inst.CanCollide = false
                inst.CanQuery = false
                inst.CanTouch = false
                inst.Material = Enum.Material.SmoothPlastic

                local gray = hud.grayOf(inst.Color)
                inst.Color = gray
                pv.parts[#pv.parts + 1] = {part = inst, gray = gray}

                if inst:IsA("MeshPart") then
                    pcall(function() inst.TextureID = "" end)
                end
            elseif inst:IsA("SpecialMesh") then
                pcall(function() inst.TextureId = "" end)
            end
        end

        local hum = model:FindFirstChildOfClass("Humanoid")

        if hum then
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        end
    end

    -- Used when there is no character to copy.
    local function fallbackFigure()
        local model = Instance.new("Model")

        pv.parts = {}

        local function block(name, size, position)
            local p = Instance.new("Part")
            p.Name = name
            p.Size = size
            p.Position = position
            p.Anchored = true
            p.CanCollide = false
            p.Material = Enum.Material.SmoothPlastic
            p.Color = Color3.fromRGB(120, 120, 120)
            p.Parent = model
            pv.parts[#pv.parts + 1] = {part = p, gray = p.Color}
        end

        block("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0))
        block("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0))
        block("Left Arm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0))
        block("Right Arm", Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0))
        block("Left Leg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0))
        block("Right Leg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0))

        return model
    end

    function pv.rebuild()
        if pv.model then
            pv.model:Destroy()
            pv.model = nil
        end

        local model = sourceClone()

        if model then
            clean(model)
        else
            model = fallbackFigure()
        end

        model.Name = "PreviewCharacter"
        model.Parent = vp

        pcall(function()
            model:PivotTo(CFrame.new(0, 0, 0))
        end)

        local cf, size = model:GetBoundingBox()
        local center = cf.Position
        local fov = math.rad(cam.FieldOfView)
        local height3d = math.clamp(size.Y, 2, 30)
        local distance = (height3d / 0.7) / (2 * math.tan(fov / 2))

        cam.CFrame = CFrame.lookAt(center + Vector3.new(0, 0, -distance), center)
        pv.focal = (height / 2) / math.tan(fov / 2)

        local function partPosition(name)
            local p = model:FindFirstChild(name)
            if p and p:IsA("BasePart") then return p.Position end
            return nil
        end

        pv.points = {
            top = center + Vector3.new(0, height3d / 2, 0),
            bottom = center - Vector3.new(0, height3d / 2, 0),
            head = partPosition("Head") or (center + Vector3.new(0, height3d * 0.4, 0)),
            chest = partPosition("UpperTorso") or partPosition("Torso")
                or (center + Vector3.new(0, height3d * 0.15, 0)),
            root = partPosition("HumanoidRootPart") or center,
        }

        pv.model = model
        pv.base = model:GetPivot()
        pv.dirty = false

        -- The ground ring sits under the feet.
        local feet = pv.project(pv.points.bottom)
        pv.floor.Position = UDim2.fromOffset(feet.X, feet.Y)
        pv.floor.Size = UDim2.fromOffset(math.floor(height * 0.4), 14)
        pv.floor.Visible = true

        if pv.onBuilt then pv.onBuilt() end
    end

    -- Maps a point of the preview world to a position inside the frame.
    function pv.project(point)
        local rel = cam.CFrame:PointToObjectSpace(point)
        local depth = math.max(-rel.Z, 0.01)

        return Vector2.new(
            width / 2 + offsetX + pv.focal * rel.X / depth,
            height / 2 - pv.focal * rel.Y / depth
        )
    end

    function pv.refresh()
        if pv.dirty or not pv.model then
            local ok, err = pcall(pv.rebuild)
            if not ok then
                pv.dirty = false
                warnOnce("Preview", err)
            end
        end
    end

    -- A slow sway while the preview is on screen.
    connect(RunService.RenderStepped, function()
        if not pv.active or not pv.model or not pv.base then return end

        if esp.performance.potatoMode then
            if not pv.potatoPoseApplied then
                pcall(function() pv.model:PivotTo(pv.base) end)
                pv.potatoPoseApplied = true
            end
            return -- no per-frame model pivot work while Potato Mode is on
        end

        pv.potatoPoseApplied = false
        local yaw = math.rad(14) * math.sin(os.clock() * 0.8)
        pv.model:PivotTo(pv.base * CFrame.Angles(0, yaw, 0))
    end)

    connect(RunService.Heartbeat, function()
        if pv.active and pv.dirty then
            pv.refresh()
        end
    end)

    return pv
end

