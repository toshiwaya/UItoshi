            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.5, 0.35),
            NumberSequenceKeypoint.new(1, 1),
        })
        sweepGradient.Parent = sweep

        TweenService:Create(
            sweep,
            TweenInfo.new(1.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
            {Position = UDim2.new(1, 0, 0, 0)}
        ):Play()

        local percentConnection = connect(RunService.RenderStepped, function()
            percentLabel.Text = math.floor(fill.Size.X.Scale * 100 + 0.5) .. "%"
        end)

        local function pause(seconds)
            local waited = 0

            while waited < seconds and not destroyed do
                waited += task.wait()
            end
        end

        local function say(text)
            statusLabel.Text = text
            statusLabel.MaxVisibleGraphemes = 0

            TweenService:Create(
                statusLabel,
                TweenInfo.new(0.22, Enum.EasingStyle.Linear),
                {MaxVisibleGraphemes = #text}
            ):Play()
        end

        task.spawn(function()
            local quint = Enum.EasingStyle.Quint

            TweenService:Create(dim, TweenInfo.new(0.3), {BackgroundTransparency = 0.25}):Play()
            TweenService:Create(card, TweenInfo.new(0.3, quint), {GroupTransparency = 0}):Play()
            TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), {Scale = 1}):Play()
            TweenService:Create(
                mark, TweenInfo.new(0.45, Enum.EasingStyle.Back),
                {Size = UDim2.fromOffset(32, 32)}
            ):Play()

            pause(0.25)

            TweenService:Create(
                brandLabel,
                TweenInfo.new(0.4, Enum.EasingStyle.Linear),
                {MaxVisibleGraphemes = #BRAND}
            ):Play()

            local steps = {
                {"reading environment", 0.2},
                {"loading modules", 0.46},
                {"reading config", 0.7},
                {"building interface", 0.92},
                {"ready", 1},
            }

            for _, step in ipairs(steps) do
                if destroyed then break end

                say(step[1])
                TweenService:Create(
                    fill, TweenInfo.new(0.35, quint, Enum.EasingDirection.Out),
                    {Size = UDim2.new(step[2], 0, 1, 0)}
                ):Play()
                pause(0.4)
            end

            fill.Size = UDim2.new(1, 0, 1, 0)
            percentLabel.Text = "100%"
            pause(0.2)

            percentConnection:Disconnect()

            if not destroyed then
                TweenService:Create(card, TweenInfo.new(0.22), {GroupTransparency = 1}):Play()
                TweenService:Create(dim, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
                task.wait(0.3)
            end

            splashGui:Destroy()
            hud.splashGui = nil
            hud.splash = false

            if destroyed then return end

            hud.applyMenuVisibility()

            -- The window settles in from slightly smaller.
            if not isMinimized then
                local target = windowScale.Scale

                windowScale.Scale = target * 0.94
                TweenService:Create(
                    windowScale,
                    TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                    {Scale = target}
                ):Play()

                notify("toshi.cc ready", true)
            end
        end)
    end)()
end
