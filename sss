--==============================================================
-- CHARACTER TRACKING
--==============================================================
-- Nothing here is allowed to block forever: some games have no character
-- at start, custom rigs, or add the Humanoid late.

local character, humanoid, root

local function waitFor(char, finder, timeout)
    local deadline = os.clock() + timeout
    local result = finder()

    while not result and os.clock() < deadline and char.Parent do
        task.wait(0.1)
        result = finder()
    end

    return result
end

local function findRoot(char, hum)
    return char:FindFirstChild("HumanoidRootPart")
        or (hum and hum.RootPart)
        or char.PrimaryPart
end

local function bindCharacter(char)
    character = char
    humanoid, root = nil, nil

    local hum = waitFor(char, function()
        return char:FindFirstChildOfClass("Humanoid")
    end, 5)
    if player.Character ~= char then return end

    local rootPart = waitFor(char, function()
        return findRoot(char, hum)
    end, 5)
    if player.Character ~= char then return end

    humanoid, root = hum, rootPart
end

-- Cheap self-healing refresh (called twice a second). If a game swaps the
-- character, adds a Humanoid late or rebuilds the root, we recover anyway.
local function refreshRefs()
    local char = player.Character
    if not char then
        character, humanoid, root = nil, nil, nil
        return
    end

    character = char

    if not humanoid or humanoid.Parent ~= char then
        humanoid = char:FindFirstChildOfClass("Humanoid")
    end

    if not root or not root.Parent or not root:IsDescendantOf(char) then
        root = findRoot(char, humanoid)
    end
end

if player.Character then
    task.spawn(bindCharacter, player.Character)
end

local function localOrigin(camera)
    if root and root.Parent then
        return root.Position
    end

    if camera then
        return camera.CFrame.Position
    end

    return Vector3.zero
end

--==============================================================
-- TARGET FINDER (shared by ESP and aim lock)
--==============================================================
-- Players are read straight from Players:GetPlayers(), so any rig works.
-- NPCs come from a Humanoid registry that is maintained by events (one
-- scan when first needed, never repeated).

local Targets = {models = setmetatable({}, {__mode = "k"}), started = false, version = 0}

function Targets.register(inst)
    local model

    if inst:IsA("Humanoid") then
        model = inst.Parent

        if not (model and model:IsA("Model")) then
            model = inst:FindFirstAncestorOfClass("Model")
        end
    elseif inst.Name == "HumanoidRootPart" then
        local parent = inst.Parent

        if inst:IsA("BasePart") and parent and parent:IsA("Model") then
            model = parent
        end
    elseif inst:IsA("Model") then
        -- Custom player bodies are usually a Model named after the player.
        local owner = Players:FindFirstChild(inst.Name)

        if owner and owner:IsA("Player") then
            model = inst
        end
    end

    if model then
        Targets.models[model] = true
        Targets.version += 1 -- lets ESP / aim refresh right away
    end
end

function Targets.start()
    if Targets.started then return end
    Targets.started = true

    -- Removed models are dropped lazily in Targets.collect.
    connect(workspace.DescendantAdded, Targets.register)

    task.spawn(function()
        local count = 0

        for _, inst in ipairs(workspace:GetDescendants()) do
            if destroyed then return end

            Targets.register(inst)

            count += 1
            if count % 3000 == 0 then
                task.wait() -- spread the scan over a few frames
            end
        end
    end)
end

function Targets.rootOf(model, hum)
    local part = model:FindFirstChild("HumanoidRootPart")
    if part and part:IsA("BasePart") then return part end

    if hum and hum.RootPart then return hum.RootPart end
    if model.PrimaryPart then return model.PrimaryPart end

    for _, name in ipairs({"Torso", "UpperTorso", "LowerTorso", "Head"}) do
        part = model:FindFirstChild(name)
        if part and part:IsA("BasePart") then return part end
    end

    return model:FindFirstChildWhichIsA("BasePart")
end

