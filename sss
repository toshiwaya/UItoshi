hud.destroyMenu = function()
    if destroyed then return end

    destroyed = true

    -- Restore local graphics without restarting any UI animation during teardown.
    esp.performance.potatoMode = false
    potatoGeneration += 1
    potatoDisconnectWorldWatchers()
    potatoRestoreVisuals()
    if esp.performance.activeDotPulse then
        pcall(function() esp.performance.activeDotPulse:Cancel() end)
        esp.performance.activeDotPulse = nil
    end

    if spectating then
        stopSpectating()
    end

    stopFly()

    if noClipConnection then
        noClipConnection:Disconnect()
        noClipConnection = nil
    end

    if noClipPartConnection then
        noClipPartConnection:Disconnect()
        noClipPartConnection = nil
    end

    noClipEnabled = false
    hud.restoreCollisions()
    restoreSelf()
    restoreCameraFov()

    esp.on = false
    esp.npcs = false
    esp.clear()
    if esp.boxGui then esp.boxGui:Destroy() end

    aim.on = false
    aim.holding = false
    pcall(function()
        RunService:UnbindFromRenderStep(AIM_BIND_NAME)
    end)
    pcall(function()
        RunService:UnbindFromRenderStep(BOX_BIND_NAME)
    end)
    if aim.fovGui then aim.fovGui:Destroy() end

    table.clear(Targets.models)

    for _, c in ipairs(connections) do
        c:Disconnect()
    end

    if hud.tipGui then hud.tipGui:Destroy() end
    if hud.splashGui then hud.splashGui:Destroy() end

    gui:Destroy()
end

connect(closeButton.Activated, hud.destroyMenu)
connect(destroyButton.Activated, hud.destroyMenu)

-- If something else destroys the menu (another run of this script, a game
-- clearing PlayerGui), tear everything down so nothing keeps running.
gui.Destroying:Connect(function()
    if not destroyed then
        hud.destroyMenu()
    end
end)

--==============================================================
-- INPUT HANDLING (one handler, so ordering can never conflict)
--==============================================================

hud.pointerOverMenu = function(position)
    if not main.Visible then return false end

    local p, s = main.AbsolutePosition, main.AbsoluteSize
    return position.X >= p.X and position.X <= p.X + s.X
        and position.Y >= p.Y and position.Y <= p.Y + s.Y
end

connect(UIS.InputBegan, function(input, processed)
    if destroyed then return end

    -- 1) Rebinding the aim key.
    if aim.captureBind(input) then return end

    -- 2) Rebinding fly / no-clip / menu keys.
    if awaitingBind then
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode == Enum.KeyCode.Unknown then return end

        if input.KeyCode == Enum.KeyCode.Escape then
            awaitingBind = nil
            hud.updateBindLabels()
            return
        end

        local proposed = input.KeyCode

        if (awaitingBind ~= "fly" and proposed == flyKey)
            or (awaitingBind ~= "noclip" and proposed == noClipKey)
            or (awaitingBind ~= "menu" and proposed == menuKey)
            or (aim.bind.kind == "key" and proposed == aim.bind.value) then
            notify("That key is already assigned", false)
            awaitingBind = nil
            hud.updateBindLabels()
            return
        end

        if awaitingBind == "fly" then
            flyKey = proposed
        elseif awaitingBind == "noclip" then
            noClipKey = proposed
        else
            menuKey = proposed
        end

        awaitingBind = nil
        hud.updateBindLabels()
        notify("Keybind updated", true)
        return
    end

    -- 3) Aim key. Many games sink input (the `processed` flag is true even
    --    for plain gameplay clicks and bound keys), so it is ignored here.
    --    Only a left-click on this menu is skipped (it would press a menu
    --    button), and nothing fires while you are typing in a text box.
    --    Right / middle click and keyboard keys work even with the menu
    --    open, so you can test the aim lock without closing the menu.
    if aim.matches(input) then
        local blocked

        if aim.bind.kind == "mouse" then
            local touchPos, touchSize = hud.touchPanel.AbsolutePosition, hud.touchPanel.AbsoluteSize
            local overTouchControls = hud.touchPanel.Visible
                and input.Position.X >= touchPos.X
                and input.Position.X <= touchPos.X + touchSize.X
                and input.Position.Y >= touchPos.Y
                and input.Position.Y <= touchPos.Y + touchSize.Y

            blocked = aim.bind.value == Enum.UserInputType.MouseButton1
                and (hud.pointerOverMenu(input.Position) or overTouchControls)
        else
            blocked = UIS:GetFocusedTextBox() ~= nil
        end

        if not blocked then
            aim.press()
        end
    end

    -- 4) Feature / menu keys.
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if processed or UIS:GetFocusedTextBox() then return end

    if flyKey and input.KeyCode == flyKey then
        hud.toggleFly()
    elseif noClipKey and input.KeyCode == noClipKey then
        setNoClip(not noClipEnabled, true)
    elseif menuKey and input.KeyCode == menuKey then
        -- Same as the minimize button: window <-> badge.
        setMinimized(not isMinimized)
    end
end)

connect(UIS.InputEnded, function(input)
    if aim.matches(input) then
        aim.release()
    end

    if hud.isPointer(input) then
        local releasedSlider = activeSlider
        activeSlider = nil
        lockScroll(false)

        if releasedSlider == menuScaleSlider then
            hud.applyLayout()
        end

        hud.drag.on = false
        hud.drag.start = nil
        hud.drag.pos = nil

        if hud.drag.logoOn then
            hud.drag.logoOn = false
            hud.drag.logoStart = nil
            hud.drag.logoPos = nil

            if not hud.drag.logoMoved then
                hud.setMinimized(false)
            end
        end
    end
end)

-- Alt-tabbing away must never leave a key "stuck" down.
connect(UIS.WindowFocusReleased, function()
    aim.holding = false
    aim.holdTouch = false
    touchVertical = 0
    local releasedSlider = activeSlider
    activeSlider = nil
    lockScroll(false)
    if releasedSlider == menuScaleSlider then
        hud.applyLayout()
    end
end)

--==============================================================
-- CHARACTER LIFECYCLE
--==============================================================

hud.resetCharacterState = function()
    stopFly()
    setNoClip(false, false)
    touchVertical = 0
    activeSlider = nil
    lockScroll(false)
    hud.drag.on = false
    hud.drag.logoOn = false
end

connect(player.CharacterRemoving, function()
    hud.resetCharacterState()

    if spectating then
        stopSpectating()
    end
end)

connect(player.CharacterAdded, function(char)
    hud.resetCharacterState()

    -- The previews show your character: redo them once it has dressed.
    for _, pv in pairs(hud.previews) do
        pv.dirty = true
    end

    task.delay(2, function()
        for _, pv in pairs(hud.previews) do
            pv.dirty = true
        end
    end)

    task.spawn(function()
        bindCharacter(char)

        if spectating then
            stopSpectating()
        end

        hud.updateBindLabels()
    end)
end)

--==============================================================
-- CONFIG (save / load)
--==============================================================
-- Uses the file functions of the script executor (writefile / readfile /
-- isfile). Where they do not exist (Studio, for example) the menu says so and
-- nothing is written. Switch states (ESP on, aim on, flight ...) are
-- deliberately not saved, so everything always starts off.

-- The whole thing runs inside its own function: a function has its own
-- local-variable budget (200), and the main chunk is already close to it.
do
    -- Use a temporary field on the already-existing Config table instead of
    -- allocating another main-chunk local. This avoids the register overflow
    -- reported while declaring the configuration initializer.
    Config.initializeConfig = function()
        local HttpService = game:GetService("HttpService")
        local FOLDER, FILE = "toshi.cc", "toshi.cc/config.json"
        local lastSaved

        Config.available = typeof(writefile) == "function"
            and typeof(readfile) == "function"
            and typeof(isfile) == "function"

        local function setStatus(text)
            if hud.configStatus then
                hud.configStatus.Text = text
            end
        end

        local function rgb(color)
            return {
                math.floor(color.R * 255 + 0.5),
                math.floor(color.G * 255 + 0.5),
                math.floor(color.B * 255 + 0.5),
            }
        end

        local function toColor(value, fallback)
            if type(value) == "table"
                and type(value[1]) == "number"
                and type(value[2]) == "number"
                and type(value[3]) == "number" then
                return Color3.fromRGB(
                    math.clamp(value[1], 0, 255),
                    math.clamp(value[2], 0, 255),
                    math.clamp(value[3], 0, 255)
                )
            end

            return fallback
        end

        local function keyName(code)
            return code and code.Name or false
        end

        local function collect()
            return {
                version = 5,
                esp = {
                    showTeam = esp.showTeam,
                    skeleton = esp.skeleton,
                    boxes = esp.boxes,
                    boxStyle = esp.boxStyle,
                    boxFill = esp.boxFill,
                    healthBar = esp.healthBar,
                    names = esp.names,
                    distance = esp.distance,
                    health = esp.health,
                    tracers = esp.tracers,
                    colorMode = esp.colorMode,
                    rainbow = esp.rainbow,
                    colorName = esp.colorName,
                    color = rgb(esp.color),
                    maxDist = esp.maxDist,
                },
                aim = {
                    mode = aim.mode,
                    part = aim.part,
                    origin = aim.origin,
                    bindKind = aim.bind.kind,
                    bindName = aim.bind.value.Name,
                    teamCheck = aim.teamCheck,
                    players = aim.players,
                    npcs = aim.npcs,
                    wallCheck = aim.wallCheck,
                    sticky = aim.sticky,
                    skipInvisible = aim.skipInvisible,
                    showFov = aim.showFov,
                    fov = aim.fov,
                    smooth = aim.smooth,
                    maxDist = aim.maxDist,
                },
                self = {walk = selfWalk, jump = selfJump},
                camera = {fov = cameraFov, preset = cameraPreset},
                move = {flySpeed = flySpeed},
                keys = {
                    fly = keyName(flyKey),
                    noclip = keyName(noClipKey),
                    menu = keyName(menuKey),
                },
                ui = {
                    menuScale = menuScale,
                    statsBar = hud.telemetryVisible,
                    notifications = notificationsEnabled,
                    potatoMode = false, -- always start OFF; session state is not persisted
                },
            }
        end

        -- Every value is checked before it is used, so a hand-edited or old
        -- file can never put the script into a broken state.
        local function pickBool(tbl, key, current)
            local v = tbl[key]
            if type(v) == "boolean" then return v end
            return current
        end

        local function pickNum(tbl, key, current, lo, hi)
            local v = tbl[key]
            if type(v) == "number" then return math.clamp(v, lo, hi) end
            return current
        end

        local function pickOption(tbl, key, current, options)
            local v = tbl[key]

            for _, option in ipairs(options) do
                if v == option then return v end
            end

            return current
        end

        local function pickKey(tbl, key, current)
            local v = tbl[key]

            if v == false then return nil end

            if type(v) == "string" then
                local ok, code = pcall(function()
                    return Enum.KeyCode[v]
                end)

                if ok and code then return code end
            end

            return current
        end

        local function apply(cfg)
            if type(cfg) ~= "table" then return false end

            local e = cfg.esp

            if type(e) == "table" then
                esp.showTeam = pickBool(e, "showTeam", esp.showTeam)
                esp.skeleton = pickBool(e, "skeleton", pickBool(e, "highlight", esp.skeleton))
                esp.boxes = pickBool(e, "boxes", esp.boxes)
                esp.boxStyle = pickOption(e, "boxStyle", esp.boxStyle, {"Box", "Corner"})
                esp.boxFill = pickBool(e, "boxFill", esp.boxFill)
                esp.healthBar = pickBool(e, "healthBar", esp.healthBar)
                esp.names = pickBool(e, "names", esp.names)
                esp.distance = pickBool(e, "distance", esp.distance)
                esp.health = pickBool(e, "health", esp.health)
                esp.tracers = pickBool(e, "tracers", esp.tracers)
                esp.colorMode = pickOption(
                    e, "colorMode", esp.colorMode, {"Single", "Team", "Friend/foe"}
                )
                esp.rainbow = pickBool(e, "rainbow", esp.rainbow)
                esp.color = toColor(e.color, esp.color)
                esp.maxDist = pickNum(e, "maxDist", esp.maxDist, 100, 5000)

                if type(e.colorName) == "string" then
                    esp.colorName = e.colorName
                end
            end

            local a = cfg.aim

            if type(a) == "table" then
                aim.mode = pickOption(a, "mode", aim.mode, {"Hold", "Toggle", "Always"})
                aim.part = pickOption(a, "part", aim.part, {"Head", "Chest", "Root"})
                aim.origin = pickOption(a, "origin", aim.origin, {"Auto", "Cursor", "Center"})
                aim.teamCheck = pickBool(a, "teamCheck", aim.teamCheck)
                aim.players = pickBool(a, "players", aim.players)
                -- Files from before version 2 had NPC targeting on by default.
                if (cfg.version or 1) >= 2 then
                    aim.npcs = pickBool(a, "npcs", aim.npcs)
                end

                aim.wallCheck = pickBool(a, "wallCheck", aim.wallCheck)
                aim.sticky = pickBool(a, "sticky", aim.sticky)
                aim.skipInvisible = pickBool(a, "skipInvisible", aim.skipInvisible)
                aim.showFov = pickBool(a, "showFov", aim.showFov)
                aim.fov = pickNum(a, "fov", aim.fov, 50, 600)
                aim.smooth = pickNum(a, "smooth", aim.smooth, 1, 100)
                -- Files from before version 3 saved the old, shorter default.
                if (cfg.version or 1) >= 3 then
                    aim.maxDist = pickNum(a, "maxDist", aim.maxDist, 50, 5000)
                end

                if type(a.bindName) == "string" then
                    if a.bindKind == "mouse" then
                        local ok, kind = pcall(function()
                            return Enum.UserInputType[a.bindName]
                        end)

                        if ok and (kind == Enum.UserInputType.MouseButton1
                            or kind == Enum.UserInputType.MouseButton2
                            or kind == Enum.UserInputType.MouseButton3) then
                            aim.bind = {kind = "mouse", value = kind}
                        end
                    elseif a.bindKind == "key" then
                        local ok, code = pcall(function()
                            return Enum.KeyCode[a.bindName]
                        end)

                        if ok and code then
                            aim.bind = {kind = "key", value = code}
                        end
                    end
                end

                aim.holding = false
                aim.toggled = false
            end

            local s = cfg.self

            if type(s) == "table" then
                selfWalk = pickNum(s, "walk", selfWalk, MIN_WALK, MAX_WALK)
                selfJump = pickNum(s, "jump", selfJump, MIN_JUMP, MAX_JUMP)
            end

            local c = cfg.camera
            if type(c) == "table" then
                cameraFov = pickNum(c, "fov", cameraFov, 70, 120)
                cameraPreset = pickOption(c, "preset", cameraPreset, {"70 (Default)", "90", "120", "Custom"})
                -- Load the saved value into the controls only; do not apply it
                -- automatically when the script starts.
            end

            local m = cfg.move

            if type(m) == "table" then
                flySpeed = pickNum(m, "flySpeed", flySpeed, MIN_SPEED, MAX_SPEED)
            end

            local k = cfg.keys

            if type(k) == "table" then
                flyKey = pickKey(k, "fly", flyKey)
                noClipKey = pickKey(k, "noclip", noClipKey)
                menuKey = pickKey(k, "menu", menuKey)
            end

            local u = cfg.ui

            if type(u) == "table" then
                menuScale = pickNum(u, "menuScale", menuScale, 50, 130)
                hud.telemetryVisible = pickBool(u, "statsBar", hud.telemetryVisible)
                notificationsEnabled = pickBool(u, "notifications", notificationsEnabled)

                -- Potato Mode is deliberately session-only. Ignore saved/legacy
                -- performance flags so old configs cannot enable it at startup.
            end

            refreshAll()
            return true
        end

        local function save(announce)
            if not Config.available then
                if announce then
                    notify("File saving is not available here", false)
                end

                return false
            end

            local ok, encoded = pcall(function()
                return HttpService:JSONEncode(collect())
            end)

            if not ok then return false end

            local written = pcall(function()
                if typeof(isfolder) == "function" and typeof(makefolder) == "function"
                    and not isfolder(FOLDER) then
                    makefolder(FOLDER)
                end

                writefile(FILE, encoded)
            end)

            if not written then
                if announce then notify("Could not write the config file", false) end
                return false
            end

            lastSaved = encoded
            setStatus("Saved " .. os.date("%H:%M:%S"))

            if announce then notify("Config saved", true) end
            return true
        end

        local function load(announce)
            if not Config.available then
                if announce then
                    notify("File saving is not available here", false)
                end

                return false
            end

            local okRead, raw = pcall(function()
                if isfile(FILE) then
                    return readfile(FILE)
                end

                return nil
            end)

            if not okRead or type(raw) ~= "string" then
                setStatus("Nothing saved yet")
                if announce then notify("No saved config found", false) end
                return false
            end

            local okDecode, cfg = pcall(function()
                return HttpService:JSONDecode(raw)
            end)

            if not okDecode or not apply(cfg) then
                setStatus("Saved file is unreadable")
                if announce then notify("The saved config could not be read", false) end
                return false
            end

            local okEncode, encoded = pcall(function()
                return HttpService:JSONEncode(collect())
            end)

            if okEncode then lastSaved = encoded end

            setStatus("Loaded " .. os.date("%H:%M:%S"))
            if announce then notify("Config loaded", true) end
            return true
        end

        Config.save = save
        Config.load = load

        if Config.available then
            setStatus("Nothing saved yet")

            if load(false) then
                notify("Config loaded", true)
            end

            -- Autosave: a few seconds after something changed, write it.
            task.spawn(function()
                while not destroyed do
                    task.wait(3)
                    if destroyed then break end

                    if Config.auto then
                        local ok, encoded = pcall(function()
                            return HttpService:JSONEncode(collect())
                        end)

                        if ok and encoded ~= lastSaved then
                            save(false)
                        end
                    end
                end
            end)
        else
            setStatus("Not available here")
        end
    end

    Config.initializeConfig()
    Config.initializeConfig = nil
end

