        -- Draw the preview skeleton over the local-character model. This is
        -- separate from the game overlay and updates while the preview is open.
        connect(RunService.RenderStepped, function()
            if esp.rainbow then
                esp.rainbowColor = Color3.fromHSV((os.clock() * 0.15) % 1, 1, 1)
                if preview.pv and preview.pv.active then
                    esp.refreshPreview()
                end
            end

            local pv = preview.pv
            local model = pv and pv.model
            local camera = pv and pv.camera
            local shouldDraw = pv ~= nil and pv.active and esp.skeleton
                and model ~= nil and camera ~= nil

            for i, edge in ipairs(SKELETON_EDGES) do
                local segment = preview.skeletonLines and preview.skeletonLines[i]

                if segment and shouldDraw then
                    local a = model:FindFirstChild(edge[1], true)
                    local b = model:FindFirstChild(edge[2], true)

                    if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
                        local localA = camera.CFrame:PointToObjectSpace(a.Position)
                        local localB = camera.CFrame:PointToObjectSpace(b.Position)
                        local inFront = localA.Z < -NEAR and localB.Z < -NEAR

                        positionSkeletonLine(
                            segment, pv.project(a.Position), pv.project(b.Position),
