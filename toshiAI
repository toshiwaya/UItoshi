-- ------------------------------------------------------------------
-- HELPERS
-- ------------------------------------------------------------------

local function new(className, properties)
    local instance = Instance.new(className)
    local parent = properties and properties.Parent

    if properties then
        for key, value in pairs(properties) do
            if key ~= "Parent" then
                instance[key] = value
            end
        end
    end

    instance.Parent = parent
    return instance
end

local function corner(instance, radius)
    return new("UICorner", {
        Parent = instance,
        CornerRadius = UDim.new(0, radius or 8),
    })
end

local function stroke(instance, color, thickness, transparency)
    return new("UIStroke", {
        Parent = instance,
        Color = color or Theme.line,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function tween(instance, properties, duration, style, direction)
    duration = duration or 0.15

    if duration <= 0 then
        for property, value in pairs(properties) do
            instance[property] = value
        end
        return nil
    end

    local animation = TweenService:Create(
        instance,
        TweenInfo.new(duration, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out),
        properties
    )
    animation:Play()
    return animation
end

local function runCallback(callback, ...)
    if type(callback) ~= "function" then return end

    local args = table.pack(...)

    task.spawn(function()
        local ok, err = pcall(callback, table.unpack(args, 1, args.n))
        if not ok then
            warn("[SimpleMenu] callback error: " .. tostring(err))
        end
    end)
end

local function keyText(key)
    if key == nil or key == false then return "None" end
    if typeof(key) == "EnumItem" then return key.Name end
    return tostring(key)
end

local function footerKeyText(key)
    if key == nil or key == false then return "NONE" end
    if typeof(key) == "EnumItem" then return string.upper(key.Name) end
    return string.upper(tostring(key))
end

local function getGuiParent()
    local ok, hidden = pcall(function()
        if type(gethui) == "function" then
            return gethui()
        end
    end)

    if ok and hidden then
        return hidden
    end

    local okCore, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)

    if not okCore or not coreGui then
        return PlayerGui
    end

    local probe = Instance.new("ScreenGui")
    probe.Name = "SimpleMenuProbe"

    local parented = pcall(function()
        probe.Parent = coreGui
    end)

    if parented and probe.Parent == coreGui then
        probe:Destroy()
        return coreGui
    end

    probe:Destroy()
    return PlayerGui
end

local function purgeOldGuis()
    local parents = {PlayerGui}
    local seen = {}

    pcall(function()
        parents[#parents + 1] = game:GetService("CoreGui")
    end)

    local ok, hidden = pcall(function()
        if type(gethui) == "function" then
            return gethui()
        end
    end)

    if ok and hidden then
        parents[#parents + 1] = hidden
    end

    for _, parent in ipairs(parents) do
        if parent and not seen[parent] then
            seen[parent] = true

            local okChildren, children = pcall(function()
                return parent:GetChildren()
            end)

            if okChildren then
                for _, child in ipairs(children) do
                    if child.Name == "SimpleMenu_Library" then
                        pcall(function()
                            child:Destroy()
                        end)
                    end
                end
            end
        end
    end
end

local function decimalsOf(step)
    local text = tostring(step)
    local dot = string.find(text, ".", 1, true)

    if dot then
        return math.min(4, #text - dot)
    end

    return 0
end

local function roundToStep(value, minimum, maximum, step)
    step = step or 1
    if step <= 0 then step = 1 end

    local steps = math.floor(((value - minimum) / step) + 0.5)
    local result = minimum + (steps * step)
    result = tonumber(string.format("%." .. decimalsOf(step) .. "f", result)) or result

    return math.clamp(result, minimum, maximum)
end

