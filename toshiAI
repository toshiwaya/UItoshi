--[[
    SimpleMenu // small Roblox executor UI library
    ------------------------------------------------------------------
    Single file, no external assets, no HTTP requests, no remotes.
    Works in executors (CoreGui / gethui) and in Studio (PlayerGui).

    QUICK START
        local SimpleMenu = loadstring(game:HttpGet("YOUR_RAW_URL"))()

        local Window = SimpleMenu:CreateWindow({
            Title = "Simple Menu",
            Subtitle = "my executor hub",
            Accent = Color3.fromRGB(112, 169, 255),
            ToggleKey = Enum.KeyCode.RightShift,
        })

        local Main = Window:CreateTab("Main")
        local Section = Main:CreateSection("Movement")

        Section:CreateToggle({
            Name = "Example toggle",
            Default = false,
            Callback = function(state)
                print("toggle:", state)
            end,
        })

    See example.lua for a full demo and README.md for the API.
--]]

