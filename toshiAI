local SimpleMenu = {
    Version = "1.0.0",
    _window = nil,
}

function SimpleMenu:CreateWindow(options)
    options = options or {}

    if self._window and not self._window._destroyed then
        pcall(function()
            self._window:Destroy()
        end)
    end

    purgeOldGuis()

    local gui = new("ScreenGui", {
        Name = "SimpleMenu_Library",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 999999,
        Parent = getGuiParent(),
    })

    pcall(function()
        if syn and syn.protect_gui then
            syn.protect_gui(gui)
        end
    end)

    pcall(function()
        if type(protect_gui) == "function" then
            protect_gui(gui)
        end
    end)

    local window = setmetatable({
        Gui = gui,
        Flags = {},
        _options = options,
        _accent = options.Accent or Theme.accent,
        _tabs = {},
        _activeTab = nil,
        _accentPainters = {},
        _connections = {},
        _cleanups = {},
        _notifications = {},
        _notificationSeq = 0,
        _dropdownClose = nil,
        _capturing = false,
        _open = false,
        _destroyed = false,
        _closeToken = 0,
        _savedMouse = nil,
        _blur = nil,
        _toggleKey = (options.ToggleKey == nil) and Enum.KeyCode.RightShift or options.ToggleKey,
    }, Window)

    self._window = window
    window:_Build()

    return window
end

function SimpleMenu:GetWindow()
    return self._window
end

-- ------------------------------------------------------------------
-- WINDOW
-- ------------------------------------------------------------------

Window = {}
Window.__index = Window

function Window:_Connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(self._connections, connection)
    return connection
end

function Window:_OnDestroy(callback)
    table.insert(self._cleanups, callback)
end

function Window:_AddAccentPainter(painter)
    table.insert(self._accentPainters, painter)
    pcall(painter, self._accent)
end

function Window:SetAccent(color)
    if typeof(color) ~= "Color3" then
        color = Theme.accent
    end

    self._accent = color

    for _, painter in ipairs(self._accentPainters) do
        local ok, err = pcall(painter, color)
        if not ok then
            warn("[SimpleMenu] accent painter error: " .. tostring(err))
        end
    end
end

function Window:_Build()
    local gui = self.Gui
    local options = self._options

    local root = new("CanvasGroup", {
        Name = "Main",
        Parent = gui,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = options.Size or UDim2.fromOffset(600, 440),
        BackgroundColor3 = Theme.window,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        GroupTransparency = 1,
        Visible = false,
    })

    corner(root, 12)
    stroke(root, Theme.line, 1)
    self._root = root

    -- Drag area excludes the close button so clicking it never starts a drag.
    local dragArea = new("Frame", {
        Name = "DragArea",
        Parent = root,
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, -56, 0, 48),
        BackgroundTransparency = 1,
    })

    local logo = new("Frame", {
        Parent = dragArea,
        Position = UDim2.fromOffset(14, 12),
        Size = UDim2.fromOffset(24, 24),
        BackgroundColor3 = self._accent,
        BorderSizePixel = 0,
    })
    corner(logo, 7)

    new("TextLabel", {
        Parent = logo,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "S",
        Font = Theme.fontBold,
        TextSize = 12,
        TextColor3 = Theme.accentInk,
    })

    new("TextLabel", {
        Parent = dragArea,
        Position = UDim2.fromOffset(48, 9),
        Size = UDim2.new(1, -58, 0, 16),
        BackgroundTransparency = 1,
        Text = options.Title or "Simple Menu",
        Font = Theme.fontBold,
        TextSize = 13,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })

    new("TextLabel", {
        Parent = dragArea,
        Position = UDim2.fromOffset(48, 24),
        Size = UDim2.new(1, -58, 0, 13),
        BackgroundTransparency = 1,
        Text = options.Subtitle or ("v" .. SimpleMenu.Version),
        Font = Theme.font,
        TextSize = 10,
        TextColor3 = Theme.muted,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })

    local close = new("TextButton", {
        Name = "Close",
        Parent = root,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 12),
        Size = UDim2.fromOffset(28, 28),
        BackgroundColor3 = Theme.surface,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "×",
        Font = Theme.fontBold,
        TextSize = 17,
        TextColor3 = Theme.muted,
        AutoButtonColor = false,
    })
    corner(close, 7)

    close.MouseEnter:Connect(function()
        tween(close, { BackgroundTransparency = 0, TextColor3 = Theme.text }, 0.12)
    end)
    close.MouseLeave:Connect(function()
        tween(close, { BackgroundTransparency = 1, TextColor3 = Theme.muted }, 0.12)
    end)
    close.MouseButton1Click:Connect(function()
        self:Close()
    end)

    new("Frame", {
        Parent = root,
        Position = UDim2.fromOffset(0, 48),
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = Theme.line,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
    })

    local rail = new("Frame", {
        Name = "Rail",
        Parent = root,
        Position = UDim2.fromOffset(0, 49),
        Size = UDim2.new(0, 156, 1, -49),
        BackgroundColor3 = Theme.rail,
        BorderSizePixel = 0,
    })

    local content = new("Frame", {
        Name = "Content",
        Parent = root,
        Position = UDim2.fromOffset(156, 49),
        Size = UDim2.new(1, -156, 1, -49),
        BackgroundColor3 = Theme.window,
        BorderSizePixel = 0,
    })

    new("Frame", {
        Parent = root,
        Position = UDim2.fromOffset(156, 49),
        Size = UDim2.new(0, 1, 1, -49),
        BackgroundColor3 = Theme.line,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
    })

    local tabHolder = new("Frame", {
        Name = "Tabs",
        Parent = rail,
        Position = UDim2.fromOffset(12, 12),
        Size = UDim2.new(1, -24, 1, -78),
        BackgroundTransparency = 1,
    })
    new("UIListLayout", {
        Parent = tabHolder,
        Padding = UDim2.fromOffset(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    local footer = new("Frame", {
        Parent = rail,
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -14),
        Size = UDim2.new(1, -24, 0, 42),
        BackgroundTransparency = 1,
    })

    new("TextLabel", {
        Parent = footer,
        Size = UDim2.new(1, 0, 0, 12),
        BackgroundTransparency = 1,
        Text = "TOGGLE KEY",
        Font = Theme.fontBold,
        TextSize = 9,
        TextColor3 = Theme.muted2,
        TextXAlignment = Enum.TextXAlignment.Center,
    })

    local keyBadge = new("Frame", {
        Parent = footer,
        Position = UDim2.fromOffset(0, 18),
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundColor3 = Theme.surface,
        BorderSizePixel = 0,
    })
    corner(keyBadge, 6)
    stroke(keyBadge, Theme.line, 1)

    self._toggleLabel = new("TextLabel", {
        Parent = keyBadge,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = footerKeyText(self._toggleKey),
        Font = Theme.mono,
        TextSize = 10,
        TextColor3 = Theme.textDim,
        TextXAlignment = Enum.TextXAlignment.Center,
    })

    self._rail = rail
    self._content = content
    self._tabHolder = tabHolder
    self._logo = logo

    self:_AddAccentPainter(function(color)
        logo.BackgroundColor3 = color
    end)

    -- Dragging ------------------------------------------------------
    local dragging = false
    local dragStart, windowStart

    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = (input.UserInputType == Enum.UserInputType.Touch)
                and input.Position
                or UserInputService:GetMouseLocation()
            windowStart = root.AbsolutePosition
        end
    end)

    self:_Connect(UserInputService.InputChanged, function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local now = (input.UserInputType == Enum.UserInputType.Touch)
            and input.Position
            or UserInputService:GetMouseLocation()

        local delta = now - dragStart
        local viewport = workspace.CurrentCamera
            and workspace.CurrentCamera.ViewportSize
            or Vector2.new(1280, 720)
        local size = root.AbsoluteSize

        local x = math.clamp(windowStart.X + delta.X, 120 - size.X, viewport.X - 120)
        local y = math.clamp(windowStart.Y + delta.Y, 0, math.max(0, viewport.Y - 48))

        root.Position = UDim2.fromOffset(x + (size.X * 0.5), y + (size.Y * 0.5))
    end)

    self:_Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Hotkey --------------------------------------------------------
    self:_Connect(UserInputService.InputBegan, function(input)
        if self._capturing then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if not self._toggleKey or input.KeyCode ~= self._toggleKey then return end
        if UserInputService:GetFocusedTextBox() then return end
        self:Toggle()
    end)

    -- Cursor liberation while open ----------------------------------
    self:_Connect(RunService.RenderStepped, function()
        if self._open and self._options.UnlockMouse ~= false then
            pcall(function()
                if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                end
                if not UserInputService.MouseIconEnabled then
                    UserInputService.MouseIconEnabled = true
                end
            end)
        end
    end)

    -- Notifications -------------------------------------------------
    local notifHolder = new("Frame", {
        Name = "Notifications",
        Parent = gui,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -18, 0, 18),
        Size = UDim2.new(0, 292, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    })
    new("UIListLayout", {
        Parent = notifHolder,
        Padding = UDim2.fromOffset(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
    })
    self._notifHolder = notifHolder

    if options.StartOpen ~= false then
        self:Open()
    else
        root.Visible = false
    end
end

function Window:_UnlockMouse()
    if self._options.UnlockMouse == false then return end

    if not self._savedMouse then
        self._savedMouse = {
            Behavior = UserInputService.MouseBehavior,
            Icon = UserInputService.MouseIconEnabled,
        }
    end

    pcall(function()
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end)
end

function Window:_RestoreMouse()
    if not self._savedMouse then return end

    local saved = self._savedMouse
    self._savedMouse = nil

    pcall(function()
        UserInputService.MouseBehavior = saved.Behavior
        UserInputService.MouseIconEnabled = saved.Icon
    end)
end

function Window:Open()
    if self._destroyed or self._open then return end

    self._open = true
    self._root.Visible = true
    self._root.GroupTransparency = 1
    tween(self._root, { GroupTransparency = 0 }, 0.18)
    self:_UnlockMouse()

    if self._options.Blur then
        if not self._blur then
            self._blur = new("BlurEffect", {
                Parent = Lighting,
                Name = "SimpleMenuBlur",
                Size = 0,
            })
        end
        tween(self._blur, { Size = 12 }, 0.2)
    end
end

function Window:Close()
    if self._destroyed or not self._open then return end

    self._open = false
    self._closeToken = self._closeToken + 1
    local token = self._closeToken

    if self._dropdownClose then
        local closeDropdown = self._dropdownClose
        self._dropdownClose = nil
        pcall(closeDropdown)
    end

    if self._cancelCapture then
        local cancelCapture = self._cancelCapture
        self._cancelCapture = nil
        pcall(cancelCapture)
    end

    tween(self._root, { GroupTransparency = 1 }, 0.13)

    task.delay(0.15, function()
        if not self._destroyed and not self._open and self._closeToken == token then
            self._root.Visible = false
        end
    end)

    self:_RestoreMouse()

    if self._blur then
        tween(self._blur, { Size = 0 }, 0.18)
    end
end

function Window:Toggle()
    if self._open then
        self:Close()
    else
        self:Open()
    end
end

function Window:IsOpen()
    return self._open
end

function Window:SetToggleKey(key)
    self._toggleKey = key
    if self._toggleLabel then
        self._toggleLabel.Text = footerKeyText(key)
    end
end

function Window:GetFlag(name)
    return self.Flags[name]
end

function Window:SelectTab(target)
    local tab = target

    if type(target) == "string" then
        for _, candidate in ipairs(self._tabs) do
            if candidate.Name == target then
                tab = candidate
                break
            end
        end
    end

    if not tab or not tab._frame then return end

    for _, candidate in ipairs(self._tabs) do
        local active = candidate == tab
        candidate._frame.Visible = active
        if candidate._ApplySelection then
            candidate:_ApplySelection(active)
        end
    end

    self._activeTab = tab
end

function Window:CreateTab(name)
    local tab = setmetatable({
        Name = name or "Tab",
        _window = self,
        _order = 0,
        _sections = {},
    }, Tab)

    tab:_Build()
    table.insert(self._tabs, tab)

    if not self._activeTab then
        self:SelectTab(tab)
    end

    return tab
end

function Window:Notify(options)
    if self._destroyed then return end
    if type(options) == "string" then
        options = { Text = options }
    end
    options = options or {}

    self._notificationSeq = self._notificationSeq + 1

    local note = new("CanvasGroup", {
        Parent = self._notifHolder,
        Size = UDim2.new(0, 292, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.panel,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        LayoutOrder = self._notificationSeq,
    })
    corner(note, 8)
    stroke(note, Theme.line, 1)

    new("UIPadding", {
        Parent = note,
        PaddingLeft = UDim2.fromOffset(12, 0),
        PaddingRight = UDim2.fromOffset(12, 0),
        PaddingTop = UDim2.fromOffset(10, 0),
        PaddingBottom = UDim2.fromOffset(10, 0),
    })
    new("UIListLayout", {
        Parent = note,
        Padding = UDim2.fromOffset(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    if options.Title and options.Title ~= "" then
        local titleRow = new("Frame", {
            Parent = note,
            Size = UDim2.new(1, 0, 0, 16),
            BackgroundTransparency = 1,
            LayoutOrder = 1,
        })

        local dot = new("Frame", {
            Parent = titleRow,
            Position = UDim2.fromOffset(0, 5),
            Size = UDim2.fromOffset(6, 6),
            BackgroundColor3 = self._accent,
            BorderSizePixel = 0,
        })
        corner(dot, 100)

        new("TextLabel", {
            Parent = titleRow,
            Position = UDim2.fromOffset(12, 0),
            Size = UDim2.new(1, -12, 0, 16),
            BackgroundTransparency = 1,
            Text = options.Title,
            Font = Theme.fontBold,
            TextSize = 12,
            TextColor3 = Theme.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
    end

    new("TextLabel", {
        Parent = note,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Font = Theme.font,
        TextSize = 11,
        TextColor3 = Theme.textDim,
        Text = options.Text or "",
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        LayoutOrder = 2,
    })

    tween(note, { GroupTransparency = 0 }, 0.18)

    table.insert(self._notifications, note)
    while #self._notifications > 4 do
        local oldest = table.remove(self._notifications, 1)
        if oldest and oldest.Parent then
            oldest:Destroy()
        end
    end

    local dismissed = false
    local function dismiss()
        if dismissed or not note.Parent then return end
        dismissed = true

        for index, item in ipairs(self._notifications) do
            if item == note then
                table.remove(self._notifications, index)
                break
            end
        end

        tween(note, { GroupTransparency = 1 }, 0.15)
        task.delay(0.16, function()
            if note and note.Parent then
                note:Destroy()
            end
        end)
    end

    note.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dismiss()
        end
    end)

    local duration = options.Duration or 4.5
    if duration > 0 then
        task.delay(duration, dismiss)
    end

    return note
end

function Window:Destroy()
    if self._destroyed then return end

    self._destroyed = true
    self._open = false

    for _, connection in ipairs(self._connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(self._connections)

    for _, cleanup in ipairs(self._cleanups) do
        pcall(cleanup)
    end
    table.clear(self._cleanups)

    self:_RestoreMouse()

    if self._blur then
        pcall(function()
            self._blur:Destroy()
        end)
        self._blur = nil
    end

    if self.Gui then
        pcall(function()
            self.Gui:Destroy()
        end)
    end

    if SimpleMenu._window == self then
        SimpleMenu._window = nil
    end
end

