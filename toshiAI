function SimpleMenu:Notify(options)
    local window = self._window
    if window and not window._destroyed then
        return window:Notify(options)
    end
end

function SimpleMenu:Destroy()
    local window = self._window
    if window and not window._destroyed then
        window:Destroy()
    end
end

-- Executor re-execution safety: keep the current library instance in the
-- executor environment so loading the script again tears down the old one
-- (including its input connections) before the new instance is returned.
do
    local ok, environment = pcall(function()
        if type(getgenv) == "function" then
            return getgenv()
        end
        return nil
    end)

    if ok and type(environment) == "table" then
        local previous = environment.__SimpleMenuInstance

        if previous and previous ~= SimpleMenu
            and type(previous.Destroy) == "function" then
            pcall(function()
                previous:Destroy()
            end)
        end

        environment.__SimpleMenuInstance = SimpleMenu
    end
end

return SimpleMenu

