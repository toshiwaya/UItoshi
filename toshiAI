        BackgroundColor3 = Theme.text,
        BorderSizePixel = 0,
        ZIndex = 2,
    })
    corner(knob, 100)

    local value = options.Default == true

    local function paint(animate)
        tween(pill, {
            BackgroundColor3 = value and window._accent or Theme.track,
        }, animate and 0.16 or 0)

        tween(knob, {
            Position = UDim2.fromOffset(value and 23 or 3, 0),
