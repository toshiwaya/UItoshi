    end)
    hookHover(hit, row)

    window:_AddAccentPainter(function(color)
        if value then
            pill.BackgroundColor3 = color
        end
    end)

    local api = { Instance = row }

    function api:Set(newValue)
        set(newValue)
    end

    function api:Get()
        return value
    end

    return api
end

function Section:CreateSlider(options)
    options = options or {}

    local window = self._window
    local minimum = tonumber(options.Min) or 0
    local maximum = tonumber(options.Max) or 100
    local step = tonumber(options.Step) or 1
    local suffix = options.Suffix or ""

    if maximum < minimum then
        minimum, maximum = maximum, minimum
    end

    local row = self:_MakeRow(58)

    new("TextLabel", {
        Parent = row,
        Position = UDim2.fromOffset(12, 9),
        Size = UDim2.new(1, -130, 0, 16),
        BackgroundTransparency = 1,
        Text = options.Name or "Slider",
        Font = Theme.font,
        TextSize = 13,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })

    local valueLabel = new("TextLabel", {
        Parent = row,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 9),
        Size = UDim2.fromOffset(100, 16),
        BackgroundTransparency = 1,
        Text = "",
        Font = Theme.mono,
        TextSize = 11,
        TextColor3 = window._accent,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local track = new("Frame", {
        Parent = row,
        Position = UDim2.fromOffset(12, 40),
        Size = UDim2.new(1, -24, 0, 4),
        BackgroundColor3 = Theme.track,
        BorderSizePixel = 0,
    })
    corner(track, 100)

    local fill = new("Frame", {
        Parent = track,
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = window._accent,
        BorderSizePixel = 0,
    })
    corner(fill, 100)

    local knob = new("Frame", {
        Parent = track,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Theme.text,
        BorderSizePixel = 0,
        ZIndex = 2,
    })
    corner(knob, 100)

    local hit = new("TextButton", {
        Parent = row,
        Position = UDim2.fromOffset(6, 26),
        Size = UDim2.new(1, -12, 0, 24),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    })

    local value = roundToStep(
        tonumber(options.Default) or minimum,
        minimum,
        maximum,
        step
    )

    local function display(number)
        if type(options.Format) == "function" then
            local ok, formatted = pcall(options.Format, number)
            if ok and formatted ~= nil then
                return tostring(formatted)
            end
        end

        return string.format(
            "%." .. decimalsOf(step) .. "f",
            number
        ) .. suffix
    end

    local function paint()
        local fraction = 0
        if maximum > minimum then
            fraction = (value - minimum) / (maximum - minimum)
        end
        fraction = math.clamp(fraction, 0, 1)

        fill.Size = UDim2.fromScale(fraction, 1)
        knob.Position = UDim2.new(fraction, 0, 0.5, 0)
        valueLabel.Text = display(value)
    end

    local function set(newValue, silent)
        local nextValue = roundToStep(
            tonumber(newValue) or minimum,
            minimum,
            maximum,
            step
        )

        if nextValue == value then
            paint()
            return
        end

        value = nextValue
        paint()

        if options.Flag then
            window.Flags[options.Flag] = value
        end

        if not silent then
            runCallback(options.Callback, value)
        end
    end

    paint()

    if options.Flag then
        window.Flags[options.Flag] = value
    end

    local dragging = false

    local function applyX(x)
        local left = track.AbsolutePosition.X
        local width = track.AbsoluteSize.X
        if width <= 0 then return end

        local alpha = math.clamp((x - left) / width, 0, 1)
        set(minimum + ((maximum - minimum) * alpha))
    end

    hit.MouseButton1Down:Connect(function()
        dragging = true
        applyX(UserInputService:GetMouseLocation().X)
    end)

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            applyX(input.Position.X)
        end
    end)

    window:_Connect(UserInputService.InputChanged, function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            applyX(UserInputService:GetMouseLocation().X)
        elseif input.UserInputType == Enum.UserInputType.Touch then
            applyX(input.Position.X)
        end
    end)

    window:_Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    window:_AddAccentPainter(function(color)
        fill.BackgroundColor3 = color
        valueLabel.TextColor3 = color
    end)

    local api = { Instance = row }

    function api:Set(newValue)
        set(newValue)
    end

    function api:Get()
        return value
    end

    return api
end

function Section:CreateDropdown(options)
    options = options or {}

    local window = self._window
    local items = {}

    for _, item in ipairs(options.Options or {}) do
        items[#items + 1] = tostring(item)
    end

    local headerHeight = options.Description and 46 or 42
    local optionHeight = 28
    local gap = 1
    local panelHeight = (#items * optionHeight) + (math.max(0, #items - 1) * gap) + 8

    local container = new("Frame", {
        Parent = self._container,
        Size = UDim2.new(1, 0, 0, headerHeight),
        BackgroundTransparency = 1,
        LayoutOrder = self:_NextOrder(),
    })

    local header = self:_MakeRow(headerHeight, container)
    self:_AddRowText(header, options.Name or "Dropdown", options.Description, 174)

    local selection = new("TextButton", {
        Parent = header,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(156, 28),
        BackgroundColor3 = Theme.surface2,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    })
    corner(selection, 6)
    stroke(selection, Theme.line, 1)

    local selectedLabel = new("TextLabel", {
        Parent = selection,
        Position = UDim2.fromOffset(9, 0),
        Size = UDim2.new(1, -30, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Font = Theme.font,
        TextSize = 11,
        TextColor3 = Theme.textDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })

    local chevron = new("TextLabel", {
        Parent = selection,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundTransparency = 1,
        Text = "▾",
        Font = Theme.font,
        TextSize = 12,
        TextColor3 = Theme.muted,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Center,
    })

    local panel = new("Frame", {
        Parent = container,
        Position = UDim2.fromOffset(0, headerHeight + 6),
        Size = UDim2.new(1, 0, 0, panelHeight),
        BackgroundColor3 = Theme.panel,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = false,
        ZIndex = 5,
    })
    corner(panel, 8)
    stroke(panel, Theme.line, 1)

    new("UIPadding", {
        Parent = panel,
        PaddingTop = UDim2.fromOffset(4, 0),
        PaddingBottom = UDim2.fromOffset(4, 0),
    })
    new("UIListLayout", {
        Parent = panel,
        Padding = UDim2.fromOffset(0, gap),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
    })

    local selected

    if options.Default ~= nil then
        local wanted = tostring(options.Default)
        for _, item in ipairs(items) do
            if item == wanted then
                selected = item
                break
            end
        end
    end

    if not selected then
        selected = items[1]
    end

    selectedLabel.Text = selected or "—"

    local entries = {}

    local function paintOptions()
        for _, entry in ipairs(entries) do
            if entry.value == selected then
                entry.button.BackgroundColor3 = Theme.surface2
                entry.button.BackgroundTransparency = 0.25
                entry.button.TextColor3 = window._accent
            else
                entry.button.BackgroundColor3 = Theme.surface2
                entry.button.BackgroundTransparency = 1
                entry.button.TextColor3 = Theme.muted
            end
        end
    end

    local isOpen = false

    local function closePanel()
        if not isOpen then return end

        isOpen = false
        panel.Visible = false
        container.Size = UDim2.new(1, 0, 0, headerHeight)
        chevron.Rotation = 0

        if window._dropdownClose == closePanel then
            window._dropdownClose = nil
        end
    end

    local function openPanel()
        if #items == 0 then return end

        if window._dropdownClose and window._dropdownClose ~= closePanel then
            window._dropdownClose()
        end

        isOpen = true
        window._dropdownClose = closePanel
        panel.Visible = true
        container.Size = UDim2.new(1, 0, 0, headerHeight + 6 + panelHeight)
        chevron.Rotation = 180
    end

    local function select(item, silent)
        if item == nil or item == "—" then return end

        local valid = false
        for _, candidate in ipairs(items) do
            if candidate == item then
                valid = true
                break
            end
        end

        if not valid then return end

        local changed = selected ~= item
        selected = item
        selectedLabel.Text = item
        paintOptions()

        if options.Flag then
            window.Flags[options.Flag] = item
        end

        if not silent and changed then
            runCallback(options.Callback, item)
        end
    end

    for index, item in ipairs(items) do
        local optionButton = new("TextButton", {
            Parent = panel,
            Size = UDim2.new(1, -8, 0, optionHeight),
            BackgroundColor3 = Theme.surface2,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = item,
            Font = Theme.font,
            TextSize = 11,
            TextColor3 = Theme.muted,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false,
            LayoutOrder = index,
        })
        corner(optionButton, 5)
        new("UIPadding", {
            Parent = optionButton,
            PaddingLeft = UDim2.fromOffset(10, 0),
            PaddingRight = UDim2.fromOffset(10, 0),
        })

        optionButton.MouseEnter:Connect(function()
            if item ~= selected then
                optionButton.BackgroundTransparency = 0.6
                optionButton.TextColor3 = Theme.textDim
            end
        end)

        optionButton.MouseLeave:Connect(function()
            if item ~= selected then
                optionButton.BackgroundTransparency = 1
                optionButton.TextColor3 = Theme.muted
            end
        end)

        optionButton.MouseButton1Click:Connect(function()
            select(item)
            closePanel()
        end)

        entries[#entries + 1] = {
            value = item,
            button = optionButton,
        }
    end

    paintOptions()

    if options.Flag and selected then
        window.Flags[options.Flag] = selected
    end

    selection.MouseEnter:Connect(function()
        tween(selection, { BackgroundColor3 = Theme.hover }, 0.12)
    end)

    selection.MouseLeave:Connect(function()
        tween(selection, { BackgroundColor3 = Theme.surface2 }, 0.12)
    end)

    selection.MouseButton1Click:Connect(function()
        if isOpen then
            closePanel()
        else
            openPanel()
        end
    end)

    window:_AddAccentPainter(function(color)
        for _, entry in ipairs(entries) do
            if entry.value == selected then
                entry.button.TextColor3 = color
            end
        end
    end)

    local api = { Instance = container }

    function api:Set(item)
        select(tostring(item))
    end

    function api:Get()
        return selected
    end

    return api
end

function Section:CreateInput(options)
    options = options or {}

    local window = self._window
    local row = self:_MakeRow(options.Description and 46 or 42)
    self:_AddRowText(row, options.Name or "Input", options.Description, 216)

    local box = new("TextBox", {
        Parent = row,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(200, 28),
        BackgroundColor3 = Theme.surface,
        BorderSizePixel = 0,
        Text = tostring(options.Default or ""),
        PlaceholderText = options.Placeholder or "Type here...",
        Font = Theme.mono,
        TextSize = 11,
        TextColor3 = Theme.text,
        PlaceholderColor3 = Theme.muted2,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
    })
    corner(box, 6)

    local boxStroke = stroke(box, Theme.line, 1)

    new("UIPadding", {
        Parent = box,
        PaddingLeft = UDim2.fromOffset(8, 0),
        PaddingRight = UDim2.fromOffset(8, 0),
    })

    local lastValue = box.Text

    box.Focused:Connect(function()
        boxStroke.Color = window._accent
    end)

    box.FocusLost:Connect(function(enterPressed)
        boxStroke.Color = Theme.line

        local text = box.Text
        if enterPressed or text ~= lastValue then
            lastValue = text

            if options.Flag then
                window.Flags[options.Flag] = text
            end

            runCallback(options.Callback, text)
        end
    end)

    window:_AddAccentPainter(function(color)
        if box:IsFocused() then
            boxStroke.Color = color
        end
    end)

    local api = { Instance = row }

    function api:Set(text)
        text = tostring(text or "")
        box.Text = text
        lastValue = text
    end

    function api:Get()
        return box.Text
    end

    return api
end

function Section:CreateKeybind(options)
    options = options or {}

    local window = self._window
    local row = self:_MakeRow(options.Description and 46 or 42)
    self:_AddRowText(row, options.Name or "Keybind", options.Description, 116)

    local button = new("TextButton", {
        Parent = row,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(100, 28),
        BackgroundColor3 = Theme.surface,
        BorderSizePixel = 0,
        Text = keyText(options.Default),
        Font = Theme.mono,
        TextSize = 10,
        TextColor3 = Theme.textDim,
        AutoButtonColor = false,
    })
    corner(button, 6)

    local buttonStroke = stroke(button, Theme.line, 1)

    local value = options.Default
    local capturing = false
    local captureConnection

    local function stopCapture()
        if captureConnection then
            pcall(function()
                captureConnection:Disconnect()
            end)
            captureConnection = nil
        end

        capturing = false
        window._capturing = false

        if window._cancelCapture == stopCapture then
            window._cancelCapture = nil
        end

        button.Text = keyText(value)
        button.TextColor3 = Theme.textDim
        buttonStroke.Color = Theme.line
    end

    local function setKey(key, silent)
        value = key
        button.Text = keyText(value)

        if options.Flag then
            window.Flags[options.Flag] = value
        end

        if not silent then
            runCallback(options.Callback, value)
        end
    end

    local function startCapture()
        if capturing then
            stopCapture()
            return
        end

        if window._cancelCapture and window._cancelCapture ~= stopCapture then
            window._cancelCapture()
        end

        capturing = true
        window._capturing = true
        window._cancelCapture = stopCapture

        button.Text = "Press a key"
        button.TextColor3 = window._accent
        buttonStroke.Color = window._accent

        captureConnection = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

            if input.KeyCode == Enum.KeyCode.Escape then
                stopCapture()
                return
            end

            if input.KeyCode == Enum.KeyCode.Backspace
                or input.KeyCode == Enum.KeyCode.Delete then
                setKey(nil)
                stopCapture()
                return
            end

            setKey(input.KeyCode)
            stopCapture()
        end)
    end

    button.MouseButton1Click:Connect(function()
        if capturing then
            stopCapture()
        else
            startCapture()
        end
    end)

    window:_OnDestroy(function()
        if captureConnection then
            pcall(function()
                captureConnection:Disconnect()
            end)
        end
    end)

    window:_AddAccentPainter(function(color)
        if capturing then
            button.TextColor3 = color
            buttonStroke.Color = color
        end
    end)

    if options.Flag then
        window.Flags[options.Flag] = value
    end

    local api = { Instance = row }

    function api:Set(key)
        setKey(key)
    end

    function api:Get()
        return value
    end

    return api
end

function Section:CreateLabel(text, options)
