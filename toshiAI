        if options.Flag then
            window.Flags[options.Flag] = value
        end

        if not silent then
            runCallback(options.Callback, value)
        end
    end

    paint(false)

    if options.Flag then
        window.Flags[options.Flag] = value
    end

    local hit = new("TextButton", {
        Parent = row,
        Size = UDim2.fromScale(1, 1),
